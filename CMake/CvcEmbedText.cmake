# Write a text file into a C++ source as a NUL-terminated byte array, so a library carries it
# without reading it at run time (the .ari schema: src/cvc/ariadne/schema/). A byte array rather
# than a raw string literal: MSVC caps a string literal at 16 KB.
#
#   cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DNAMESPACE=<a::b> -DSYMBOL=<name> -P CvcEmbedText.cmake
#
# defines `extern const unsigned char <SYMBOL>[]` (unsigned, so a UTF-8 byte is no narrowing) and
# `extern const std::size_t <SYMBOL>_size` (the length without the NUL) in NAMESPACE. The output
# is rewritten only when it changes.
foreach(_var INPUT OUTPUT NAMESPACE SYMBOL)
  if(NOT DEFINED ${_var})
    message(FATAL_ERROR "CvcEmbedText.cmake: -D${_var}= is required")
  endif()
endforeach()

file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _hex_len)
math(EXPR _size "${_hex_len} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n    " _bytes "${_bytes}")
string(REPLACE "::" ";" _ns_parts "${NAMESPACE}")
set(_open "")
set(_close "")
foreach(_ns IN LISTS _ns_parts)
  string(APPEND _open "namespace ${_ns} {\n")
  string(PREPEND _close "} // namespace ${_ns}\n")
endforeach()
get_filename_component(_name "${INPUT}" NAME)

string(CONCAT _text "// Generated by CMake/CvcEmbedText.cmake from ${_name}: do not edit.\n"
       "#include <cstddef>\n\n${_open}\n"
       "extern const unsigned char ${SYMBOL}[];\nextern const std::size_t ${SYMBOL}_size;\n"
       "const unsigned char ${SYMBOL}[] = {\n    ${_bytes}0x00};\n"
       "const std::size_t ${SYMBOL}_size = ${_size};\n\n${_close}")

if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" _old)
  if(_old STREQUAL _text)
    return()
  endif()
endif()
file(WRITE "${OUTPUT}" "${_text}")
