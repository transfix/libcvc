@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Required dependencies
find_dependency(Boost COMPONENTS thread date_time regex filesystem system chrono)

# ---------------------------------------------------------------------------
# Optional dependencies — only required if libcvc was built with them.
# Each guard checks the build-time flag baked into this config file.
# If the dependency is not found on the consumer system the imported
# target will still load; the consumer just won't be able to use the
# features that need the missing library at link time.
# ---------------------------------------------------------------------------

if(NOT @DISABLE_CGAL@)
  find_package(CGAL CONFIG QUIET)
endif()

if(@CVC_USING_HDF5@)
  find_package(HDF5 COMPONENTS C CXX QUIET)
endif()

if(@CVC_ENABLE_OPENMP@)
  find_package(OpenMP QUIET)
endif()

if(@CVC_ENABLE_IMAGEMAGICK@)
  # cvc::cvc's INTERFACE_LINK_LIBRARIES names the ImageMagick::Magick++ and
  # ImageMagick::MagickCore IMPORTED targets (that is how libcvc linked ImageMagick
  # at build time), so EVERY consumer must be able to materialise them or the first
  # add_library()/add_executable() that links cvc::cvc dies with "target ... not
  # found. Perhaps a find_package() call is missing for an IMPORTED target". Try the
  # stock module first (system installs / Magick++-config on PATH; also a no-op when
  # a parent build already created the targets).
  if(NOT TARGET ImageMagick::Magick++ OR NOT TARGET ImageMagick::MagickCore)
    find_package(ImageMagick COMPONENTS Magick++ MagickCore QUIET)
  endif()

  # Hermetic-prefix fallback. The stock FindImageMagick module routinely fails in a
  # relocated cvcpkg prefix (no Magick++-config on PATH; on Windows NO_DEFAULT_PATH
  # skips CMAKE_PREFIX_PATH) and, even when it does find the libs, older modules set
  # only ImageMagick_LIBRARIES and never the ImageMagick::* targets. Rebuild the
  # targets from the pkg-config files cvcpkg ships. Each .pc's `Requires` +
  # `Libs.private` carry the FULL static delegate closure (Magick++ -> MagickWand ->
  # MagickCore -> bz2/jpeg/png/webp/tiff/…), so the STATIC link line below is correct
  # for a STATIC ImageMagick and a safe superset for a SHARED one (the linker dedups
  # the delegates a shared libMagick++ already resolves). Supports both.
  if(NOT TARGET ImageMagick::Magick++ OR NOT TARGET ImageMagick::MagickCore)
    find_package(PkgConfig QUIET)
    if(PkgConfig_FOUND)
      pkg_search_module(_CVC_IM_CORE QUIET MagickCore-7.Q16HDRI MagickCore-7.Q16 MagickCore)
      pkg_search_module(_CVC_IM_XX   QUIET Magick++-7.Q16HDRI  Magick++-7.Q16  Magick++)
      if(_CVC_IM_CORE_FOUND AND NOT TARGET ImageMagick::MagickCore)
        add_library(ImageMagick::MagickCore INTERFACE IMPORTED)
        if(_CVC_IM_CORE_STATIC_LINK_LIBRARIES)
          set(_cvc_core_libs "${_CVC_IM_CORE_STATIC_LINK_LIBRARIES}")
        else()
          set(_cvc_core_libs "${_CVC_IM_CORE_LINK_LIBRARIES}")
        endif()
        set_target_properties(ImageMagick::MagickCore PROPERTIES
          INTERFACE_INCLUDE_DIRECTORIES "${_CVC_IM_CORE_INCLUDE_DIRS}"
          INTERFACE_LINK_LIBRARIES "${_cvc_core_libs}")
        set(_cvc_im_synth TRUE)
      endif()
      if(_CVC_IM_XX_FOUND AND NOT TARGET ImageMagick::Magick++)
        add_library(ImageMagick::Magick++ INTERFACE IMPORTED)
        if(_CVC_IM_XX_STATIC_LINK_LIBRARIES)
          set(_cvc_xx_libs "${_CVC_IM_XX_STATIC_LINK_LIBRARIES}")
        else()
          set(_cvc_xx_libs "${_CVC_IM_XX_LINK_LIBRARIES}")
        endif()
        set_target_properties(ImageMagick::Magick++ PROPERTIES
          INTERFACE_INCLUDE_DIRECTORIES "${_CVC_IM_XX_INCLUDE_DIRS}"
          INTERFACE_LINK_LIBRARIES "${_cvc_xx_libs}")
      endif()
    endif()
  endif()

  # Last resort (no .pc — e.g. the innoextracted Windows bundle — or no pkg-config
  # in an emcmake toolchain): find the libs directly under the prefix and CREATE the
  # imported targets (the old fallback set ImageMagick_LIBRARIES but never the
  # targets cvc::cvc's interface names, so consumers still failed). No delegate
  # closure here; sufficient for a shared ImageMagick (delegates in the .so) and for
  # a shared libcvc that already absorbed a static ImageMagick.
  if(NOT TARGET ImageMagick::Magick++ OR NOT TARGET ImageMagick::MagickCore)
    find_path(_CVC_IM_INCDIR NAMES Magick++.h
              PATH_SUFFIXES ImageMagick ImageMagick-7 ImageMagick-6)
    find_library(_CVC_IM_XX_LIB   NAMES Magick++-7.Q16HDRI Magick++-6.Q16 Magick++ CORE_RL_Magick++_)
    find_library(_CVC_IM_CORE_LIB NAMES MagickCore-7.Q16HDRI MagickCore-6.Q16 MagickCore CORE_RL_MagickCore_)
    if(_CVC_IM_XX_LIB AND _CVC_IM_CORE_LIB)
      if(NOT TARGET ImageMagick::MagickCore)
        add_library(ImageMagick::MagickCore UNKNOWN IMPORTED)
        set_target_properties(ImageMagick::MagickCore PROPERTIES
          IMPORTED_LOCATION "${_CVC_IM_CORE_LIB}")
        if(_CVC_IM_INCDIR)
          set_target_properties(ImageMagick::MagickCore PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${_CVC_IM_INCDIR}")
        endif()
        set(_cvc_im_synth TRUE)
      endif()
      if(NOT TARGET ImageMagick::Magick++)
        add_library(ImageMagick::Magick++ UNKNOWN IMPORTED)
        set_target_properties(ImageMagick::Magick++ PROPERTIES
          IMPORTED_LOCATION "${_CVC_IM_XX_LIB}"
          INTERFACE_LINK_LIBRARIES ImageMagick::MagickCore)
        if(_CVC_IM_INCDIR)
          set_target_properties(ImageMagick::Magick++ PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${_CVC_IM_INCDIR}")
        endif()
      endif()
    endif()
  endif()

  # Append the ImageMagick codec delegate closure to a SYNTHESISED MagickCore target.
  # MagickCore.pc does not list the delegates (they are separate cvcpkg bundles), so a
  # STATIC ImageMagick needs them appended explicitly — the same set
  # src/cvc/CMakeLists.txt links PRIVATE at build time. Harmless for a SHARED
  # ImageMagick (its .so already resolves them; the linker dedups). find_library
  # honours CMAKE_FIND_ROOT_PATH so this works under emcmake, and each missing delegate
  # is silently skipped. freetype is omitted on purpose (VTK ships vtkfreetype with the
  # same symbols -> wasm-ld duplicate-symbol).
  if(_cvc_im_synth AND TARGET ImageMagick::MagickCore)
    foreach(_cvc_del bz2 jpeg png16 webp webpmux webpdemux webpdecoder sharpyuv
                     tiff xml2 lzma Lerc brotlidec brotlicommon z)
      find_library(_CVC_DEL_${_cvc_del} NAMES ${_cvc_del})
      if(_CVC_DEL_${_cvc_del})
        set_property(TARGET ImageMagick::MagickCore APPEND PROPERTY
          INTERFACE_LINK_LIBRARIES "${_CVC_DEL_${_cvc_del}}")
      endif()
    endforeach()
  endif()
endif()

# When the assimp model loader is built in, cvcTargets.cmake puts
# `assimp::assimp` in cvc::cvc's INTERFACE_LINK_LIBRARIES — so every CONSUMER
# has to be able to resolve that imported target. Without this, the first
# downstream find_package(cvc) dies in cvcTargets.cmake with
#     The link interface of target "cvc::cvc" contains: assimp::assimp
#     but the target was not found.
# which is what broke cvcgl / pycvc / pycvc-gl in the release publish leg.
# NOT QUIET/optional: if assimp is in the link interface, a consumer that
# cannot find it cannot link, so failing here names the real missing package
# instead of surfacing as a confusing missing-target error two levels down.
if(@CVC_ENABLE_ASSIMP@)
  find_dependency(assimp)
  # The cvcpkg assimp bundle's exported target bakes an ABSOLUTE build-sandbox
  # zlib path into assimp::assimp's INTERFACE_LINK_LIBRARIES (libz.so/.a on unix,
  # zlib.lib on windows), so a consumer's link fails on a path that does not exist
  # on this machine. Rewrite it to the relocatable ZLIB::ZLIB here so EVERY
  # consumer (cvcGL, the examples, pycvc-gl, ...) links — this mirrors the same
  # rewrite in libcvc's own build. Remove once the assimp recipe exports zlib as
  # an imported target (libcvc-deps follow-up).
  find_package(ZLIB QUIET)
  get_target_property(_cvc_assimp_ill assimp::assimp INTERFACE_LINK_LIBRARIES)
  if(_cvc_assimp_ill AND "${_cvc_assimp_ill}" MATCHES "libz\\.|zlib\\.|cvcpkg-builder")
    if(TARGET ZLIB::ZLIB)
      string(REGEX REPLACE "[^;]*(libz|zlib)\\.[^;]*" "ZLIB::ZLIB" _cvc_assimp_ill
                           "${_cvc_assimp_ill}")
    else()
      string(REGEX REPLACE "[^;]*(libz|zlib)\\.[^;]*" "z" _cvc_assimp_ill "${_cvc_assimp_ill}")
    endif()
    set_target_properties(assimp::assimp PROPERTIES INTERFACE_LINK_LIBRARIES "${_cvc_assimp_ill}")
  endif()
endif()

if(@CVC_ENABLE_FFTW@)
  find_package(PkgConfig QUIET)
  if(PkgConfig_FOUND)
    pkg_check_modules(FFTW3 QUIET IMPORTED_TARGET fftw3)
  endif()
  if(NOT FFTW3_FOUND)
    find_path(FFTW3_INCLUDE_DIRS fftw3.h)
    find_library(FFTW3_LIBRARIES NAMES fftw3)
    if(FFTW3_INCLUDE_DIRS AND FFTW3_LIBRARIES AND NOT TARGET PkgConfig::FFTW3)
      add_library(PkgConfig::FFTW3 INTERFACE IMPORTED)
      set_target_properties(PkgConfig::FFTW3 PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${FFTW3_INCLUDE_DIRS}"
        INTERFACE_LINK_LIBRARIES "${FFTW3_LIBRARIES}")
    endif()
  endif()
endif()

if(@CVC_USING_IMOD_MRC@)
  find_package(libiimod CONFIG QUIET)
endif()

# CUDA: when libcvc was built with CUDA support its INTERFACE links the
# CUDA::cudart imported target, so consumers need CUDAToolkit imported
# before cvcTargets.cmake is read.
if(@CVC_ENABLE_CUDA@)
  find_package(CUDAToolkit QUIET)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cvcTargets.cmake")

check_required_components(cvc)
