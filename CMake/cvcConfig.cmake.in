@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Required dependencies
find_dependency(Boost COMPONENTS thread date_time regex filesystem system chrono)

# ---------------------------------------------------------------------------
# Optional dependencies — only required if libcvc was built with them.
# Each guard checks the build-time flag baked into this config file.
# If the dependency is not found on the consumer system the imported
# target will still load; the consumer just won't be able to use the
# features that need the missing library at link time.
# ---------------------------------------------------------------------------

if(NOT @DISABLE_CGAL@)
  find_package(CGAL CONFIG QUIET)
endif()

if(@CVC_USING_HDF5@)
  find_package(HDF5 COMPONENTS C CXX QUIET)
endif()

if(@CVC_ENABLE_OPENMP@)
  find_package(OpenMP QUIET)
endif()

if(@CVC_ENABLE_IMAGEMAGICK@)
  find_package(ImageMagick COMPONENTS Magick++ MagickCore QUIET)
  # Windows: the stock FindImageMagick module uses NO_DEFAULT_PATH and so
  # never searches CMAKE_PREFIX_PATH; the cvcpkg imagemagick bundle is
  # innoextracted into the prefix (no registry entry / .pc). Mirror the
  # prefix-searching fallback used when libcvc itself was built (see
  # src/cvc/CMakeLists.txt) so consumers can resolve it too.
  if(WIN32 AND NOT ImageMagick_FOUND)
    find_path(ImageMagick_INCLUDE_DIR NAMES Magick++.h
              PATH_SUFFIXES ImageMagick ImageMagick-7)
    find_library(ImageMagick_Magickxx_LIBRARY NAMES Magick++ CORE_RL_Magick++_)
    find_library(ImageMagick_MagickCore_LIBRARY NAMES MagickCore CORE_RL_MagickCore_)
    if(ImageMagick_INCLUDE_DIR AND ImageMagick_Magickxx_LIBRARY
       AND ImageMagick_MagickCore_LIBRARY)
      set(ImageMagick_FOUND TRUE)
      set(ImageMagick_INCLUDE_DIRS "${ImageMagick_INCLUDE_DIR}")
      set(ImageMagick_LIBRARIES
          "${ImageMagick_Magickxx_LIBRARY};${ImageMagick_MagickCore_LIBRARY}")
    endif()
  endif()
endif()

# When the assimp model loader is built in, cvcTargets.cmake puts
# `assimp::assimp` in cvc::cvc's INTERFACE_LINK_LIBRARIES — so every CONSUMER
# has to be able to resolve that imported target. Without this, the first
# downstream find_package(cvc) dies in cvcTargets.cmake with
#     The link interface of target "cvc::cvc" contains: assimp::assimp
#     but the target was not found.
# which is what broke cvcgl / pycvc / pycvc-gl in the release publish leg.
# NOT QUIET/optional: if assimp is in the link interface, a consumer that
# cannot find it cannot link, so failing here names the real missing package
# instead of surfacing as a confusing missing-target error two levels down.
if(@CVC_ENABLE_ASSIMP@)
  find_dependency(assimp)
  # The cvcpkg assimp bundle's exported target bakes an ABSOLUTE build-sandbox
  # zlib path into assimp::assimp's INTERFACE_LINK_LIBRARIES (libz.so/.a on unix,
  # zlib.lib on windows), so a consumer's link fails on a path that does not exist
  # on this machine. Rewrite it to the relocatable ZLIB::ZLIB here so EVERY
  # consumer (cvcGL, the examples, pycvc-gl, ...) links — this mirrors the same
  # rewrite in libcvc's own build. Remove once the assimp recipe exports zlib as
  # an imported target (libcvc-deps follow-up).
  find_package(ZLIB QUIET)
  get_target_property(_cvc_assimp_ill assimp::assimp INTERFACE_LINK_LIBRARIES)
  if(_cvc_assimp_ill AND "${_cvc_assimp_ill}" MATCHES "libz\\.|zlib\\.|cvcpkg-builder")
    if(TARGET ZLIB::ZLIB)
      string(REGEX REPLACE "[^;]*(libz|zlib)\\.[^;]*" "ZLIB::ZLIB" _cvc_assimp_ill
                           "${_cvc_assimp_ill}")
    else()
      string(REGEX REPLACE "[^;]*(libz|zlib)\\.[^;]*" "z" _cvc_assimp_ill "${_cvc_assimp_ill}")
    endif()
    set_target_properties(assimp::assimp PROPERTIES INTERFACE_LINK_LIBRARIES "${_cvc_assimp_ill}")
  endif()
endif()

if(@CVC_ENABLE_FFTW@)
  find_package(PkgConfig QUIET)
  if(PkgConfig_FOUND)
    pkg_check_modules(FFTW3 QUIET IMPORTED_TARGET fftw3)
  endif()
  if(NOT FFTW3_FOUND)
    find_path(FFTW3_INCLUDE_DIRS fftw3.h)
    find_library(FFTW3_LIBRARIES NAMES fftw3)
    if(FFTW3_INCLUDE_DIRS AND FFTW3_LIBRARIES AND NOT TARGET PkgConfig::FFTW3)
      add_library(PkgConfig::FFTW3 INTERFACE IMPORTED)
      set_target_properties(PkgConfig::FFTW3 PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${FFTW3_INCLUDE_DIRS}"
        INTERFACE_LINK_LIBRARIES "${FFTW3_LIBRARIES}")
    endif()
  endif()
endif()

if(@CVC_USING_IMOD_MRC@)
  find_package(libiimod CONFIG QUIET)
endif()

# CUDA: when libcvc was built with CUDA support its INTERFACE links the
# CUDA::cudart imported target, so consumers need CUDAToolkit imported
# before cvcTargets.cmake is read.
if(@CVC_ENABLE_CUDA@)
  find_package(CUDAToolkit QUIET)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cvcTargets.cmake")

check_required_components(cvc)
