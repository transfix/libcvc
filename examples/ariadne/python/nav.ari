# nav.ari — a Python loop drives a fleet of Humvees through a city (pycvc's cvc::nav sim_world)
# and draws it in this document. nav.py runs it:
#
#   python nav.py                                  # a window; Austin if its bundle is installed
#   python nav.py --plant kinematic                # nav's own bicycle instead of Jolt
#   python nav.py --offscreen --png nav.png
#
# The document declares the look and every panel; nav.py does the rest:
# - it loads the city (Austin's terrain and buildings, or a block city) and a Humvee per agent
#   into this document's scene, at their real size;
# - every frame it steps the world on the chosen plant (`sim.plant`: Jolt physics or nav's
#   kinematic bicycle), each Humvee following a route planned for its turning radius, and sends
#   one that arrives to a new goal;
# - it publishes the readouts (`stats.*`, `agent.*`, the `speeds` plot) and a map picture, `map`;
# - it reads the Sim window's controls (`sim.*`) and handles Restart and New goals.
#
# The look is terrain_lab.ari's soft afternoon: a low warm sun, a cool fill, a pale sky, and
# soft-edged shadows (`softness`: the shadow filter's radius in texels) that follow the camera.

meta:
  name: Python nav (Humvees, sim_world)
  author: cvc
  min_libcvc: 3.4.0

requires:
  - gl.scene                       # the city and the Humvees are the point: no headless run
  - quit                           # the Sim menu's Quit

init: |
  (begin
    (state-set "sim.agents" "8")
    (state-set "sim.ticks" "2")
    (state-set "sim.paused" "0")
    (state-set "sim.camera" "follow")
    (state-set "show.routes" "1"))

menubar:
  - menu: Sim
    items:
      - menu_item: Paused
        bind: sim.paused
      - menu_item: Routes
        bind: show.routes
      - menu_item: Restart
        on: restart
      - menu_item: New goals
        on: shuffle
      - separator
      - menu_item: Quit
        on: quit

windows:
  - window: Sim
    id: sim
    pos: [16, 30]
    size: [300, 230]
    children:
      - slider_int: Humvees
        bind: sim.agents
        lo: 1
        hi: 24
      - combo: Plant
        bind: sim.plant
        options: [jolt, kinematic]
        values: [jolt, kinematic]
      - combo: Camera
        bind: sim.camera
        options: [follow, overview]
        values: [follow, overview]
      - slider_int: Ticks per frame
        bind: sim.ticks
        lo: 1
        hi: 8
      - checkbox: Paused
        bind: sim.paused
      - checkbox: Routes
        bind: show.routes
      - button: Restart
        on: restart
      - button: New goals
        on: shuffle

  - window: Readout
    id: readout
    pos: [16, 272]
    size: [300, 220]
    children:
      - text: "world"
        bind: stats.world
      - text: "plant"
        bind: stats.plant
      - text: "sim time (s)"
        bind: stats.time
      - text: "trips"
        bind: stats.trips
      - text: "mean speed (m/s)"
        bind: stats.speed
      - plot: Mean speed
        bind: speeds
        height: 56
      - separator
      - text: "Humvee 0"
        bind: agent.summary

  - window: Map
    id: map
    pos: [16, 504]
    size: [236, 262]
    children:
      - image: Routes
        src: map
        size: 210

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 2
    softness: 3
    focus: { follow: camera, min_radius: 60, max_radius: 500, per_distance: 3, lead: 0.5,
             lift: 20, ground: world }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 25], radius: 700 }
      key: { intensity: 1.3, azimuth: -60, elevation: 32, cone: 62 }
      fill: 0.3
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.32
