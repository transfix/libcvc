# world_gym.ari — the lab's worlds as a gym (ARIADNE_WORLDS.md section 14, L4): world_lab.ari's
# three worlds, its vehicles and its spawn points, in a document that needs no renderer.
#
# It requires scene.physics alone, so every host runs it: pycvc.WorldGym and cvc::ariadne::WorldGym
# headless (world_gym.py drives it from Python), ari, pycvc's AriApp, and arigl, which draws it
# (open it there to watch the vehicles drive with nav@1). The World and Physics panels pick the
# world and show the vehicles; a gym's options pick them too (world=, count=).
#
#   python world_gym.py                       # a policy of yours against nav@1, headless
#   arigl world_gym.ari                       # the same world, drawn

meta:
  name: World Gym (Ariadne)
  author: cvc
  min_libcvc: 3.7.8

requires:
  - scene.physics                         # its physics and bodies run on every host, headless too

import:
  - cvc://components/world_source.ari
  - cvc://components/world_physics.ari

windows:
  - include: world_source
    pos: [16, 36]
    size: [340, 600]
    closable: true
  - include: world_physics
    pos: [370, 36]
    size: [320, 560]
    closable: true

world:
  vehicles:
    archetypes:
      humvee:
        vehicle: humvee
        ranges: { mass: [2000, 3500], max_speed: [5, 20] }
        controllers: [nav@1, none]
      roboracer:
        vehicle: { preset: roboracer, max_speed: 8 }
        ranges: { mass: [2.5, 6], max_speed: [2, 10] }
        controllers: [nav@1, none]
  spawns:
    policy: round_robin
    scope: all
    points:
      - { at: [-60, -60], heading: 45, team: 0, world: flat }
      - { at: [-60, 60], heading: -45, team: 0, world: flat }
      - { at: [60, -60], heading: 135, team: 1, world: flat }
      - { at: [60, 60], heading: -135, team: 1, world: flat }

scene:
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  physics: {}
  world: { source: flat, cell: 2 }
  lights:
    - light: sun
      rig: three_point
      sun: true
      stage: { center: [0, 0, 10], radius: 200 }
      key: { intensity: 1.3, azimuth: -60, elevation: 35, cone: 62 }
      fill: 0.2
      back: 0
      wash: 0
  nodes:
    - node: land
      type: generated_world
      world: generated
      seed: 5
      half: 150
      trees: 60
      rocks: 20
      buildings: 24
      body: {}
    - node: hill
      world: terrain
      source:
        heightfield:
          size: 200
          resolution: 81
          layers:
            - { kind: dome, amplitude: 12.0, radius: 60 }
      material: { color: [0.45, 0.55, 0.32] }
      body: static
    - node: square
      world: flat
      source: { box: { size: [200, 200, 1] } }
      transform: { position: [0, 0, -0.5] }
      material: { color: [0.62, 0.62, 0.6] }
      body: static
    - node: crate
      source: { box: { size: [4, 4, 4] } }
      transform: { position: [6, -4, 3] }
      material: { color: [0.8, 0.45, 0.2] }
      body: { mass: 200 }
