# viewer_grid.ari — four views of one scene, each with a camera of its own (docs/ARIADNE.md §5.18).
#
# A bunny in a courtyard of coloured pillars. The Views window holds a 2 x 2 grid of `viewport`
# widgets on the same scene: a front view, a side view, a top-down map and a close-up. Each one's
# camera is its own (<prefix>.viewers.<view>.camera): drag in a view to turn it (the middle or right
# button pans), use the wheel there to zoom it, double-click it to put it back. The others, and the
# main view behind the window, stay where they are.
#
#   arigl viewer_grid.ari
#   arigl snapshot --frames 6 --png viewer_grid.png viewer_grid.ari

meta:
  name: Viewer grid (Ariadne)
  author: cvc
  min_libcvc: 3.7.0

requires:
  - gl.scene                       # a scene renderer realizes the scene: block (arigl; not ari)

windows:
  - window: Views
    id: views
    pos: [16, 16]
    children:
      - text: "Drag a view to turn it, wheel to zoom, double-click to reset."
      - type: group
        layout: { kind: grid, col_widths: [auto, auto] }
        children:
          - type: viewport
            view: front
            caption: Front
            azimuth: -90
            elevation: 15
            zoom: 1.6
            width: 300
            height: 225
          - type: viewport
            view: side
            caption: Side
            azimuth: 0
            elevation: 15
            zoom: 1.6
            width: 300
            height: 225
          - type: viewport
            view: top
            caption: Top
            camera: map
            width: 300
            height: 225
          - type: viewport
            view: close
            caption: Close-up
            azimuth: -140
            elevation: 25
            zoom: 2.5
            width: 300
            height: 225

scene:
  chrome: false
  background: { top: [0.32, 0.42, 0.55], bottom: [0.08, 0.09, 0.11] }
  nodes:
    - node: ground
      type: geometry
      source: { plane: { size: 30 } }
      material: { color: [0.34, 0.38, 0.32] }
    - node: bunny
      type: geometry
      source: { file: stanford.bunny }
      fit: { height: 4, up: y }
      material: { color: [0.86, 0.83, 0.90], specular: 0.25, specular_power: 24 }
    # One pillar of each colour at the courtyard's corners, so every view says which way it looks.
    - node: pillar_ne
      type: geometry
      source: { box: { size: [1.2, 1.2, 6] } }
      transform: { position: [7, 7, 3] }
      material: { color: [0.90, 0.25, 0.20] }
    - node: pillar_nw
      type: geometry
      source: { box: { size: [1.2, 1.2, 6] } }
      transform: { position: [-7, 7, 3] }
      material: { color: [0.20, 0.45, 0.90] }
    - node: pillar_sw
      type: geometry
      source: { box: { size: [1.2, 1.2, 6] } }
      transform: { position: [-7, -7, 3] }
      material: { color: [0.95, 0.80, 0.20] }
    - node: pillar_se
      type: geometry
      source: { box: { size: [1.2, 1.2, 6] } }
      transform: { position: [7, -7, 3] }
      material: { color: [0.25, 0.80, 0.40] }
    - node: orb_e
      type: geometry
      source: { sphere: 0.9 }
      transform: { position: [10, 0, 0.9] }
      material: { color: [0.95, 0.55, 0.15] }
    - node: orb_n
      type: geometry
      source: { sphere: 0.9 }
      transform: { position: [0, 10, 0.9] }
      material: { color: [0.55, 0.30, 0.85] }
  lights:
    - light: sun
      kind: directional
      azimuth: 135
      elevation: 55
