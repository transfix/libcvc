# viewer_looks.ari — four views of one scene, each showing part of it or restyling it
# (docs/ARIADNE.md §5.18).
#
# A plaza: buildings, a statue, people walking it (tagged sim) and their planned paths (tagged
# debug). The main view draws it as authored. Each view in the Looks window draws the same geometry
# differently, with no copy of it: an `override:` gives a view's actors their own look over the
# node's mapper, and show: / hide: leave nodes out.
#   Wireframe   every building and the statue as lines, on black
#   X-ray       the buildings see-through, the people bright, so they show behind walls
#   Plan        a top-down map of the people and their paths only (the buildings left out)
#   Clay        everything one plain colour, as an architect's model, the people picked out in red
# Each camera is its own: drag, wheel, double-click to reset.
#
#   arigl viewer_looks.ari
#   arigl snapshot --frames 6 --png viewer_looks.png viewer_looks.ari

meta:
  name: Viewer looks (Ariadne)
  author: cvc
  min_libcvc: 3.7.0

requires:
  - gl.scene                       # a scene renderer realizes the scene: block (arigl; not ari)

windows:
  - window: Looks
    id: looks
    pos: [16, 16]
    children:
      - text: "One scene, four looks. Drag a view to turn it, double-click to reset."
      - type: group
        layout: { kind: grid, col_widths: [auto, auto] }
        children:
          - type: viewport
            view: wire
            caption: Wireframe
            azimuth: -120
            elevation: 30
            zoom: 1.3
            clear_color: [0.0, 0.0, 0.0]
            chrome: false
            hide: [debug]
            override:
              buildings: { drawstyle: wireframe, color: [0.35, 0.85, 1.0] }
              statue: { drawstyle: wireframe, color: [1.0, 0.75, 0.3] }
              ground: { drawstyle: wireframe, color: [0.25, 0.30, 0.35] }
            width: 300
            height: 225
          - type: viewport
            view: xray
            caption: X-ray
            azimuth: -60
            elevation: 25
            zoom: 1.3
            hide: [debug]
            override:
              buildings: { opacity: 0.18 }
              sim: { color: [1.0, 0.9, 0.15] }
            width: 300
            height: 225
          - type: viewport
            view: plan
            caption: Plan
            camera: map
            chrome: false
            hide: [buildings, statue]
            clear_color: [0.06, 0.07, 0.09]
            override:
              ground: { color: [0.16, 0.18, 0.20] }
            width: 300
            height: 225
          - type: viewport
            view: clay
            caption: Clay
            azimuth: 120
            elevation: 40
            zoom: 1.2
            chrome: false
            hide: [debug]
            clear_color: [0.85, 0.86, 0.88]
            override:
              "*": { color: [0.92, 0.91, 0.88] }
              sim: { color: [0.90, 0.25, 0.20] }
            width: 300
            height: 225

scene:
  chrome: false
  background: { top: [0.40, 0.50, 0.62], bottom: [0.10, 0.11, 0.13] }
  nodes:
    - node: ground
      type: geometry
      source: { plane: { size: 40 } }
      material: { color: [0.46, 0.45, 0.42] }
    - node: buildings
      type: group
      tags: [buildings]
      children:
        - node: tower
          type: geometry
          source: { box: { size: [5, 5, 14] } }
          transform: { position: [-9, 8, 7] }
          material: { color: [0.72, 0.68, 0.62] }
        - node: hall
          type: geometry
          source: { box: { size: [10, 5, 5] } }
          transform: { position: [7, 9, 2.5] }
          material: { color: [0.64, 0.60, 0.55] }
        - node: block
          type: geometry
          source: { box: { size: [6, 8, 8] } }
          transform: { position: [10, -7, 4] }
          material: { color: [0.58, 0.62, 0.66] }
        - node: kiosk
          type: geometry
          source: { box: { size: [3, 3, 3] } }
          transform: { position: [-8, -9, 1.5] }
          material: { color: [0.70, 0.55, 0.45] }
    - node: statue
      type: geometry
      tags: [statue]
      source: { file: stanford.bunny }
      fit: { height: 3.5, up: y }
      material: { color: [0.80, 0.78, 0.74], specular: 0.3, specular_power: 30 }
    # People walking the plaza, and where each is headed.
    - node: people
      type: group
      tags: [sim]
      children:
        - node: p1
          type: geometry
          source: { sphere: 0.6 }
          transform: { position: [-3, -4, 0.6] }
          material: { color: [0.90, 0.30, 0.25] }
        - node: p2
          type: geometry
          source: { sphere: 0.6 }
          transform: { position: [4, 2, 0.6] }
          material: { color: [0.25, 0.55, 0.90] }
        - node: p3
          type: geometry
          source: { sphere: 0.6 }
          transform: { position: [-6, 3, 0.6] }
          material: { color: [0.30, 0.80, 0.40] }
        - node: p4
          type: geometry
          source: { sphere: 0.6 }
          transform: { position: [12, 2, 0.6] }   # behind the hall from the main view
          material: { color: [0.85, 0.45, 0.85] }
    - node: paths
      type: group
      tags: [debug]
      children:
        - node: path1
          type: geometry
          source: { box: { size: [0.25, 9, 0.1] } }
          transform: { position: [-3, -8.5, 0.05] }
          material: { color: [0.95, 0.40, 0.30] }
        - node: path2
          type: geometry
          source: { box: { size: [8, 0.25, 0.1] } }
          transform: { position: [8, 2, 0.05] }
          material: { color: [0.35, 0.65, 0.95] }
        - node: path3
          type: geometry
          source: { box: { size: [0.25, 6, 0.1] } }
          transform: { position: [-6, 6, 0.05] }
          material: { color: [0.40, 0.90, 0.50] }
  lights:
    - light: sun
      kind: directional
      azimuth: 135
      elevation: 55
