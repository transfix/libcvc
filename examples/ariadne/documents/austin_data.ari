# austin_data.ari — a city the document names, loaded from cvcpkg.org into the state tree and drawn
# (docs/ARIADNE.md §5.17, docs/roadmap/ARIADNE_DATA_ROADMAP.md).
#
# The data: block names the Austin scene package. The host:
#   - asks the registry for its newest data build;
#   - downloads the archive and checks it against the registry's sha256 (later runs read the
#     local cache);
#   - unpacks the bundle's directory in memory;
#   - decodes it into a world: the terrain as a height field, the buildings as one mesh.
# The scene's city node draws that world once it is ready, and the window shows how far the load
# has got. The two buttons swap the small city for the full one and back, from the document alone:
# (data-load) points data.city at the other package, and the city node redraws when it is in.
#
# Run (the network is the host's to turn on):
#   arigl --net-allow https://cvcpkg.org austin_data.ari
#   arigl --net-allow https://cvcpkg.org austin_data.ari --offscreen --frames 600 --png austin.png

meta:
  name: Austin, from cvcpkg.org
  author: cvc
  min_libcvc: 3.7.8

requires:
  - gl.scene                       # the city is the point: a scene renderer draws it
  - net                            # cvcpkg.org, through the host's network

data:
  city:
    uri: cvcpkg://cy-pca/scene-austin-south-small
    path: share/cvc-scenes/austin_south
    as: city_bundle

windows:
  - window: City
    id: city
    pos: [16, 30]
    size: [360, 210]
    children:
      - text: ""
        bind: data.city.canonical
      - text: ""
        bind: data.city.status
      - progress: Loading
        bind: data.city.progress
        lo: 0
        hi: 1
      - text: ""
        bind: data.city.error
      - separator
      - button: The full city (117 MB)
        on: (data-load "city" "cvcpkg://cy-pca/scene-austin-south" "city_bundle"
                       "share/cvc-scenes/austin_south")
      - button: The small city (10 MB)
        on: (data-load "city" "cvcpkg://cy-pca/scene-austin-south-small" "city_bundle"
                       "share/cvc-scenes/austin_south")

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 4
    softness: 2
    focus: { follow: camera, min_radius: 150, max_radius: 1500, per_distance: 3, lead: 0.5,
             lift: 20, ground: city }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 25], radius: 1500 }
      key: { intensity: 1.3, azimuth: -60, elevation: 28, cone: 62 }
      fill: 0.3
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.32
  nodes:
    - node: city
      source: { data: city }       # data.city's world: its terrain and its buildings
