# world_lab.ari — the lab's world panels (ARIADNE_WORLDS.md section 14, L1): one scene with three
# worlds, and a crate and a ball that fall on whichever is on.
#
# The worlds are nodes with `world: <name>`: a generated world (cvc::world::generate_world, its
# terrain and buildings its colliders), a dome-shaped terrain and a flat walled square. One is on at
# a time: the World panel's Source picks it (scene.world.source). The world runtime keeps the
# others out of the physics world and undrawn, and publishes the world on: its kind, when it is
# ready, a revision that goes up each time it changes, and the navigator's grid of it (cell: 4).
# Generated shows the generator's settings and Regenerate; the Physics panel turns physics off and
# on, pauses, steps and restarts the world, and shows its bodies, contacts and step time.
#
# The same document runs headless (ari, pycvc's AriApp): the worlds switch and the bodies follow;
# only the drawing is left out.
#
# Run (arigl from the build tree finds the component library itself):
#   arigl world_lab.ari
#   arigl world_lab.ari --offscreen --frames 60 --png world_lab.png

meta:
  name: World Lab (Ariadne)
  author: cvc
  min_libcvc: 3.7.8

requires:
  - gl.scene

customs:
  - node: generated_world
    required: true

import:
  - cvc://components/world_source.ari
  - cvc://components/world_physics.ari

menubar:
  - menu: Sim
    items:
      - menu_item: Quit
        on: quit
  - menu: Panels
    items:
      - menu_item: World
        bind: tree.world_source.open
      - menu_item: Physics
        bind: tree.world_physics.open

windows:
  - include: world_source
    pos: [16, 36]
    size: [340, 600]
    closable: true
  - include: world_physics
    pos: [370, 36]
    size: [320, 460]
    closable: true

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  physics: {}
  world: { source: generated, cell: 4 }
  lights:
    - light: sun
      rig: three_point
      sun: true
      stage: { center: [0, 0, 10], radius: 200 }
      key: { intensity: 1.3, azimuth: -60, elevation: 35, cone: 62 }
      fill: 0.2
      back: 0
      wash: 0
  nodes:
    - node: land
      type: generated_world
      world: generated
      seed: 5
      half: 150
      trees: 60
      rocks: 20
      buildings: 24
      body: {}
    - node: hill
      world: terrain
      source:
        heightfield:
          size: 200
          resolution: 81
          layers:
            - { kind: dome, amplitude: 12.0, radius: 60 }
      material: { color: [0.45, 0.55, 0.32] }
      body: static
    - node: square
      world: flat
      source: { box: { size: [200, 200, 1] } }
      transform: { position: [0, 0, -0.5] }
      material: { color: [0.62, 0.62, 0.6] }
      body: static
    - node: crate
      source: { box: { size: [4, 4, 4] } }
      transform: { position: [6, -4, 60] }
      material: { color: [0.8, 0.45, 0.2] }
      body: { mass: 200 }
    - node: ball
      source: { sphere: 2.0 }
      transform: { position: [-5, 3, 70] }
      material: { color: [0.25, 0.4, 0.8] }
      body: { density: 400 }
