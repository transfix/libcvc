    - { node: block_10, world: city, body: static, material: { color: [0.54, 0.60, 0.56] },
        source: { box: { size: [26, 26, 29.9] } }, transform: { position: [-95, -57, 14.95] } }
    - { node: block_11, world: city, body: static, material: { color: [0.70, 0.64, 0.52] },
        source: { box: { size: [26, 26, 8.5] } }, transform: { position: [-57, -57, 4.25] } }
    - { node: block_12, world: city, body: static, material: { color: [0.54, 0.60, 0.56] },
