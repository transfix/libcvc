# conference_roster.ari — the BROWSER (wasm) conference client.
#
# Layout (all windows are closable + openable from the View menu):
#   • My Camera  (id mycam)   — your own camera, a camera + mic device picker, and camera/mic toggles.
#   • Avatar     (id myavatar) — your avatar: what you look like (a colour and something to wear, from
#                               the relay's catalog; everyone sees the same avatar, you included),
#                               your body and controller, and your energy -- the relay's budget,
#                               where your reserve went (the ledger) and its recent history.
#   • Users      (id users)   — everyone in the room (components/room_users.ari): name (lights up
#                               GREEN while talking), per-peer LOCAL camera/mic mute + a volume slider,
#                               click a name to raise that peer's camera window, and a message button
#                               for a direct message. These controls are LOCAL — they change only what
#                               THIS client sees/hears, never the other person's capture.
#   • Chat       (id chat)    — the room's chat and your direct messages (components/chat.ari): pick
#                               the room or a conversation, scroll up for older messages, Enter sends
#                               and Shift+Enter adds a line.
#   • cam_<i>    (per peer)    — one window per OTHER participant, titled by their name, showing their
#                               camera. Repeated over peer.count; opened automatically, closable, and
#                               listed by name at the end of the View menu to open again (or click
#                               the name in Users). Closed or open, it stays with the person when
#                               the list reorders.
#
# The host (arigl ConferenceSession) drives the media: it forwards our camera+mic, mixes every peer's
# audio into one output (per-peer volume + mute from the Users window), measures voice activity
# (media.<pid>.talking), and publishes the camera/mic device lists (cam.devices / mic.devices) + maps
# a picked device name to cam.want_device / mic.want_device for the re-capture below.
#
# conf.room / conf.self / self.pid / cam_synthetic are set by the host before this loads.

meta:
  name: Ariadne conference
  author: cvc
  min_libcvc: 3.6.0

requires:
  - gl.scene                       # a scene renderer realizes the scene: block (arigl; not ari)
  - stream_view
  - stream-open                    # media: capture and mute
  - stream-capture-camera
  - stream-capture-audio
  - stream-set-muted
  - room-join                      # the room (arigl registers these when CVC_ARIADNE_RELAY is set)
  - room-roster
  - room-set-avatar                # the Avatar window
  - plot                           # its history graphs
  - chat-post                      # the Chat window (chat.ari; the relay keeps the history)
  - text_view
  - message_input

# The Users and Chat windows are the shipped components: their units, and the functions that keep
# them current (room-users-step, chat-ui-step), which on_tick calls.
import: [cvc://components/room_users.ari, cvc://components/chat.ari]

# The room's LOOK. The relay owns what is IN the room (conf.rooms.<room>.scene: the ground, the
# reference box; the avatars), and every client draws it under this document's lighting, so the
# rig lives here, not in the server. A three-point rig staged over the 20 m floor: the key spot casts
# real-time shadows from the scene objects and every avatar (re-baked in any frame something that
# casts has moved, so a walking avatar's shadow walks with it, and an idle room bakes none); fill,
# back and environment keep the shaded sides readable.
scene:
  lights:
    - light: room_rig
      rig: three_point
      stage: { center: [0, 0, 1], radius: 10 }
      key: { intensity: 0.9, azimuth: -35, elevation: 55, cone: 48 }
      fill: 0.25
      back: 0.25
      warmth: 0.25
      environment: 0.15
      ambient: 0.12
  shadows:
    enabled: true
    resolution: 2048
    update_interval: 1

# The peers' camera windows (cam_<i>, made by a repeat) are listed by name at the end of View: the
# built-in Windows menu under that title joins it (ARIADNE.md §5.9).
windows_menu: View

menubar:
  - menu: Room
    items:
      - menu_item: Quit
        on: quit
  - menu: View
    items:
      - menu_item: My Camera
        bind: tree.mycam.open
      - menu_item: Users
        bind: tree.users.open
      - menu_item: Chat
        bind: tree.chat.open
      - menu_item: Avatar
        bind: tree.myavatar.open

windows:
  # ── My Camera: your name, self-view, device pickers + on/off toggles ──
  - window: My Camera
    id: mycam
    pos: [20, 40]
    size: [360, 560]
    closable: true
    children:
      # Your display name — the web client launches you in under a random "guest-xxxx"; edit this to
      # change it. On commit, on_tick checks the name is free and re-asserts your room presence so peers
      # see the new name (your internal id stays fixed, only the shown name changes). If another
      # participant already uses that name, on_tick refuses it and shows the error below instead.
      - type: input_text
        label: "Name"
        bind: conf.self
      # Name-taken error (red). on_tick sets name_error when the typed name is already in the room; the
      # field keeps what you typed, but your presence keeps its previous name until you pick a free one.
      - text: ""
        bind: name_error
        color: [1.0, 0.4, 0.4]
        visible_when: (not (= (state-get "name_error") ""))
      - separator
      # A box, not a width: a portrait phone camera shows whole, letterboxed, rather than squashed
      # or standing taller than the window.
      - type: stream_view
        bind: cam_token
        size: [320, 240]
      - separator
      # Device pickers (real-device builds only; empty + hidden under ?synthetic=1). Picking a device
      # updates cam.sel / mic.sel; the host maps it to cam.want_device / mic.want_device and on_tick
      # re-captures. options come from the host-published, newline-joined device lists.
      - type: combo
        label: "Camera"
        bind: cam.sel
        options: (string.split (state-get "cam.devices") "\n")
        visible_when: (not (= (state-get "cam_synthetic") "1"))
      - type: combo
        label: "Mic"
        bind: mic.sel
        options: (string.split (state-get "mic.devices") "\n")
        visible_when: (not (= (state-get "cam_synthetic") "1"))
      - separator
      # Camera/mic on-off: stream-set-muted blanks the producer at the source (black video / silence)
      # WITHOUT dropping the publish, so peers stay subscribed. The host then sends nothing (silence
      # and a camera that is off cost no bandwidth) and publishes video.off, so peers show "camera
      # off" instead of the last frame they got. Plain "on": the browser build's font is ASCII, so a
      # "●" there draws as "?".
      - type: button
        label: "camera on/off"
        on: (begin (state-set "cam_on" (if (= (state-get "cam_on") "1") "0" "1")) (stream-set-muted (state-get "cam_token") (= (state-get "cam_on") "0")))
      - text: "camera"
        bind: (if (= (state-get "cam_on") "1") "on" "muted")
      - type: button
        label: "mic on/off"
        on: (begin (state-set "mic_on" (if (= (state-get "mic_on") "1") "0" "1")) (stream-set-muted (state-get "mic_token") (= (state-get "mic_on") "0")))
      - text: "mic"
        bind: (if (= (state-get "mic_on") "1") "on" "muted")
      # The size the relay sends you everyone's camera at: it steps down when your link cannot
      # keep up (more ping from queueing, frames dropped) and back up once it can.
      - text: ""
        bind: self.video_in

  # ── Avatar: how you look, what you move with, and where your energy went ──
  # The look: the relay offers the choices (conf.rooms.<room>.avatars, room_avatar.h); on_tick writes
  # a pick to your own participant subtree, and every client -- yours too -- draws what it resolves
  # to. So the avatar you walk around as is the one everyone else sees. Automatic is a colour derived
  # from your id, which is what you look like until you choose. What you wear is only drawn.
  # The rest is published by the host as self.avatar.* (avatar_panel.h), four times a second:
  #   * body and controller: what the physics simulates (everyone's is the same box, walking);
  #   * the energy budget: the relay's policy, the same for everyone -- a push of at most 840 N, at
  #     most 1.2 kW, a 30 kJ reserve refilled at 300 W, carrying the body costs 0.2 m g |v| -- and
  #     your reserve now (your client's count, which the relay's corrects);
  #   * the ledger: where the reserve went since you joined, line by line. The lines balance:
  #     now = started with + refilled - work - carried - overflow + unpaid + corrections, so the
  #     residual is 0 (rounding aside);
  #   * the history: the reserve and the power you spent over the last minute.
  # Each line shows a short value; what it means is its tooltip (a policy line's is published as
  # self.avatar.policy.<line>_tip), since a sentence beside the value is cut off in a narrow window.
  - window: Avatar
    id: myavatar
    pos: [20, 610]
    size: [440, 680]
    closable: true
    children:
      - text: "How everyone sees you in the room, you included."
      # The pickers' options: the catalog's labels, which on_tick publishes newline-joined (a widget's
      # expression may only use pure functions, so it cannot call room-avatar-options itself).
      - type: combo
        label: "Colour"
        bind: avatar.color
        options: (string.split (state-get "avatar.colors") "\n")
        visible_when: (not (= (state-get "avatar.colors") ""))
      - type: combo
        label: "Wear"
        bind: avatar.accessory
        options: (string.split (state-get "avatar.accessories") "\n")
        visible_when: (not (= (state-get "avatar.accessories") ""))
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "body"
          - text: ""
            bind: self.avatar.body
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "controller"
          - text: ""
            bind: self.avatar.controller
      - separator
      - text: "Energy budget"
        color: [0.75, 0.85, 1.0]
      - text: "waiting for your avatar to join the room"
        visible_when: (not (= (state-get "self.avatar.ready") "1"))
      - progress: Reserve
        bind: self.avatar.energy.fraction
        overlay: self.avatar.energy.text
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "now"
          - text: ""
            bind: self.avatar.energy.line
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "budget"
            tooltip: (state-get "self.avatar.policy.budget_tip")
          - text: ""
            bind: self.avatar.policy.budget
            tooltip: (state-get "self.avatar.policy.budget_tip")
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "push"
            tooltip: (state-get "self.avatar.policy.push_tip")
          - text: ""
            bind: self.avatar.policy.push
            tooltip: (state-get "self.avatar.policy.push_tip")
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "power"
            tooltip: (state-get "self.avatar.policy.power_tip")
          - text: ""
            bind: self.avatar.policy.power
            tooltip: (state-get "self.avatar.policy.power_tip")
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "reserve"
            tooltip: (state-get "self.avatar.policy.reserve_tip")
          - text: ""
            bind: self.avatar.policy.reserve
            tooltip: (state-get "self.avatar.policy.reserve_tip")
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "carrying"
            tooltip: (state-get "self.avatar.policy.carrying_tip")
          - text: ""
            bind: self.avatar.policy.carrying
            tooltip: (state-get "self.avatar.policy.carrying_tip")
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "sustains"
            tooltip: (state-get "self.avatar.policy.sustains_tip")
          - text: ""
            bind: self.avatar.policy.sustains
            tooltip: (state-get "self.avatar.policy.sustains_tip")
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "when empty"
            tooltip: (state-get "self.avatar.policy.empty_tip")
          - text: ""
            bind: self.avatar.policy.empty
            tooltip: (state-get "self.avatar.policy.empty_tip")
      - separator
      - text: "Ledger: where your reserve went since you joined"
        color: [0.75, 0.85, 1.0]
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "started with"
          - text: ""
            bind: self.avatar.ledger.start
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "refilled"
            tooltip: "Resting power refills the reserve, all the time."
          - text: ""
            bind: self.avatar.ledger.refilled
            tooltip: "Resting power refills the reserve, all the time."
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "work"
            tooltip: "Speeding up and pushing."
          - text: ""
            bind: self.avatar.ledger.work
            tooltip: "Speeding up and pushing."
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "carried"
            tooltip: "Carrying your weight along."
          - text: ""
            bind: self.avatar.ledger.carried
            tooltip: "Carrying your weight along."
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "overflow"
            tooltip: "Refill lost to a reserve that was already full."
          - text: ""
            bind: self.avatar.ledger.overflow
            tooltip: "Refill lost to a reserve that was already full."
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "unpaid"
            tooltip: "Stopping on an empty reserve, which it could not pay for."
          - text: ""
            bind: self.avatar.ledger.unpaid
            tooltip: "Stopping on an empty reserve, which it could not pay for."
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "corrections"
            tooltip: "The relay's count over yours."
          - text: ""
            bind: self.avatar.ledger.corrections
            tooltip: "The relay's count over yours."
      - type: group
        layout: { kind: grid, col_widths: [104, 300] }
        children:
          - text: "now"
            tooltip: (state-get "self.avatar.ledger.balance")
          - text: ""
            bind: self.avatar.ledger.now
            tooltip: (state-get "self.avatar.ledger.balance")
      - progress: Work
        bind: self.avatar.ledger.share.work
      - progress: Carried
        bind: self.avatar.ledger.share.carried
      - progress: Overflow
        bind: self.avatar.ledger.share.overflow
      - text: ""
        bind: self.avatar.ledger.summary
      - separator
      - plot: Reserve kJ
        bind: self.avatar.history.reserve
        height: 70
        overlay: self.avatar.history.window
      - plot: Power W
        bind: self.avatar.history.power
        height: 70

  # ── Users: everyone in the room, a row each (components/room_users.ari) ──
  # Per row: the video dot, the name (click: their camera window; green while talking), their link
  # as they measure it, LOCAL cam / mic / volume (what YOU see and hear of them, never sent), and a
  # message button that opens a conversation in the Chat window. room-users-step fills the rows.
  - include: room_users
    args: { id: users, title: Users, rows: peer, chat: chat, self: conf.self }
    pos: [390, 40]
    size: [570, 260]

  # ── Chat: the room's chat and direct messages (components/chat.ari) ──
  # The relay keeps the history and pushes each client what it may read: the room's messages to
  # everyone in the room, a direct message to its two participants only. Scrolled to the top, the
  # log asks for older messages a page at a time. chat-ui-step keeps it current. 320 tall, so its
  # message field is still on screen in cyprty in a 1600x900 browser window.
  - include: chat
    args: { id: chat, title: Chat, room: room.token }
    pos: [390, 310]
    size: [570, 320]

  # ── One camera window per OTHER participant, titled by their name ──
  - window: Peer
    id: cam_{i}
    bind: peer.{i}.name
    repeat: (state-get "peer.count")
    pos: [612, 66]
    size: [330, 290]
    closable: true
    children:
      # Their camera, or "camera off" while they have it off (they send no frames then).
      - type: stream_view
        bind: peer.{i}.cam
        size: [300, 225]
        visible_when: (not (= (state-get "peer.{i}.video_off") "1"))
      - text: "camera off"
        visible_when: (= (state-get "peer.{i}.video_off") "1")

on_tick: |
  (begin
    ; ── join + open my mic (first, so audio needs no camera) then my camera, ONCE ──
    (if (= (state-get "joined") "1") #f
      (begin
        (state-set "joined" "1")
        (state-set "name_error" "") ; no name conflict yet (the web client's launch name is random)
        ; the avatar pickers start blank; on_tick fills them once the relay's catalog is here
        ; (an unset key reads as nil, which compares unequal to "")
        (state-set "avatar.color" "")
        (state-set "avatar.accessory" "")
        (state-set "avatar.sent.color" "")
        (state-set "avatar.sent.accessory" "")
        (state-set "avatar.colors" "")
        (state-set "avatar.accessories" "")
        ; ── pre-seed each peer camera window at a distinct TILED position ──
        ; every cam_<i> declares the SAME authored pos:, so without this the per-peer windows land
        ; exactly on top of one another and look like a single window — the #1 reason a user reports
        ; "I can't see the other cameras". Tile them in a 2-column grid to the RIGHT of the Users and
        ; Chat windows (x≈390–960): those are NEVER covered, and up to four cameras show
        ; side-by-side without overlapping on a laptop screen. Seeded ONCE here, before any peer window
        ; exists, so each window's first-use geometry seed lands at its own spot; the user's drag then
        ; persists and wins. Covers 6 peers; a 7th+ falls back to the authored pos.
        (state-set "tree.cam_0.geometry" "966,66,330,290")
        (state-set "tree.cam_1.geometry" "1306,66,330,290")
        (state-set "tree.cam_2.geometry" "966,364,330,290")
        (state-set "tree.cam_3.geometry" "1306,364,330,290")
        (state-set "tree.cam_4.geometry" "966,662,330,290")
        (state-set "tree.cam_5.geometry" "1306,662,330,290")
        (state-set "cam_on" "1") ; on/off toggles start ON (streams open unmuted)
        (state-set "mic_on" "1")
        (state-set "room.token"
          (get-attr (room-join "" (state-get "conf.room") (dict "name" (state-get "conf.self"))) "token"))
        (state-set "joined.name" (state-get "conf.self")) ; remember it for name-change detection
        (set mic (stream-open (dict "id" "mic" "codec" "f32" "rate" 48000 "ch" 1 "frames_per_chunk" 1024
                                    "subscriber_depth" 8 "expected_subscribers" 2)))
        (state-set "mic_token" (get-attr mic "token"))
        (if (= (state-get "cam_synthetic") "1")
            (stream-capture-audio (get-attr mic "token")
              (dict "rate" 48000 "ch" 1 "frames" 1024 "tone" (dict "hz" 440)))
            (begin
              (stream-capture-audio (get-attr mic "token")
                (dict "device" 0 "rate" 48000 "ch" 1 "frames" 1024))
              (state-set "mic.cur_device" "0")))
        ; The camera at the size it is shown (peer tiles are ~300 px wide): 320x240 MJPEG at q60 and
        ; 15 fps is ~0.6 Mbit/s per receiver, where 640x480 at q70 and 30 fps was ~5. 320x240 is a
        ; budget, not a shape: a camera keeps its own aspect within it, turned with it (a portrait
        ; phone sends 240x320, or 180x320 at 9:16), and the tiles letterbox whatever arrives.
        (set cam (stream-open (dict "id" "camera" "codec" "mjpeg" "w" 320 "h" 240 "stride" 1280
                                    "expected_subscribers" 3)))
        (state-set "cam_token" (get-attr cam "token"))
        (if (= (state-get "cam_synthetic") "1")
            (stream-capture-camera (get-attr cam "token")
              (dict "synthetic" #t "w" 320 "h" 240 "hz" 15 "jpeg" #t "quality" 60))
            (begin
              (stream-capture-camera (get-attr cam "token")
                (dict "device" 0 "w" 320 "h" 240 "hz" 15 "jpeg" #t "quality" 60))
              (state-set "cam.cur_device" "0")))))
    ; ── name change: the user edited their display name (conf.self). Refuse a name another participant
    ;    already uses — set name_error and keep the old presence — else clear the error and re-assert.
    ;    (Best-effort against the replicated roster: a genuine simultaneous tie is resolved server-side
    ;    in a later phase; this catches the ordinary "that name is already here" case.) ──
    (if (and (= (state-get "joined") "1")
             (not (= (state-get "conf.self") (state-get "joined.name"))))
      (begin
        (set want (state-get "conf.self"))
        (set taken #f)
        (for p (room-roster (state-get "conf.room"))
          (if (and (not (= (get-attr p "pid") (state-get "self.pid")))
                   (= (get-attr p "name") want))
              (set taken #t)
              #f))
        (if taken
            (state-set "name_error" (str-concat "name '" want "' is taken; pick another"))
            (begin
              (state-set "name_error" "")
              (state-set "room.token"
                (get-attr (room-join "" (state-get "conf.room") (dict "name" want)) "token"))
              (state-set "joined.name" want))))
      (state-set "name_error" "")) ; back at the current name: clear any stale error
    ; ── device switch: re-capture when the user picks a different camera / mic (real devices only) ──
    (if (= (state-get "cam_synthetic") "1") #f
      (begin
        (if (and (not (= (state-get "cam.want_device") ""))
                 (not (= (state-get "cam.want_device") (state-get "cam.cur_device"))))
            (begin
              (stream-capture-camera (state-get "cam_token")
                (dict "device" (int (state-get "cam.want_device")) "w" 320 "h" 240 "hz" 15 "jpeg" #t "quality" 60))
              (state-set "cam.cur_device" (state-get "cam.want_device")))
            #f)
        (if (and (not (= (state-get "mic.want_device") ""))
                 (not (= (state-get "mic.want_device") (state-get "mic.cur_device"))))
            (begin
              (stream-capture-audio (state-get "mic_token")
                (dict "device" (int (state-get "mic.want_device")) "rate" 48000 "ch" 1 "frames" 1024))
              (state-set "mic.cur_device" (state-get "mic.want_device")))
            #f)))
    ; ── my avatar: once the relay's catalog has arrived, show the current look in the pickers (the
    ;    defaults until you choose); after that, write a changed pick. room-set-avatar checks it
    ;    against the catalog and writes only your own choice; every client draws it from there. ──
    (if (= (state-get "joined") "1")
      (begin
        ; write a list only when it changes: an options list rewritten every tick is re-read
        ; every frame, and a picker that drops out for a frame closes its open popup
        (set colors (string.join (room-avatar-options (state-get "conf.room") "color") "\n"))
        (if (= colors (state-get "avatar.colors")) #f (state-set "avatar.colors" colors))
        (set wear (string.join (room-avatar-options (state-get "conf.room") "accessory") "\n"))
        (if (= wear (state-get "avatar.accessories")) #f (state-set "avatar.accessories" wear))
        (set look (room-avatar (state-get "room.token")))
        (if (= (state-get "avatar.sent.color") "")
          (if (= (get-attr look "color") "") #f
            (begin
              (state-set "avatar.color" (get-attr look "color"))
              (state-set "avatar.accessory" (get-attr look "accessory"))
              (state-set "avatar.sent.color" (get-attr look "color"))
              (state-set "avatar.sent.accessory" (get-attr look "accessory"))))
          (if (or (not (= (state-get "avatar.color") (state-get "avatar.sent.color")))
                  (not (= (state-get "avatar.accessory") (state-get "avatar.sent.accessory"))))
            (begin
              (room-set-avatar (state-get "room.token")
                               (state-get "avatar.color") (state-get "avatar.accessory"))
              (state-set "avatar.sent.color" (state-get "avatar.color"))
              (state-set "avatar.sent.accessory" (state-get "avatar.accessory")))
            #f)))
      #f)
    ; ── the Users rows (components/room_users.ari) and the Chat window (components/chat.ari) ──
    (room-users-step "peer" (state-get "conf.room") "chat")
    (chat-ui-step "chat" (state-get "room.token")))
