# conference_roster.ari — the BROWSER (wasm) conference client.
#
# Layout (all windows are closable + openable from the View menu):
#   • My Camera  (id mycam)   — your own camera, a camera + mic device picker, and camera/mic toggles.
#   • Users      (id users)   — everyone in the room: name (lights up GREEN while talking), per-peer
#                               LOCAL camera/mic mute + a volume slider, and click a name to raise
#                               that peer's camera window. These controls are LOCAL — they change only
#                               what THIS client sees/hears, never the other person's capture.
#   • cam_<i>    (per peer)    — one window per OTHER participant, titled by their name, showing their
#                               camera. Repeated over peer.count; opened automatically, closable.
#
# The host (arigl ConferenceSession) drives the media: it forwards our camera+mic, mixes every peer's
# audio into one output (per-peer volume + mute from the Users window), measures voice activity
# (media.<pid>.talking), and publishes the camera/mic device lists (cam.devices / mic.devices) + maps
# a picked device name to cam.want_device / mic.want_device for the re-capture below.
#
# conf.room / conf.self / self.pid / cam_synthetic are set by the host before this loads.

meta:
  name: Ariadne conference
  author: cvc
  min_libcvc: 3.6.0

# The room's LOOK. The relay owns what is IN the room (conf.rooms.<room>.scene: the ground, the
# reference box; the avatars), and every client draws it under this document's lighting, so the
# rig lives here, not in the server. A three-point rig staged over the 20 m floor: the key spot casts
# real-time shadows from the scene objects and every avatar (re-baked each frame, so a walking
# avatar's shadow walks with it); fill, back and environment keep the shaded sides readable.
scene:
  lights:
    - light: room_rig
      rig: three_point
      stage: { center: [0, 0, 1], radius: 10 }
      key: { intensity: 0.9, azimuth: -35, elevation: 55, cone: 48 }
      fill: 0.25
      back: 0.25
      warmth: 0.25
      environment: 0.15
      ambient: 0.12
  shadows:
    enabled: true
    resolution: 2048
    update_interval: 1

menubar:
  - menu: Room
    items:
      - menu_item: Quit
        on: quit
  - menu: View
    items:
      - menu_item: My Camera
        bind: tree.mycam.open
      - menu_item: Users
        bind: tree.users.open

windows:
  # ── My Camera: your name, self-view, device pickers + on/off toggles ──
  - window: My Camera
    id: mycam
    pos: [20, 40]
    size: [360, 560]
    closable: true
    children:
      # Your display name — the web client launches you in under a random "guest-xxxx"; edit this to
      # change it. On commit, on_tick checks the name is free and re-asserts your room presence so peers
      # see the new name (your internal id stays fixed, only the shown name changes). If another
      # participant already uses that name, on_tick refuses it and shows the error below instead.
      - type: input_text
        label: "Name"
        bind: conf.self
      # Name-taken error (red). on_tick sets name_error when the typed name is already in the room; the
      # field keeps what you typed, but your presence keeps its previous name until you pick a free one.
      - text: ""
        bind: name_error
        color: [1.0, 0.4, 0.4]
        visible_when: (not (= (state-get "name_error") ""))
      - separator
      - type: stream_view
        bind: cam_token
        size: 320
      - separator
      # Device pickers (real-device builds only; empty + hidden under ?synthetic=1). Picking a device
      # updates cam.sel / mic.sel; the host maps it to cam.want_device / mic.want_device and on_tick
      # re-captures. options come from the host-published, newline-joined device lists.
      - type: combo
        label: "Camera"
        bind: cam.sel
        options: (string.split (state-get "cam.devices") "\n")
        visible_when: (not (= (state-get "cam_synthetic") "1"))
      - type: combo
        label: "Mic"
        bind: mic.sel
        options: (string.split (state-get "mic.devices") "\n")
        visible_when: (not (= (state-get "cam_synthetic") "1"))
      - separator
      # Camera/mic on-off: stream-set-muted blanks the producer at the source (black video / silence)
      # WITHOUT dropping the publish, so peers stay subscribed and the cadence holds.
      - type: button
        label: "camera on/off"
        on: (begin (state-set "cam_on" (if (= (state-get "cam_on") "1") "0" "1")) (stream-set-muted (state-get "cam_token") (= (state-get "cam_on") "0")))
      - text: "camera"
        bind: (if (= (state-get "cam_on") "1") "● on" "muted")
      - type: button
        label: "mic on/off"
        on: (begin (state-set "mic_on" (if (= (state-get "mic_on") "1") "0" "1")) (stream-set-muted (state-get "mic_token") (= (state-get "mic_on") "0")))
      - text: "mic"
        bind: (if (= (state-get "mic_on") "1") "● on" "muted")

  # ── Users: the roster with per-peer local controls ──
  # One compact ROW per participant, as a table of unit widgets: every row is its own grid with the
  # SAME fixed column widths, so the rows line up as columns. ping / down / up are each person's
  # link to the relay AS THEY MEASURE IT (published to the room once a second; "--" = not measured
  # yet). cam / mic / vol are LOCAL controls (what YOU see and hear of them), never sent.
  # Every column has a FIXED width, the window wide enough for all of them: an auto-width column is
  # re-fitted to its content each frame, and a slider sized from its column then chased its own
  # width (it could not be dragged).
  - window: Users
    id: users
    pos: [390, 40]
    size: [470, 260]
    closable: true
    children:
      - text: "in the room"
        bind: self.count
      - separator
      - type: group
        id: users_head
        layout: { kind: grid, col_widths: [110, 52, 52, 52, 30, 30, 72] }
        children:
          - text: "name"
          - text: "ping"
          - text: "down"
          - text: "up"
          - text: "cam"
          - text: "mic"
          - text: "vol"
      # You: your name lights up GREEN while YOU talk (text colour is static, so it is a visibility
      # swap: only one of the two is visible). The two are one group, so they always fill exactly
      # one cell, even on a frame where neither check runs.
      - type: group
        id: users_you
        layout: { kind: grid, col_widths: [110, 52, 52, 52, 30, 30, 72] }
        children:
          - type: group
            children:
              - text: ""
                bind: conf.self
                visible_when: (not (= (state-get "self.talking") "1"))
              - text: ""
                bind: conf.self
                color: [0.30, 1.0, 0.40]
                visible_when: (= (state-get "self.talking") "1")
          - text: ""
            bind: self.ping
          - text: ""
            bind: self.down
          - text: ""
            bind: self.up
          - text: ""
          - text: ""
          - text: "(you)"
      # Everyone else: one row per peer (peer.<i>), filled by on_tick.
      - type: group
        repeat: (state-get "peer.count")
        layout: { kind: grid, col_widths: [110, 52, 52, 52, 30, 30, 72] }
        children:
          # Name: click to open + raise this peer's camera window (cam_<i>); GREEN while talking. One
          # group, so it is always one cell (see the you row).
          - type: group
            children:
              - text: ""
                bind: peer.{i}.name
                on_click: (begin (state-set "tree.cam_{i}.open" "1") (state-set "tree.cam_{i}.raise" "1"))
                visible_when: (not (= (state-get "peer.{i}.talking") "1"))
              - text: ""
                bind: peer.{i}.name
                color: [0.30, 1.0, 0.40]
                on_click: (begin (state-set "tree.cam_{i}.open" "1") (state-set "tree.cam_{i}.raise" "1"))
                visible_when: (= (state-get "peer.{i}.talking") "1")
          - text: ""
            bind: peer.{i}.ping
          - text: ""
            bind: peer.{i}.down
          - text: ""
            bind: peer.{i}.up
          # Local mute toggles (checked = on). Default on: the host treats von/aon as muted only when
          # explicitly "0", so an untouched peer is shown + heard. "##" hides the label (the header
          # names the column). These and vol belong to the PERSON: on_tick moves them with the pid
          # when rows shift.
          - type: checkbox
            label: "##cam"
            bind: peer.{i}.von
            def: true
          - type: checkbox
            label: "##mic"
            bind: peer.{i}.aon
            def: true
          # Local volume in our mix (1 = unity, up to 2x boost).
          - type: slider_float
            label: "##vol"
            bind: peer.{i}.vol
            lo: 0
            hi: 2
            def: 1

  # ── One camera window per OTHER participant, titled by their name ──
  - window: Peer
    id: cam_{i}
    bind: peer.{i}.name
    repeat: (state-get "peer.count")
    pos: [612, 66]
    size: [330, 290]
    closable: true
    children:
      - type: stream_view
        bind: peer.{i}.cam
        size: 300

on_tick: |
  (begin
    ; ── join + open my mic (first, so audio needs no camera) then my camera, ONCE ──
    (if (= (state-get "joined") "1") #f
      (begin
        (state-set "joined" "1")
        (state-set "name_error" "") ; no name conflict yet (the web client's launch name is random)
        ; ── pre-seed each peer camera window at a distinct TILED position ──
        ; every cam_<i> declares the SAME authored pos:, so without this the per-peer windows land
        ; exactly on top of one another and look like a single window — the #1 reason a user reports
        ; "I can't see the other cameras". Tile them in a 2-column grid to the RIGHT of the Users
        ; window (which sits at x≈390–860): the roster is NEVER covered, and up to four cameras show
        ; side-by-side without overlapping on a laptop screen. Seeded ONCE here, before any peer window
        ; exists, so each window's first-use geometry seed lands at its own spot; the user's drag then
        ; persists and wins. Covers 6 peers; a 7th+ falls back to the authored pos.
        (state-set "tree.cam_0.geometry" "866,66,330,290")
        (state-set "tree.cam_1.geometry" "1206,66,330,290")
        (state-set "tree.cam_2.geometry" "866,364,330,290")
        (state-set "tree.cam_3.geometry" "1206,364,330,290")
        (state-set "tree.cam_4.geometry" "866,662,330,290")
        (state-set "tree.cam_5.geometry" "1206,662,330,290")
        (state-set "cam_on" "1") ; on/off toggles start ON (streams open unmuted)
        (state-set "mic_on" "1")
        (room-join "" (state-get "conf.room") (dict "name" (state-get "conf.self")))
        (state-set "joined.name" (state-get "conf.self")) ; remember it for name-change detection
        (set mic (stream-open (dict "id" "mic" "codec" "f32" "rate" 48000 "ch" 1 "frames_per_chunk" 1024
                                    "subscriber_depth" 8 "expected_subscribers" 2)))
        (state-set "mic_token" (get-attr mic "token"))
        (if (= (state-get "cam_synthetic") "1")
            (stream-capture-audio (get-attr mic "token")
              (dict "rate" 48000 "ch" 1 "frames" 1024 "tone" (dict "hz" 440)))
            (begin
              (stream-capture-audio (get-attr mic "token")
                (dict "device" 0 "rate" 48000 "ch" 1 "frames" 1024))
              (state-set "mic.cur_device" "0")))
        ; The camera at the size it is shown (peer tiles are ~300 px wide): 320x240 MJPEG at q60 and
        ; 15 fps is ~0.6 Mbit/s per receiver, where 640x480 at q70 and 30 fps was ~5.
        (set cam (stream-open (dict "id" "camera" "codec" "mjpeg" "w" 320 "h" 240 "stride" 1280
                                    "expected_subscribers" 3)))
        (state-set "cam_token" (get-attr cam "token"))
        (if (= (state-get "cam_synthetic") "1")
            (stream-capture-camera (get-attr cam "token")
              (dict "synthetic" #t "w" 320 "h" 240 "hz" 15 "jpeg" #t "quality" 60))
            (begin
              (stream-capture-camera (get-attr cam "token")
                (dict "device" 0 "w" 320 "h" 240 "hz" 15 "jpeg" #t "quality" 60))
              (state-set "cam.cur_device" "0")))))
    ; ── name change: the user edited their display name (conf.self). Refuse a name another participant
    ;    already uses — set name_error and keep the old presence — else clear the error and re-assert.
    ;    (Best-effort against the replicated roster: a genuine simultaneous tie is resolved server-side
    ;    in a later phase; this catches the ordinary "that name is already here" case.) ──
    (if (and (= (state-get "joined") "1")
             (not (= (state-get "conf.self") (state-get "joined.name"))))
      (begin
        (set want (state-get "conf.self"))
        (set taken #f)
        (for p (room-roster (state-get "conf.room"))
          (if (and (not (= (get-attr p "pid") (state-get "self.pid")))
                   (= (get-attr p "name") want))
              (set taken #t)
              #f))
        (if taken
            (state-set "name_error" (str-concat "name '" want "' is taken — pick another"))
            (begin
              (state-set "name_error" "")
              (room-join "" (state-get "conf.room") (dict "name" want))
              (state-set "joined.name" want))))
      (state-set "name_error" "")) ; back at the current name: clear any stale error
    ; ── device switch: re-capture when the user picks a different camera / mic (real devices only) ──
    (if (= (state-get "cam_synthetic") "1") #f
      (begin
        (if (and (not (= (state-get "cam.want_device") ""))
                 (not (= (state-get "cam.want_device") (state-get "cam.cur_device"))))
            (begin
              (stream-capture-camera (state-get "cam_token")
                (dict "device" (int (state-get "cam.want_device")) "w" 320 "h" 240 "hz" 15 "jpeg" #t "quality" 60))
              (state-set "cam.cur_device" (state-get "cam.want_device")))
            #f)
        (if (and (not (= (state-get "mic.want_device") ""))
                 (not (= (state-get "mic.want_device") (state-get "mic.cur_device"))))
            (begin
              (stream-capture-audio (state-get "mic_token")
                (dict "device" (int (state-get "mic.want_device")) "rate" 48000 "ch" 1 "frames" 1024))
              (state-set "mic.cur_device" (state-get "mic.want_device")))
            #f)))
    ; ── mirror self voice-activity for the (you) row ──
    (state-set "self.talking" (state-get (str-concat "media." (state-get "self.pid") ".talking")))
    ; ── per-peer controls follow the PERSON, not the row: rows are sorted by pid, so they shift when
    ;    someone joins or leaves. Park each row's cam/mic/vol under its pid (ctl.<pid>.*) before the
    ;    rebuild; the rebuild gives each row its own pid's back ("" lets the widget seed its default) ──
    (for i (range (if (= (state-get "peer.count") "") 0 (int (state-get "peer.count"))))
      (begin
        (set opid (state-get (str-concat "peer." i ".pid")))
        (if (= opid "") #f
          (begin
            (state-set (str-concat "ctl." opid ".vol") (state-get (str-concat "peer." i ".vol")))
            (state-set (str-concat "ctl." opid ".von") (state-get (str-concat "peer." i ".von")))
            (state-set (str-concat "ctl." opid ".aon") (state-get (str-concat "peer." i ".aon")))))))
    ; ── rebuild the OTHER-participant slots each tick (self excluded: it has My Camera + the you row) ──
    (set idx 0)
    (set total 1)
    (for p (room-roster (state-get "conf.room"))
      (begin
        (set pid (get-attr p "pid"))
        (if (= pid (state-get "self.pid")) #f
          (begin
            (state-set (str-concat "peer." idx ".pid") pid)
            (state-set (str-concat "peer." idx ".vol") (state-get (str-concat "ctl." pid ".vol")))
            (state-set (str-concat "peer." idx ".von") (state-get (str-concat "ctl." pid ".von")))
            (state-set (str-concat "peer." idx ".aon") (state-get (str-concat "ctl." pid ".aon")))
            (state-set (str-concat "peer." idx ".name") (get-attr p "name"))
            (state-set (str-concat "peer." idx ".cam")
              (state-get (str-concat "media." pid ".camera")))
            (state-set (str-concat "peer." idx ".talking")
              (state-get (str-concat "media." pid ".talking")))
            ; their link quality, as THEY measure it (ping to the relay, bits/s down + up)
            (state-set (str-concat "peer." idx ".ping") (get-attr p "ping"))
            (state-set (str-concat "peer." idx ".down") (get-attr p "down"))
            (state-set (str-concat "peer." idx ".up") (get-attr p "up"))
            (set idx (+ idx 1))
            (set total (+ total 1))))))
    (state-set "peer.count" (str idx))
    (state-set "self.count" (str total)))
