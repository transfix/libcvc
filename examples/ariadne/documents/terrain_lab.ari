# terrain_lab.ari — the cvcGL terrain_lab demo as an Ariadne document, and the template for a
# generated world on libcvc's fastest render path.
#
# The world is one `generated_world` node (cvcGL, cvc::world::generate_world): the relief and the
# L-system prop scatter of cvc::world, the roads-first city (district cores, a graded street
# network grown from them, lots along it holding the Austin building archetypes or procedural
# buildings) and the water below water_level, drawn as a handful of merged meshes: the terrain with
# its baked surface texture, the
# props, the buildings, the roads, the foliage and the needles, plus the water volume. Its
# world_controls panel regenerates it live; nothing here is host C++.
#
# The look and the render discipline are demo3-csma's (CVC-DBG's Austin convoy demo, our fastest
# cvcGL scene), all declared below:
#   - one merged mesh per layer, so the city is a few draw calls whatever its size;
#   - the ground receives shadows but casts none (`casts_shadow: false`): as a caster the terrain
#     shadows itself everywhere and forces every re-bake;
#   - the ground's texture is drawn opaque (`material: { opaque: true }`): no per-texel alpha scan;
#   - the sun's shadow map follows what the camera looks at (`shadows: { focus: camera }`), so a
#     4096 map is ~0.2 m a texel close in and still covers an overview;
#   - a key + fill rig with no back light or wash (each extra spot is another shadow-map sampler);
#   - the soft afternoon look: a low warm sun in the west-southwest, a cool fill, matte materials and
#     a pale daylight sky.
# Copy it for another world: keep the scene: block, change the generated_world props.
#
# Run (arigl from the build tree finds the component library itself):
#   arigl terrain_lab.ari
#   arigl terrain_lab.ari --offscreen --frames 30 --png terrain_lab.png
# The Austin archetypes come from the node's building_library, else $CVC_NAV_BUNDLE (a buildings.glb
# or the directory holding one, e.g. the cvcpkg scene-austin-south package's austin_south/).

meta:
  name: Terrain Lab (Ariadne)
  author: cvc
  min_libcvc: 3.7.8

requires:
  - gl.scene                       # a scene renderer realizes the scene: block (arigl; not ari)
  - {name: gl.scene.shaders, optional: true}   # the ground bump preset; unshaded without

customs:
  - node: generated_world
    required: true

import:
  - cvc://components/world_controls.ari
  - cvc://components/stage_lighting.ari
  - cvc://components/viewer_settings.ari     # frame rate, UI size, grid / axis, camera, shadows
  - cvc://components/sim_transport.ari
  - cvc://components/sky_controls.ari

# Only the Terrain Lab panel opens at first, so the world fills the view; Settings opens the rest.
init: |
  (state-set "tree.stage_lighting.open" "0")
  (state-set "tree.viewer_settings.open" "0")
  (state-set "tree.sim_transport.open" "0")
  (state-set "tree.sky_controls.open" "0")

menubar:
  - menu: Sim
    items:
      - menu_item: Quit
        on: quit
  - menu: Settings
    items:
      - menu_item: Terrain Lab
        bind: tree.world_controls.open
      - separator
      - menu_item: Stage lighting
        bind: tree.stage_lighting.open
      - menu_item: Viewer
        bind: tree.viewer_settings.open
      - menu_item: Simulation
        bind: tree.sim_transport.open
      - menu_item: Sky
        bind: tree.sky_controls.open

windows:
  - include: world_controls
    pos: [16, 16]
    size: [340, 560]
    closable: true
  - include: stage_lighting
    pos: [370, 16]
    size: [370, 210]
    closable: true
  - include: viewer_settings
    pos: [370, 234]
    size: [370, 440]
    closable: true
  - include: sim_transport   # Paused / Speed: the water and the clouds run on the clock below
    pos: [370, 682]
    size: [370, 150]
    closable: true
  - include: sky_controls
    pos: [754, 16]
    size: [370, 116]
    closable: true

scene:
  chrome: false
  clock: { scale: 1.0, paused: false }
  # A daylight sky: pale and hazy at the horizon, bluer overhead.
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 4
    # Spend the map on what the camera looks at: 150 m behind a close camera, up to 900 m over the
    # whole world; centred half a radius ahead of the focal point, 20 m over the ground there.
    focus: { follow: camera, min_radius: 150, max_radius: 900, per_distance: 3, lead: 0.5,
             lift: 20, ground: world }
  lights:
    # The afternoon sun: low in the west-southwest and warm, the key and the one shadow caster; a
    # cool fill keeps the shade from going black; no back light or wash. The fill, the environment
    # and the ambient are kept low so the sun carries the light: building and cloud shadows read.
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 25], radius: 850 }
      key: { intensity: 1.3, azimuth: -60, elevation: 28, cone: 62 }
      fill: 0.15
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.2
      ambient: 0.2
  nodes:
    # The world. Every key below seeds a world.* state key the Terrain Lab panel drives.
    - node: world
      type: generated_world
      seed: 5
      half: 600            # metres: the world spans 1.2 km
      preset: standard     # standard | forest | urban | sparse | island (counts and relief)
      terrain: fbm         # fbm (the analytic relief) | dem (terrain_file: an elevation .npy)
      city: districts      # districts (roads first, from the district cores) | none
      trees: 500
      rocks: 90
      buildings: 110       # the most buildings, filled from the district cores out
      tree_gen: 5
      amp: 90              # relief, metres
      water_level: 34      # metres; everything below is water
      color: material      # material | risk | occupancy | height
      look: soft           # soft (demo3's matte daylight) | classic (the C++ lab's)
      casts_shadow: false
      material: { opaque: true }
      shader: { preset: terrain_bump }   # value-noise fBm ground detail
    # The clouds: a deck of L-system cumulus scattered over the whole world, drifting and slowly
    # changing shape. The ones near the camera are volumes, the rest far shells to the horizon.
    # Their shade dims the sun on the ground, the buildings, the roads and the trees; it is drawn
    # in the receivers' shaders, so the world's own texture is untouched.
    - node: sky
      type: cloud_sky
      ground: world        # the deck covers this node's extent, live, and shades its meshes
      receivers: [world_buildings, world_roads, world_props, world_foliage]
      extent: 250          # a cloud's half-width, metres: small fair-weather cumulus
      base: 300
      top: 520
      coverage: 0.6        # the share of the sky's cells holding a cloud
      near: 6              # the clouds nearest the camera drawn as volumes; the rest far shells
      sun_az: -60          # the key light's: the clouds cast along it
      sun_el: 28
