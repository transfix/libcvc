# scene_views.ari — views of one scene in windows (docs/ARIADNE.md §5.18, roadmap §9.5).
#
# A block of buildings, a few agents tagged sim, and their goal markers tagged debug. The main view
# draws all of it. The Overview window is a top-down map of the buildings and the agents (show:
# [sim], no grid). The Layers window's view shows the tags its menu picks, through a bound state
# key, from its own orbiting camera. Drag in a view to turn its camera; the wheel zooms it.
#
#   arigl scene_views.ari
#   arigl snapshot --frames 4 --png views.png scene_views.ari

meta:
  name: Scene views (Ariadne)
  author: cvc
  min_libcvc: 3.7.0

requires:
  - gl.scene                       # a scene renderer realizes the scene: block (arigl; not ari)

init: |
  (state-set "views.layers" "sim debug")

windows:
  - window: Overview
    id: overview
    pos: [16, 16]
    size: [300, 290]
    children:
      - type: viewport
        view: overview
        show: [sim]
        mode: map
        chrome: false
        shadows: false            # what it leaves out still casts in the shared maps
        clear_color: [0.05, 0.06, 0.08]
        width: 280
        height: 240
  - window: Layers
    id: layers
    pos: [16, 320]
    size: [300, 330]
    children:
      - combo: Show
        bind: views.layers
        options: ["sim", "debug", "sim debug"]
        default: "sim debug"
      - type: viewport
        view: layers
        bind: views.layers
        width: 280
        height: 240

scene:
  background: { top: [0.20, 0.24, 0.30], bottom: [0.05, 0.05, 0.07] }
  nodes:
    - node: ground
      type: geometry
      source: { plane: { size: 40 } }
      material: { color: [0.30, 0.32, 0.30] }
    - node: tower
      type: geometry
      source: { box: { size: [4, 4, 10] } }
      transform: { position: [-6, 4, 5] }
      material: { color: [0.70, 0.66, 0.60] }
    - node: hall
      type: geometry
      source: { box: { size: [8, 5, 4] } }
      transform: { position: [6, -5, 2] }
      material: { color: [0.62, 0.58, 0.52] }
    - node: agents
      type: group
      tags: [sim]
      children:
        - node: a1
          type: geometry
          source: { sphere: 0.8 }
          transform: { position: [-2, -6, 0.8] }
          material: { color: [0.95, 0.35, 0.20] }
        - node: a2
          type: geometry
          source: { sphere: 0.8 }
          transform: { position: [3, 5, 0.8] }
          material: { color: [0.95, 0.35, 0.20] }
        - node: a3
          type: geometry
          source: { sphere: 0.8 }
          transform: { position: [10, 6, 0.8] }
          material: { color: [0.95, 0.35, 0.20] }
    - node: goals
      type: group
      tags: [debug]
      children:
        - node: g1
          type: geometry
          source: { box: { size: [0.6, 0.6, 3] } }
          transform: { position: [-12, -10, 1.5] }
          material: { color: [0.20, 0.85, 0.95] }
        - node: g2
          type: geometry
          source: { box: { size: [0.6, 0.6, 3] } }
          transform: { position: [12, 12, 1.5] }
          material: { color: [0.20, 0.85, 0.95] }
  shadows:                         # soft shadows, in the main view and in every viewport
    enabled: true
    resolution: 2048
    softness: 3
  lights:
    - light: sun
      kind: directional
      azimuth: 135
      elevation: 55
