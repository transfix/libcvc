# nav_compute.ari — Ariadne's cross-thread async story, end to end (roadmap item 2).
#
# Click "Run nav step". The button's `on:` starts with '(', so it is a state_exec
# PROGRAM that runs on the app-wide async lane (not a bare host-event name). It:
#   1. sets nav.status = "running" (visible immediately),
#   2. calls (nav-step), an async function the nav_compute host registers on the app's
#      async host (docs/STATE_EXEC_EXCEPTIONS.md 3). The action parks AT THE CALL while the
#      step runs on the app's background task pool and fans out over app.computePool(),
#      and the UI keeps rendering meanwhile,
#   3. resumes with the arrived count, the call's value, and writes it to nav.result,
#   4. sets nav.status = "done".
#
# A failed step raises at the call, like any error. The step's run time and CPU time count
# against the action's caps (ariadne.limits.action_max_steps and action_max_time; this step
# is far under them). A host whose documents run longer steps raises the caps: they are
# app-wide settings, outside the document's prefix.
# Run:  nav_compute nav_compute.ari

meta:
  name: Nav compute-pool async demo
  author: cvc
  min_libcvc: 3.4.0

init: |
  (begin
    (state-set "nav.status" "idle")
    (state-set "nav.result" "-"))

windows:
  - window: Async nav step
    id: nav_compute
    children:
      - text: "A nav step runs on app.computePool() off the render thread;"
      - text: "(nav-step) parks the action until it returns the result."
      - separator
      - button: Run nav step
        on: |
          (begin
            (state-set "nav.status" "running")
            (state-set "nav.result" (nav-step))
            (state-set "nav.status" "done"))
      - separator
      - text: "status"
        bind: nav.status
      - text: "arrived"
        bind: nav.result
