# terminal_tour.ari — a tour of the Ariadne terminal backend (FTXUI, roadmap §16.4).
#
#   ari run examples/ariadne/terminal/terminal_tour.ari
#   ari run examples/ariadne/terminal/terminal_tour.ari --agents 128 --name ada
#   ari run examples/ariadne/terminal/terminal_tour.ari --help
#   ari snapshot --width 100 --height 30 examples/ariadne/terminal/terminal_tour.ari
#
# ari's own flags go before the document; what follows it is the document's, checked against the
# args: block below (`--help` lists it).
#
# Keys: Tab / Shift-Tab (or Up / Down) move focus, Enter or Space activates, Left / Right step a
# slider or cycle a combo, F10 opens the menu bar, Esc closes a popup or reverts a text edit.
# Mouse: click to focus, drag a slider, drag a window by its title, click [x] to close one.
# Quit with File > Quit, or Ctrl-C twice (the on_signal: handler below asks first).
#
# Nothing here is terminal-specific: the same document renders through the ImGui backend
# (ariadne_hello terminal_tour.ari). Positions and sizes are authored in px; the terminal maps
# them to cells (8 x 16 px each by default).

meta:
  name: Ariadne terminal tour
  min_libcvc: 3.4.0

# The document's own command line. ari parses it into the read-only args.<name> before init: runs;
# the raw strings are in argv, (state-data-get "argv").
args:
  agents: {type: int, default: 64, help: How many agents to start with}
  name: {type: string, help: Greet this name at start-up}

init: |
  (state-set "tour.agents" (state-get "args.agents"))
  (if (state-exists "args.name")
      (state-set "tour.log" (str-concat "hello, " (state-get "args.name")))
      (state-set "tour.log" "ready"))

# on_signal: takes Ctrl-C (SIGINT) over from the host, the way a POSIX handler would: the first
# press only asks, the second calls (quit), a verb the ari runner provides. Without this block,
# Ctrl-C quits at once. (Three presses within two seconds always quit, handler or not.)
on_signal: |
  (if (= (state-get "tour.quit_armed") "1")
      (quit)
      (begin
        (state-set "tour.quit_armed" "1")
        (state-set "tour.log" "Ctrl-C again to quit")))

menubar:
  - menu: File
    items:
      - menu_item: Status window
        bind: tree.status.open
      - separator
      - menu_item: Quit
        on: quit
  - menu: View
    items:
      - menu_item: Wireframe
        bind: tour.wire
      - menu_item: Reset agents
        on: (state-set "tour.agents" "64")

windows:
  - window: Controls
    id: controls
    pos: [16, 32]
    size: [440, 304]
    children:
      - text: "Tab moves focus; Enter or Space activates."
      - separator
      - slider_int: Agents
        bind: tour.agents
        lo: 1
        hi: 512
        tooltip: "how many agents to simulate"
      - slider_float: Speed
        bind: tour.speed
        lo: 0.1
        hi: 4.0
        def: 1.0
        fmt: "%.2f"
      - checkbox: Wireframe
        bind: tour.wire
      - combo: Belief
        bind: tour.belief
        options: [shared, grouped, private]
        default: shared
      - input_text: Name
        bind: tour.name
        on: (state-set "tour.log" (str-concat "hello, " (state-get "tour.name")))
        tooltip: "type, then Enter"
      - color: Tint
        bind: tour.tint
        default: "0.80,0.55,0.35"
      - button: Reset
        on: (state-set "tour.agents" "64")

  - window: Status
    id: status
    pos: [480, 32]
    closable: true
    children:
      - text: "agents"
        bind: tour.agents
      - text: "belief"
        bind: tour.belief
      - text: "log"
        bind: tour.log
      - text: "heavy: over 256 agents"
        visible_when: (> (int (state-get "tour.agents")) 256)
      # A spinner turns by the host's frame clock, whatever the document's programs are doing.
      - spinner: simulating

  - window: Layout
    id: layout
    pos: [480, 192]
    layout:
      kind: grid
      col_widths: [96, auto]
      borders: { show: inner }
    children:
      - text: "speed"
      - text: "speed"
        bind: tour.speed
      - text: "wire"
      - text: "wire"
        bind: tour.wire
