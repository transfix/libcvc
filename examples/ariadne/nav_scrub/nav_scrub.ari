# nav_scrub.ari — watch a policy learn: every checkpoint of a training run deployed, checkpoint k
# beside step 0 (cvc::nav's scrubber, docs/NAV_SCRUB.md). nav_scrub.cpp trains (or reads a history),
# deploys the checkpoints on this document's world, and draws the two runs; cvc::nav::scrub_view
# writes every window.
#
#   nav_scrub nav_scrub.ari --component-path <repo>/src/cvc/ariadne --bundle <austin_south>
#   nav_scrub nav_scrub.ari --net-allow https://cvcpkg.org      # Austin from cvcpkg.org
#   nav_scrub nav_scrub.ari --world generated                   # or flat, or blocks
#
# The world is the scene's (ARIADNE_WORLDS.md section 14): one node per world, `world: <name>`, and
# the host puts the one it runs on (--world) and reads it back from the world runtime, its grid for
# the navigator and its geometry for the plant, in metres, at its real size:
# - city: south Austin, the data: block's bundle (its terrain wearing the aerial image, its
#   buildings), cut to a 320 m square round its centre for the physics and the navigator;
# - generated: a generated world (terrain, buildings, trees), for a host with no Austin;
# - flat: a flat walled square;
# - blocks (no node): the built-in 120 m square of nine buildings, which the host draws itself.
# The agents start 12 m apart on free ground, each to a goal across the world. Each run's vehicle
# is the Humvee model at its true size (the bundle's Humvee.glb, or the vehicle-humvee package's),
# checkpoint k's opaque in orange and step 0's translucent in blue, each with its trail behind it;
# a box where neither model is here.
#
# - Scrub: the plant (the Jolt Humvee, which stops against a building, or nav's kinematic bicycle,
#   which drives through one), the checkpoint (a combo, a slider, Previous and Next, or a click on
#   a chart), the deployed metric against the step with step 0's dashed, and the table, one row per
#   checkpoint.
# - Training: a curve from the training history (Curve picks it), with the pick marked.
# - Episode and Simulation: the two runs' time (libcvc's sim transport, a Position slider).
# - Stats and Ledger: step 0 (blue) and checkpoint k (orange) at the play head.

meta:
  name: nav lab — scrub
  min_libcvc: 3.7.13

import:
  - cvc://components/sim_transport.ari
  - cvc://components/nav_lab_scrub.ari
  - cvc://components/nav_lab_stats.ari
  - cvc://components/nav_lab_ledger.ari

requires:
  - gl.scene                        # a scene renderer realizes the scene: block (the world)
  - {name: chart, optional: true}   # the charts (libcvc 3.7.14); the tables show the numbers too
  - {name: net, optional: true}     # Austin from cvcpkg.org; without it a local bundle, or another world

customs:
  - node: generated_world
    required: true

data:
  city:
    uri: cvcpkg://cy-pca/scene-austin-south-small
    path: share/cvc-scenes/austin_south
    as: city_bundle

init: |
  (begin
    (state-set "sim.paused" "0")
    (state-set "sim.speed" "1.0")
    (state-set "play.pos" "0")
    (state-set "play.loop" "1")
    (state-set "view.camera" "orbit")
    (state-set "arms.on" "1")
    (state-set "arms.live" "0")
    (state-set "ledger.book" "dU")
    (state-set "ledger.vehicle" "0")
    (state-set "scrub.metric_name" "goal_m"))

windows:
  - include: nav_lab_scrub
    pos: [16, 30]
    size: [520, 560]
  - include: nav_lab_training
    pos: [548, 30]
    size: [480, 300]
  - include: nav_lab_episode
    pos: [548, 342]
    size: [480, 130]
  - include: sim_transport
    pos: [548, 484]
    size: [260, 170]
  - include: nav_lab_stats
    pos: [1040, 30]
    size: [600, 320]
  - include: nav_lab_ledger
    pos: [1040, 362]
    size: [600, 540]

scene:
  chrome: false
  background: { top: [0.66, 0.78, 0.92], bottom: [0.30, 0.42, 0.58] }
  world: { source: city, cell: 2 }
  lights:
    - light: sun
      rig: three_point
      sun: true
      stage: { center: [0, 0, 20], radius: 400 }
      key: { intensity: 1.2, azimuth: -42, elevation: 52, cone: 62 }
      fill: 0.5
      back: 0
      wash: 0
      ambient: 0.35
  nodes:
    - node: city
      world: city
      source: { data: city }
      tint: satellite
      region: [-160, -160, 160, 160]   # the physics' and the navigator's world; all of it drawn
      body: static
    - node: land
      world: generated
      type: generated_world
      seed: 5
      half: 160
      trees: 40
      rocks: 12
      buildings: 24
      body: {}
    - node: square
      world: flat
      source: { box: { size: [240, 240, 1] } }
      transform: { position: [0, 0, -0.5] }
      material: { color: [0.60, 0.63, 0.56] }
      body: static
