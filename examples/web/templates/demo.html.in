<!DOCTYPE html>
<!-- {{DEMO}} — cvcGL WebAssembly demo host page. GENERATED by build-pages.py from
     templates/demo.html.in; edit the template, not this copy. Served next to
     {{DEMO}}.js/.wasm in its own gallery subdir. VTK's wasm interactor binds events
     to the canvas by CSS selector "#canvas" (its default) — keep the id if you restyle. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>cvcGL — {{DEMO}} (WebAssembly)</title>
<script>
  // ?nofloatlinear: render as on a device without OES_texture_float_linear (iOS Safari), where a
  // 32-bit float texture sampled with LINEAR filtering reads as zero. Hidden from the page before
  // the demo creates its context, so the browser leaves it disabled, and a desktop shows what an
  // iPhone would (?gldiag reports the same). ?hideext=A,B hides any extensions by name the same
  // way (EXT_float_blend: no blending into 32-bit float render targets).
  {
    const q = new URLSearchParams(location.search), hide = new Set();
    if (q.has('nofloatlinear'))
      hide.add('OES_texture_float_linear');
    for (const n of (q.get('hideext') || '').split(',').map(s => s.trim()).filter(Boolean))
      hide.add(n);
    if (hide.size) {
      const P = WebGL2RenderingContext.prototype, ge = P.getExtension, gs = P.getSupportedExtensions;
      P.getExtension = function (n) {
        return hide.has(n) ? null : ge.call(this, n);
      };
      P.getSupportedExtensions = function () {
        return (gs.call(this) || []).filter(n => !hide.has(n));
      };
    }
  }
</script>
<style>
  :root { color-scheme: dark; }
  html, body { margin: 0; height: 100%; background: #10141a; color: #cdd6e0;
               font: 13px/1.5 system-ui, sans-serif; }
  /* 100dvh where supported: on a phone, 100% is the height with the browser's bars hidden, so the
     stage ran under the address bar. */
  body { display: flex; flex-direction: column; height: 100dvh; }
  header { padding: 8px 14px; display: flex; flex-wrap: wrap; gap: 4px 14px;
           align-items: baseline; border-bottom: 1px solid #232a33; flex: none; }
  header h1 { font-size: 14px; margin: 0; color: #e8eef4; font-weight: 600; }
  header a { color: #5aa9e6; text-decoration: none; }
  header select { margin-left: auto; max-width: 14em; background: #1d2530; color: #cdd6e0;
                  border: 1px solid #2c3542; border-radius: 6px; padding: 3px 6px; font: inherit; }
  header select + button { margin-left: 8px !important; }
  header button { margin-left: auto; background: #1d2530; color: #cdd6e0;
                  border: 1px solid #2c3542; border-radius: 6px; padding: 4px 12px;
                  font: inherit; cursor: pointer; }
  header button:hover { background: #26303d; }
  header .keys { color: #8b98a5; flex: 1 1 20em; }
  header .keys b { color: #cdd6e0; font-weight: 600; }
  header .touch { display: none; }
  /* A phone: the title, the demo picker and Fullscreen on one line, then a short touch hint on its
     own line. The long description and the keyboard keys squeezed into a narrow column between
     them, and that column took about half the screen from the demo. */
  @media (max-width: 720px), (pointer: coarse) {
    header { align-items: center; }
    header h1 { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis;
                white-space: nowrap; }
    header select { max-width: 45vw; min-width: 0; }
    header #fs .label { display: none; } /* the icon alone */
    header .keys { order: 3; flex: 1 1 100%; }
    header .desc, header .kbd { display: none; }
    header .touch { display: inline; }
  }
  #stage { flex: 1; position: relative; min-height: 0; }
  #canvas-wrap { position: relative; height: 100%; }
  /* top/right/bottom/left, not `inset`: Safari before iOS 14.5 ignores `inset`. */
  canvas#canvas { position: absolute; top: 0; right: 0; bottom: 0; left: 0;
                  width: 100%; height: 100%; display: block; outline: none; background: #000; }
  #overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0;
             display: flex; flex-direction: column;
             align-items: center; justify-content: center; gap: 12px;
             background: #10141a; transition: opacity .4s; }
  #overlay.hidden { opacity: 0; pointer-events: none; }
  .spinner { width: 28px; height: 28px; border: 3px solid #232a33;
             border-top-color: #5aa9e6; border-radius: 50%;
             animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  #status { color: #8b98a5; text-align: center; padding: 0 16px; }
  /* One line tall, printed in or not: the canvas is sized to the stage before the program first
     prints, and the windows are placed in it then. */
  footer { flex: none; padding: 4px 14px; border-top: 1px solid #232a33;
           display: flex; justify-content: space-between; color: #8b98a5;
           font-variant-numeric: tabular-nums; white-space: pre;
           height: 1.5em; overflow: hidden; }
</style>
</head>
<body>
<header>
  <h1>cvcGL &middot; {{DEMO}}</h1>
  <span class="keys"><span class="desc">{{DESC}} &middot;</span>
    <span class="kbd"><b>pinch</b> to zoom &middot; <b>click</b> to focus &middot;
    <b>WASD</b>/arrows move &middot; <b>Tab</b> orbit/fly &middot; <b>H</b> reset view &middot;
    <b>Esc</b> release pointer &middot;</span>
    <span class="touch"><b>drag</b> to turn &middot; <b>pinch</b> to zoom &middot;</span>
    <a href="../">all examples</a></span>
  <select id="demos" title="Open another demo" aria-label="Demos"></select>
  <button id="fs" title="Fullscreen (best on a phone)" aria-label="Fullscreen">⛶<span
    class="label"> Fullscreen</span></button>
</header>
<script src="../gallery.js"></script>
<div id="stage">
  <div id="canvas-wrap"><canvas id="canvas" tabindex="0"></canvas></div>
  <div id="overlay">
    <div class="spinner"></div>
    <div id="status">Loading {{DEMO}}.wasm&hellip;</div>
  </div>
</div>
<footer><span id="stdout"></span><span id="stderr"></span></footer>
<script>
  const DEMO = '{{DEMO}}';
  const WASM_MB = {{WASM_MB}}; // decompressed size shown against a gzip transfer
  // Fullscreen has to be requested from a real user-gesture handler on the
  // DOM side: the wasm app drains its events inside requestAnimationFrame, so
  // calling emscripten_request_fullscreen from there fails the browser's
  // transient-activation check. Target the WRAPPER, not the canvas, so VTK's
  // own canvas sizing keeps working, and nudge a resize when the state flips.
  document.getElementById('fs').addEventListener('click', () => {
    const el = document.getElementById('canvas-wrap');
    if (!(document.fullscreenElement || document.webkitFullscreenElement))
      (el.requestFullscreen || el.webkitRequestFullscreen).call(el);
    else
      (document.exitFullscreen || document.webkitExitFullscreen).call(document);
  });
  // An iPhone has no element fullscreen (only video), so the button is hidden there rather than
  // throwing on a tap. An iPad has it, prefixed.
  if (!(document.fullscreenEnabled || document.webkitFullscreenEnabled))
    document.getElementById('fs').hidden = true;
  for (const ev of ['fullscreenchange', 'webkitfullscreenchange'])
    document.addEventListener(ev,
                              () => setTimeout(() => window.dispatchEvent(new Event('resize')), 60));

  const statusEl = document.getElementById('status');
  const stdoutEl = document.getElementById('stdout');
  const stderrEl = document.getElementById('stderr');
  const canvas = document.getElementById('canvas');
  canvas.addEventListener('click', () => canvas.focus());
  // Right-click belongs to the app (Ariadne's context menus, the transfer-function editor's): keep
  // the browser's own menu off the canvas. It would cover the app's, and where it opens on the
  // press it takes the release the app's menu opens on.
  canvas.addEventListener('contextmenu', e => e.preventDefault());

  var Module = {
    canvas,
    print: t => { stdoutEl.textContent = t.split('\r').pop(); },
    printErr: t => {
      stderrEl.textContent = t;
      if (/ERROR:|error|failed|vtkShaderProgram|vtkOpenGL|Aborted/i.test(t)) {
        (window.__errlog = window.__errlog || []).push(t);
        if (window.__errlog.length > 300) window.__errlog.shift();
      }
      console.error(t);
    },
    setStatus: t => { if (t) statusEl.textContent = t; },
    onRuntimeInitialized() {
      console.info('cvcGL demo: runtime initialized');
      document.getElementById('overlay').classList.add('hidden');
      canvas.focus();
    },
    onAbort: what => {
      const o = document.getElementById('overlay');
      o.classList.remove('hidden');
      o.querySelector('.spinner').style.display = 'none';
      statusEl.textContent = 'Aborted: ' + what;
    },
  };
  // A demo that runs documents (arigl, the gallery's Ariadne app) boots from demos.json's "boot":
  // its command line, with {doc} the ?doc= document (else boot.doc); its environment; and files
  // fetched before the module loads and written into its file system before main.
  const BOOT = {{BOOT}};
  const bootFiles = {};
  if (BOOT) {
    const doc = new URLSearchParams(location.search).get('doc') || BOOT.doc;
    Module.arguments = BOOT.args.map(a => a.replace('{doc}', doc));
    Module.preRun = [() => {
      for (const [k, v] of Object.entries(BOOT.env || {})) ENV[k] = v;
      for (const [path, text] of Object.entries(bootFiles)) FS.writeFile(path, text);
    }];
  }
  // Cache-buster keyed to the ACTUAL wasm content (a short hash baked in at
  // page-generation time), not document.lastModified: build-pages.py emits
  // byte-identical index.html each deploy, so its mtime never moves and the old
  // value froze -- browsers then served a stale, cached .wasm forever.
  const V = '{{ASSET_V}}';
  async function boot() {
    try {
      for (const [path, url] of Object.entries((BOOT && BOOT.files) || {})) {
        const r = await fetch(url, {cache: 'no-cache'});
        if (r.ok)
          bootFiles[path] = await r.text();
        else
          console.warn('cvcGL demo: no ' + url + ' (HTTP ' + r.status + ')');
      }
      const resp = await fetch(DEMO + '.wasm?v=' + V, {cache: 'no-cache'});
      if (!resp.ok) throw new Error('HTTP ' + resp.status + ' fetching ' + DEMO + '.wasm');
      const reader = resp.body.getReader();
      const chunks = [];
      let got = 0;
      for (;;) {
        const {done, value} = await reader.read();
        if (done) break;
        chunks.push(value);
        got += value.length;
        const mb = got / 1048576;
        statusEl.textContent = 'Downloading ' + DEMO + '.wasm — ' +
          Math.min(99, Math.round(100 * mb / WASM_MB)) + '% (' + mb.toFixed(1) + ' MB)';
      }
      const buf = new Uint8Array(got);
      let off = 0;
      for (const c of chunks) { buf.set(c, off); off += c.length; }
      Module.wasmBinary = buf;
      statusEl.textContent = 'Compiling…';
      const s = document.createElement('script');
      s.src = DEMO + '.js?v=' + V;
      s.onerror = () => { throw new Error('failed to load ' + DEMO + '.js'); };
      document.body.appendChild(s);
    } catch (e) {
      const o = document.getElementById('overlay');
      o.querySelector('.spinner').style.display = 'none';
      statusEl.textContent = 'Load failed: ' + (e && e.message || e) +
        ' — try a hard reload (Ctrl+Shift+R)';
    }
  }

  // ?gldiag: a WebGL2 report for a device we cannot debug on (an iPhone), shown instead of the
  // demo; one screenshot of it answers what the renderer can rely on. The tests sample a 2x1
  // texture holding 0 and 1 between its texels, so LINEAR filtering gives 0.5. A float format the
  // device cannot filter linearly samples as 0 (an incomplete texture), the failure behind black
  // clouds and missing shadows. VTK uploads float volumes and its transfer-function tables as
  // 32F formats, filtered linearly.
  function glDiag() {
    const lines = [];
    const add = (k, v) => lines.push(k + ': ' + v);
    add('agent', navigator.userAgent);
    add('screen', screen.width + 'x' + screen.height + ' @' + devicePixelRatio + 'x');
    const gl = document.createElement('canvas').getContext('webgl2');
    if (!gl) {
      add('webgl2', 'NOT AVAILABLE');
    } else {
      const dbg = gl.getExtension('WEBGL_debug_renderer_info');
      add('renderer', dbg ? gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL)
                          : gl.getParameter(gl.RENDERER));
      add('version', gl.getParameter(gl.VERSION));
      const exts = gl.getSupportedExtensions() || [];
      // Enabled as the demo's own context has them (emscripten enables what the browser offers),
      // so the tests below see what the demo sees.
      for (const e of ['OES_texture_float_linear', 'EXT_color_buffer_float',
                       'EXT_color_buffer_half_float', 'EXT_float_blend'])
        add(e, exts.includes(e) && gl.getExtension(e) ? 'yes' : 'NO');
      for (const [n, p] of [['highp', gl.HIGH_FLOAT], ['mediump', gl.MEDIUM_FLOAT]]) {
        const f = gl.getShaderPrecisionFormat(gl.FRAGMENT_SHADER, p);
        add('fragment ' + n + ' float', f ? f.precision + ' bits, 2^' + f.rangeMax : '?');
      }
      add('max texture / 3D', gl.getParameter(gl.MAX_TEXTURE_SIZE) + ' / ' +
                              gl.getParameter(gl.MAX_3D_TEXTURE_SIZE));
      const sh = (type, src) => {
        const s = gl.createShader(type);
        gl.shaderSource(s, src);
        gl.compileShader(s);
        return s;
      };
      const prog = gl.createProgram();
      gl.attachShader(prog, sh(gl.VERTEX_SHADER, '#version 300 es\nin vec2 p;\n' +
                               'void main() { gl_Position = vec4(p, 0.0, 1.0); }'));
      gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, '#version 300 es\nprecision highp float;\n' +
                               'uniform highp sampler2D t;\nout vec4 o;\n' +
                               'void main() { o = vec4(texture(t, vec2(0.5)).rrr, 1.0); }'));
      gl.linkProgram(prog);
      gl.useProgram(prog);
      const vb = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, vb);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      gl.enableVertexAttribArray(0);
      gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
      const target = gl.createTexture();
      gl.bindTexture(gl.TEXTURE_2D, target);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
      const fb = gl.createFramebuffer();
      gl.bindFramebuffer(gl.FRAMEBUFFER, fb);
      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, target, 0);
      gl.viewport(0, 0, 1, 1);
      const sample = (name, internal, format, type, data) => {
        const t = gl.createTexture();
        gl.activeTexture(gl.TEXTURE0);
        gl.bindTexture(gl.TEXTURE_2D, t);
        gl.texImage2D(gl.TEXTURE_2D, 0, internal, 2, 1, 0, format, type, data);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
        const px = new Uint8Array(4);
        gl.readPixels(0, 0, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, px);
        const v = px[0] / 255;
        add('linear ' + name, v.toFixed(2) + (Math.abs(v - 0.5) < 0.05 ? ' ok' : ' FAILS'));
        gl.deleteTexture(t);
      };
      // Each format holds 0 then 1 in its first channel, the rest 0.
      const f32 = n => new Float32Array([0, 0, 0, 0].slice(0, n).concat([1, 0, 0, 0].slice(0, n)));
      sample('R8 (bytes)', gl.R8, gl.RED, gl.UNSIGNED_BYTE, new Uint8Array([0, 255]));
      sample('R16F', gl.R16F, gl.RED, gl.FLOAT, f32(1));
      sample('R32F', gl.R32F, gl.RED, gl.FLOAT, f32(1));
      sample('RG32F', gl.RG32F, gl.RG, gl.FLOAT, f32(2));
      sample('RGB32F', gl.RGB32F, gl.RGB, gl.FLOAT, f32(3));
      // Rendering into R32F: the sun's shadow map.
      const rt = gl.createTexture();
      gl.bindTexture(gl.TEXTURE_2D, rt);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.R32F, 4, 4, 0, gl.RED, gl.FLOAT, null);
      const fb2 = gl.createFramebuffer();
      gl.bindFramebuffer(gl.FRAMEBUFFER, fb2);
      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, rt, 0);
      add('render to R32F', gl.checkFramebufferStatus(gl.FRAMEBUFFER) === gl.FRAMEBUFFER_COMPLETE
                                ? 'ok' : 'FAILS');
    }
    document.getElementById('overlay').querySelector('.spinner').style.display = 'none';
    statusEl.innerHTML = '';
    const pre = document.createElement('pre');
    pre.textContent = lines.join('\n');
    pre.style.cssText = 'text-align:left;white-space:pre-wrap;word-break:break-word;' +
                        'max-width:40em;margin:0;font:12px/1.4 ui-monospace,monospace;' +
                        'color:#cdd6e0;user-select:text';
    statusEl.appendChild(pre);
    console.log('gldiag\n' + lines.join('\n'));
  }

  if (new URLSearchParams(location.search).has('gldiag'))
    glDiag();
  else
    boot();
</script>
</body>
</html>
