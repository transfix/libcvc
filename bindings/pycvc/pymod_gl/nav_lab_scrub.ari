# nav_lab_scrub.ari — watch it learn: every checkpoint of a training run deployed (python -m
# pycvc_gl.nav_lab scrub HISTORY; docs/NAV_LAB.md). pycvc_gl/nav_lab.py has cvc::nav deploy each
# checkpoint on one scenario (cached beside the history) and draws the scenario's world and the two
# ghosts; cvc::nav::scrub_view writes every window: checkpoint k beside step 0.
#
# - Scrub: the history, the scenario and the checkpoint (a combo, a slider, Previous and Next, or a
#   click on a chart); the deployed metric against the step with step 0's dashed, and the table.
# - Training: a curve from the history (Curve picks it), the pick marked.
# - Episode and Simulation: the two runs' time (libcvc's sim transport, a Position slider).
# - Stats and Ledger: step 0 (blue) and checkpoint k (orange) at the play head.

meta:
  name: nav lab — scrub
  min_libcvc: 3.7.13

import:
  - cvc://components/sim_transport.ari
  - cvc://components/nav_lab_panels.ari

requires:
  - {name: chart, optional: true}   # the charts (libcvc 3.7.14); the tables show the numbers too

init: |
  (begin
    (state-set "sim.paused" "0")
    (state-set "sim.speed" "1.0")
    (state-set "play.pos" "0")
    (state-set "play.loop" "1")
    (state-set "view.camera" "orbit")
    (state-set "arms.on" "1")
    (state-set "arms.live" "0")
    (state-set "ledger.book" "dU")
    (state-set "ledger.vehicle" "0")
    (state-set "scrub.metric_name" "goal_m"))

menubar:
  - menu: Scrub
    items:
      - menu_item: Previous checkpoint
        on: scrub.prev
      - menu_item: Next checkpoint
        on: scrub.next
      - menu_item: Paused
        bind: sim.paused
      - separator
      - menu_item: Quit
        on: quit

windows:
  - include: nav_lab_scrub
    pos: [16, 30]
    size: [520, 560]
  - include: nav_lab_training
    pos: [548, 30]
    size: [480, 300]
  - include: nav_lab_episode
    pos: [548, 342]
    size: [480, 130]
  - include: sim_transport
    pos: [548, 484]
    size: [260, 170]
  - include: nav_lab_stats
    pos: [1040, 30]
    size: [600, 320]
  - include: nav_lab_ledger
    pos: [1040, 362]
    size: [600, 540]

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 10], radius: 200 }
      key: { intensity: 1.3, azimuth: -60, elevation: 40, cone: 62 }
      fill: 0.35
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.35
