# nav_lab_arms.ari — several navigation policies side by side, live (python -m pycvc_gl.nav_lab
# arms; docs/NAV_LAB.md). pycvc_gl/nav_lab.py builds one libcvc sim_world per arm on the plant
# nav_plant.vehicle names, steps them tick for tick together (cvc::nav::arms_run), draws each arm's
# ghost in its colour and writes the Stats and Ledger windows (libcvc's nav_lab_stats and nav_lab_ledger components)
# from the run's log at its last tick.
#
# - Run: what runs, the camera, and the transport (libcvc's sim_transport: Paused, Speed, Step).
# - Stats and Ledger: libcvc's nav_lab_stats and nav_lab_ledger windows; Retarget moves every
#   arm's goals on one tick.
# - Settings: the navigator's, the vehicle's and the plant's knobs (pycvc_gl.cars' cars_settings);
#   nav_plant.vehicle switches the plant live in every arm.
# The world: run.world (data: the data: block's city; generated: the world.* keys; flat), set on
# the command line (--world, --uri, --set); the arms all run on the same one.

meta:
  name: nav lab — arms
  min_libcvc: 3.7.13

import:
  - cvc://components/sim_transport.ari
  - cvc://components/nav_lab_stats.ari
  - cvc://components/nav_lab_ledger.ari
  - cvc://cars_panels.ari

requires:
  - {name: chart, optional: true}   # the Stats and Ledger charts (libcvc 3.7.14)

data:
  city:
    uri: cvcpkg://cy-pca/scene-austin-south-small
    path: share/cvc-scenes/austin_south
    as: city_bundle
    load: lazy

init: |
  (begin
    (state-set "sim.paused" "0")
    (state-set "sim.speed" "1.0")
    (state-set "view.camera" "follow")
    (state-set "arms.on" "1")
    (state-set "arms.live" "1")
    (state-set "ledger.book" "dU")
    (state-set "ledger.vehicle" "0")
    (state-set "nav_plant.vehicle" "kinematic")
    (state-set "run.world" "data")
    (state-set "run.uri" "cvcpkg://cy-pca/scene-austin-south-small")
    (state-set "run.data_path" "share/cvc-scenes/austin_south")
    (state-set "run.crop" "600")
    (state-set "world.seed" "7")
    (state-set "world.half" "400")
    (state-set "world.amp" "25")
    (state-set "world.water_level" "-4")
    (state-set "world.buildings" "120")
    (state-set "world.trees" "200")
    (state-set "world.rocks" "40")
    (state-set "world.terrain" "fbm")
    (state-set "world.city" "districts"))

menubar:
  - menu: Arms
    items:
      - menu_item: Paused
        bind: sim.paused
      - menu_item: Retarget every arm
        on: arms.retarget
      - separator
      - menu_item: Quit
        on: quit

windows:
  - window: Run
    id: nav_lab_run
    pos: [16, 30]
    size: [380, 150]
    children:
      - text: ""
        bind: demo.title
      - combo: Camera
        bind: view.camera
        options: [Follow the arm, Orbit]
        values: [follow, orbit]
        tooltip: "the Stats window's Follow picks the arm"
      - combo: Vehicle
        bind: nav_plant.vehicle
        options: [kinematic, humvee, roboracer, "dynamic:humvee"]
        tooltip: "the plant every arm drives; a change switches it on the next tick"

  - include: sim_transport
    pos: [16, 192]
    size: [260, 170]

  - include: cars_settings
    pos: [16, 374]

  - include: nav_lab_stats
    pos: [1172, 30]
    size: [600, 400]

  - include: nav_lab_ledger
    pos: [1172, 442]
    size: [600, 540]

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 2
    softness: 3
    focus: { follow: camera, min_radius: 30, max_radius: 600, per_distance: 3, lead: 0.5,
             lift: 15, ground: world }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 25], radius: 900 }
      key: { intensity: 1.3, azimuth: -60, elevation: 32, cone: 62 }
      fill: 0.3
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.32
  nodes:
    - node: city
      source: { data: city }
      visible: { bind: view.city, default: false }
    - node: gen
      type: generated_world
      look: soft
      visible: { bind: view.generated, default: false }
