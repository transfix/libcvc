# cars.ari: the panels around cars.py, which drives N Ackermann cars with YOUR controller
# (pycvc_gl.cars). python cars.py, or python -m pycvc_gl.cars for the package's own copy.
#
# Everything here is the state tree, so this file can carry a whole configuration in its init:
#   run.*        the run: the world (data | generated | flat), cars, controller, ticks per frame
#   nav_plant.*  the plant (libcvc's plant_host): `vehicle` switches it live; latency, margins
#   nav.*        the navigator and nav's bicycle (sim_world::pull): nav.vehicle.vmax, a_max,
#                d_hat, rr, k_steer, risk_governor, ... (units and ranges: Settings' tooltips)
#   ctl.*        your controller's parameters (PARAMS in cars.py)
#   world.*      the terrain generator's (World: generated)
# The Settings apply on the next tick; Vehicle switches the plant at once (the cars keep their
# poses); Cars, World and Controller rebuild the run.
#
# The world: the data: block's city (Austin from cvcpkg.org by default; Run's URI loads another
# package or a local bundle), a generated world (the World window; Python generates it from the
# world.* keys and the scene's generated_world node draws the same world), or a flat square.

meta:
  name: Cars (your controller)
  min_libcvc: 3.7.11

data:
  city:
    uri: cvcpkg://cy-pca/scene-austin-south-small
    path: share/cvc-scenes/austin_south
    as: city_bundle
    load: lazy

init: |
  (begin
    (state-set "run.world" "data")
    (state-set "run.uri" "cvcpkg://cy-pca/scene-austin-south-small")
    (state-set "run.data_path" "share/cvc-scenes/austin_south")
    (state-set "run.crop" "600")
    (state-set "run.cars" "6")
    (state-set "run.controller" "yours")
    (state-set "run.ticks" "1")
    (state-set "run.regoal" "1")
    (state-set "run.paused" "0")
    (state-set "nav_plant.vehicle" "humvee")
    (state-set "view.camera" "follow")
    (state-set "view.car" "0")
    (state-set "view.horizon" "3")
    (state-set "view.raster_m" "60")
    (state-set "show.plans" "1")
    (state-set "world.seed" "7")
    (state-set "world.half" "400")
    (state-set "world.amp" "25")
    (state-set "world.water_level" "-4")
    (state-set "world.buildings" "120")
    (state-set "world.trees" "200")
    (state-set "world.rocks" "40")
    (state-set "world.terrain" "fbm")
    (state-set "world.city" "districts"))

menubar:
  - menu: Run
    items:
      - menu_item: Paused
        bind: run.paused
      - menu_item: New goals
        on: new_goals
      - menu_item: Reset
        on: reset
      - separator
      - menu_item: Quit
        on: quit

windows:
  - window: Run
    id: run
    pos: [16, 30]
    size: [360, 380]
    children:
      - combo: World
        bind: run.world
        options: [City (data block), Generated terrain, Flat square]
        values: [data, generated, flat]
        tooltip: "rebuilds the run"
      - input_text: URI
        bind: run.uri
        visible_when: (= (state-get "run.world") "data")
        tooltip: "cvcpkg://ORG/NAME, an https archive, or a local bundle directory (terrain.json + buildings.glb)"
      - input_text: Path in package
        bind: run.data_path
        visible_when: (= (state-get "run.world") "data")
      - button: Load the city
        on: load_world
        visible_when: (= (state-get "run.world") "data")
      - text: "city"
        bind: data.city.status
        visible_when: (= (state-get "run.world") "data")
      - combo: Vehicle
        bind: nav_plant.vehicle
        options: [Kinematic bicycle, Humvees (Jolt), RoboRacers (Jolt), Humvees and RoboRacers, Dynamic Humvees, Dynamic RoboRacers, Dynamic 4-wheel Humvees]
        values: [kinematic, humvee, roboracer, "humvee,roboracer", dynamic, "dynamic:roboracer", dynamic4w]
        tooltip: "switches the plant at once; the cars keep their poses and start at rest"
      - slider_int: Cars
        bind: run.cars
        lo: 1
        hi: 24
        commit: release
        tooltip: "rebuilds the run"
      - combo: Controller
        bind: run.controller
        options: [Yours (cars.py), libcvc's navigator]
        values: [yours, navigator]
        tooltip: "rebuilds the run"
      - slider_int: Ticks per frame
        bind: run.ticks
        lo: 1
        hi: 8
      - checkbox: New goal on arrival
        bind: run.regoal
      - checkbox: Paused
        bind: run.paused
      - combo: Camera
        bind: view.camera
        options: [Follow the chosen car, Overview]
        values: [follow, overview]
      - slider_int: Chosen car
        bind: view.car
        lo: 0
        hi: 23
      - checkbox: Predicted paths
        bind: show.plans
      - button: New goals
        on: new_goals
      - button: Reset
        on: reset

  - window: Settings
    id: settings
    pos: [16, 422]
    size: [360, 330]
    children:
      - text: "navigator and vehicles: applied on the next tick"
      - slider_float: Top speed (m/s)
        bind: nav.vehicle.vmax
        lo: 0.5
        hi: 40
        fmt: "%.1f"
        tooltip: "nav.vehicle.vmax: the top speed; on a vehicle, the lower of this and its own"
      - slider_float: Acceleration (m/s^2)
        bind: nav.vehicle.a_max
        lo: 0.5
        hi: 15
        fmt: "%.1f"
        tooltip: "nav.vehicle.a_max: the acceleration and braking the navigator commands"
      - slider_float: Cornering (m/s^2)
        bind: nav.vehicle.a_lat_max
        lo: 0.5
        hi: 15
        fmt: "%.1f"
        tooltip: "nav.vehicle.a_lat_max: the sideways acceleration the corner speed limit allows"
      - slider_float: Barrier range d_hat (m)
        bind: nav.vehicle.d_hat
        lo: 0.5
        hi: 30
        fmt: "%.1f"
        tooltip: "nav.vehicle.d_hat: how far from a wall the barrier that pushes the vehicle away reaches"
      - slider_float: Footprint radius (m)
        bind: nav.vehicle.rr
        lo: 0.1
        hi: 5
        fmt: "%.2f"
        tooltip: "nav.vehicle.rr: the footprint disc the navigator keeps clear of walls"
      - slider_float: Wall steering k_steer (rad)
        bind: nav.vehicle.k_steer
        lo: 0
        hi: 2
        fmt: "%.2f"
      - slider_float: Bicycle wheelbase (m)
        bind: nav.vehicle.wheelbase
        lo: 0.2
        hi: 8
        fmt: "%.2f"
        tooltip: "nav.vehicle.wheelbase: nav's bicycle (the kinematic plant); a vehicle has its own"
      - slider_float: Steering lock (rad)
        bind: nav.vehicle.delta_max
        lo: 0.1
        hi: 1
        fmt: "%.3f"
      - checkbox: Risk governor
        bind: nav.vehicle.risk_governor
      - slider_float: Arrival radius (m)
        bind: nav.reach_tol
        lo: 0.5
        hi: 20
        fmt: "%.1f"
      - slider_float: Plant latency (s)
        bind: nav_plant.latency
        lo: 0
        hi: 0.5
        fmt: "%.2f"
        tooltip: "nav_plant.latency: the response time the navigator's stopping limit allows for"
      - slider_float: Brake margin
        bind: nav_plant.brake_margin
        lo: 0.3
        hi: 1
        fmt: "%.2f"

  - window: Controller
    id: controller
    pos: [388, 30]
    size: [340, 190]
    children:
      - text: "your parameters (ctl.*): applied on the next tick"
      - slider_float: Speed (x top speed)
        bind: ctl.speed
        lo: 0.05
        hi: 1.0
        fmt: "%.2f"
      - slider_float: Spacing (car lengths)
        bind: ctl.spacing
        lo: 0.0
        hi: 10.0
        fmt: "%.1f"
      - slider_float: Steering gain
        bind: ctl.gain
        lo: 0.1
        hi: 5.0
        fmt: "%.2f"
      - slider_float: Wall look-ahead (car lengths)
        bind: ctl.look
        lo: 0.5
        hi: 12.0
        fmt: "%.1f"
      - slider_float: Prediction (s)
        bind: view.horizon
        lo: 0.5
        hi: 8.0
        fmt: "%.1f"

  - window: World
    id: world
    pos: [388, 232]
    size: [340, 330]
    visible_when: (= (state-get "run.world") "generated")
    children:
      - text: "libcvc's terrain generator: Regenerate rebuilds the world and the run"
      - slider_int: Seed
        bind: world.seed
        commit: release
        lo: 0
        hi: 99999
      - slider_float: World half (m)
        bind: world.half
        commit: release
        lo: 150
        hi: 3000
        fmt: "%.0f"
      - slider_float: Relief (m)
        bind: world.amp
        commit: release
        lo: 2
        hi: 400
        fmt: "%.0f"
      - slider_float: Water level (m)
        bind: world.water_level
        commit: release
        lo: -100
        hi: 100
        fmt: "%.1f"
      - slider_int: Buildings
        bind: world.buildings
        commit: release
        lo: 0
        hi: 600
      - slider_int: Trees
        bind: world.trees
        commit: release
        lo: 0
        hi: 3000
      - slider_int: Rocks
        bind: world.rocks
        commit: release
        lo: 0
        hi: 600
      - combo: City
        bind: world.city
        options: [Districts (roads and buildings), None]
        values: [districts, none]
      - button: Regenerate
        on: regenerate_world
      - text: "status"
        bind: world.status

  - window: Cars
    id: cars
    pos: [740, 30]
    size: [420, 560]
    children:
      - text: "controller"
        bind: stats.controller
      - text: "plant"
        bind: stats.plant
      - text: "world"
        bind: stats.world
      - text: "time (s)"
        bind: stats.time
      - text: "at their goals"
        bind: stats.arrived
      - text: "arrivals"
        bind: stats.arrivals
      - text: "car-ticks touching"
        bind: stats.touching
      - text: ""
        bind: stats.note
      - separator
      - plot: Chosen car's speed (m/s)
        bind: plot.speed
        height: 44
      - plot: Closest gap between two cars (m)
        bind: plot.gap
        height: 44
      - text: ""
        bind: plot.coef0_name
      - plot: coefficient 1
        bind: plot.coef0
        height: 36
      - text: ""
        bind: plot.coef1_name
      - plot: coefficient 2
        bind: plot.coef1
        height: 36
      - text: ""
        bind: plot.coef2_name
      - plot: coefficient 3
        bind: plot.coef2
        height: 36
      - text: ""
        bind: plot.coef3_name
      - plot: coefficient 4
        bind: plot.coef3
        height: 36
      - separator
      - type: group
        layout: { kind: grid, col_widths: [36, 64, 56, 64, 72, 80] }
        children:
          - text: "car"
          - text: "m/s"
          - text: "steer"
          - text: "accel"
          - text: "to goal"
          - text: ""
      - type: group
        repeat: (state-get "carrows")
        layout: { kind: grid, col_widths: [36, 64, 56, 64, 72, 80] }
        children:
          - text: ""
            bind: carrows.{i}.car
          - text: ""
            bind: carrows.{i}.speed
          - text: ""
            bind: carrows.{i}.steer
          - text: ""
            bind: carrows.{i}.accel
          - text: ""
            bind: carrows.{i}.goal
          - text: ""
            bind: carrows.{i}.status

  - window: Rasters
    id: rasters
    pos: [740, 602]
    size: [420, 300]
    children:
      - text: "around the chosen car, heading up: distance to obstacles, its predicted path (yellow), goal (green), other cars (red)"
      - type: group
        layout: { kind: grid, col_widths: [200, 200] }
        children:
          - text: "signed distance"
          - text: "your cost (navigator: its belief)"
          - image: sdf
            src: raster.sdf
            size: 190
          - image: cost
            src: raster.cost
            size: 190
      - slider_float: Window (m)
        bind: view.raster_m
        lo: 5
        hi: 300
        fmt: "%.0f"

scene:
  chrome: false
  background: { top: [0.38, 0.54, 0.78], bottom: [0.78, 0.83, 0.88] }
  shadows:
    enabled: true
    resolution: 4096
    update_interval: 2
    softness: 3
    focus: { follow: camera, min_radius: 30, max_radius: 600, per_distance: 3, lead: 0.5,
             lift: 15, ground: world }
  lights:
    - light: sun
      rig: three_point
      stage: { center: [0, 0, 25], radius: 900 }
      key: { intensity: 1.3, azimuth: -60, elevation: 32, cone: 62 }
      fill: 0.3
      back: 0
      wash: 0
      warmth: 0.5
      environment: 0.5
      ambient: 0.32
  nodes:
    # World: City. The data: block's city (or what Run's Load points data.city at): its terrain with
    # the aerial image draped, and its buildings.
    - node: city
      source: { data: city }
      visible: { bind: view.city, default: false }
    # World: Generated. libcvc's generator, from the world.* keys above (Python makes the same world
    # for the cars, the navigator and the physics).
    - node: gen
      type: generated_world
      look: soft
      visible: { bind: view.generated, default: false }
