# A client that presents a host credential, as an OIDC sign-in's would be (ctest
# arisrvx_auth_credential: --relay-credential, its token through --credential-env, bound to the
# relay's origin by a policy line). The hook admits it as alice; when the relay closes the
# connection (host.disconnect, her token still good) the client dials again, and the hook admits
# her a second time. A credential's join happens from the frames, so each test waits for it
# (relay.status, relay.joins).
meta: { name: a client joining with a credential, min_libcvc: 3.7.13 }
tests:
  joins_with_the_credential: |
    (while (not (= (state-get "relay.status") "joined")) (sleep 0.05))
    (assert (= (state-get "relay.joins") "1") (state-get "relay.joins"))
    (let ((p (room-call "whoami")))
      (assert (= (get-attr p "id") "alice") p))
    (assert (= (room-call "admitted") 1))
  dials_again_when_the_relay_closes_it: |
    (assert (= (room-call "kick") "kicked"))
    (while (not (= (state-get "relay.joins") "2")) (sleep 0.05))
    (assert (= (state-get "relay.status") "joined") (state-get "relay.status"))
    (assert (= (room-call "admitted") 2) "the client came back, and the hook admitted it again")
    (let ((p (room-call "whoami")))
      (assert (= (get-attr p "id") "alice") p))
