# The server document beside tests/scope_service.py (the read-scope ctests): it publishes svc,
# which the program writes and each client mirrors (relay: subscribe:) as far as its read scope
# lets it.
meta: { name: read scope's server document, min_libcvc: 3.7.13 }
requires: [relay, python]
server:
  publish: [svc]
