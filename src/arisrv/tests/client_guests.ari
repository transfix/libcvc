# The client for ctest arisrvx_room_call_guest: it sends arisrvx (with client_guests_server.ari)
# a WebAssembly guest to run as its own ((room-run module ...), room_calls.h). (guest) is
# client_guest.wat, assembled (wasm-opt client_guest.wat -o client_guest.wasm), as bytes.
meta: { name: clients' guests on a relay, min_libcvc: 3.7.13 }
functions: |
  (defun guest () (bytes.concat
    b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x22\x06\x60\x02\x7f\x7f\x01\x7e\x60\x04\x7f\x7f\x7f\x7f\x01"
    b"\x7e\x60\x01\x7f\x00\x60\x02\x7f\x7f\x00\x60\x01\x7f\x01\x7f\x60\x01\x7e\x01\x7e\x02\x43\x05\x03"
    b"\x61\x72\x69\x04\x63\x61\x6c\x6c\x00\x01\x03\x61\x72\x69\x05\x72\x65\x70\x6c\x79\x00\x02\x03\x61"
    b"\x72\x69\x04\x66\x61\x69\x6c\x00\x03\x03\x61\x72\x69\x09\x73\x74\x61\x74\x65\x5f\x73\x65\x74\x00"
    b"\x01\x03\x61\x72\x69\x09\x73\x74\x61\x74\x65\x5f\x67\x65\x74\x00\x00\x03\x09\x08\x04\x00\x05\x00"
    b"\x00\x00\x00\x00\x05\x03\x01\x00\x01\x06\x07\x01\x7f\x01\x41\x80\x08\x0b\x07\x3a\x07\x06\x6d\x65"
    b"\x6d\x6f\x72\x79\x02\x00\x09\x61\x72\x69\x5f\x61\x6c\x6c\x6f\x63\x00\x05\x03\x72\x75\x6e\x00\x08"
    b"\x05\x77\x72\x69\x74\x65\x00\x09\x04\x70\x6f\x73\x65\x00\x0a\x05\x73\x70\x61\x77\x6e\x00\x0b\x04"
    b"\x73\x70\x69\x6e\x00\x0c\x0a\x99\x01\x08\x11\x01\x01\x7f\x23\x00\x21\x01\x23\x00\x20\x00\x6a\x24"
    b"\x00\x20\x01\x0b\x0c\x00\x20\x00\xad\x42\x20\x86\x20\x01\xad\x84\x0b\x2e\x01\x01\x7f\x23\x00\x21"
    b"\x01\x20\x01\x10\x01\x20\x00\x42\x00\x53\x04\x40\x20\x01\x42\x00\x20\x00\x7d\xa7\x10\x02\x00\x0b"
    b"\x23\x00\x20\x00\xa7\x6a\x24\x00\x20\x01\x20\x00\xa7\x10\x06\x0b\x08\x00\x20\x00\x20\x01\x10\x06"
    b"\x0b\x17\x00\x41\x10\x41\x05\x41\x20\x41\x02\x10\x03\x10\x07\x1a\x41\x10\x41\x05\x10\x04\x10\x07"
    b"\x0b\x0e\x00\x41\x30\x41\x04\x41\x20\x41\x02\x10\x03\x10\x07\x0b\x10\x00\x41\xc0\x00\x41\x05\x41"
    b"\xd0\x00\x41\x01\x10\x00\x10\x07\x0b\x08\x00\x03\x40\x0c\x00\x0b\x00\x0b\x0b\x2d\x05\x00\x41\x10"
    b"\x0b\x05\x73\x63\x6f\x72\x65\x00\x41\x20\x0b\x02\x18\x2a\x00\x41\x30\x0b\x04\x70\x6f\x73\x65\x00"
    b"\x41\xc0\x00\x0b\x05\x73\x70\x61\x77\x6e\x00\x41\xd0\x00\x0b\x01\x80"))
tests:
  a_guest_runs_and_returns_its_value: |
    (let ((v (room-run (guest) 41 "x")))
      (assert (= (nth v 0) 41) v)
      (assert (= (nth v 1) "x") v))
  the_async_form_returns_a_future: |
    (let ((v (await (room-run-async (guest) 7))))
      (assert (= (car v) 7) v))
  it_writes_in_its_own_participant: |
    (assert (= (room-run-opts (dict "export" "write") (guest)) "42"))
  it_may_not_write_the_relays_keys: |
    (let ((m (try (begin (room-run-opts (dict "export" "pose") (guest)) "no error")
                  (catch (RuntimeError e) (list (get-attr e "code") (get-attr e "message"))))))
      (assert (= (nth m 0) "failed") m)
      (assert (string.contains (nth m 1) "PermissionError") m))
  it_has_no_spawn: |
    (let ((m (try (begin (room-run-opts (dict "export" "spawn") (guest)) "no error")
                  (catch (RuntimeError e) (list (get-attr e "code") (get-attr e "message"))))))
      (assert (= (nth m 0) "failed") m)
      (assert (string.contains (nth m 1) "NameError") m)
      (assert (string.contains (nth m 1) "spawn") m))
  bytes_that_are_no_module_are_invalid: |
    (let ((m (try (begin (room-run b"not a module") "no error")
                  (catch (RuntimeError e) (get-attr e "code")))))
      (assert (= m "invalid") m))
  its_cap_stops_it: |
    (let ((m (try (begin (room-run-opts (dict "export" "spin") (guest)) "no error")
                  (catch (RuntimeError e) (get-attr e "code")))))
      (assert (= m "resource_exhausted") m))
