# A document set laid out as an app installs one (share/<app>/main.ari) or a site serves one
# (/apps/<app>/main.ari): main.ari imports from its own directory, from its parent's, and from the
# component library. arigl's tests run it from another working directory (ctest arigl_docset), and
# the browser shell's check loads it by URL (docs/CVCGL_WASM.md, "arigl-web").

meta:
  name: arigl document set
  min_libcvc: 3.7.4

# The server an app talks to, which in a browser is the page's own origin: the shell's config
# passes `--instance {origin}` (src/arigl/web/test/arigl_web_smoke.mjs checks it).
args:
  instance: {type: string, default: "(none)", help: The server this app talks to}

init: |
  (state-set "docset.instance" (state-get "args.instance"))

import:
  - lib/panel.ari
  - ../shared/note.ari
  - cvc://components/display_toggles.ari

windows:
  - include: panel
  - include: display_toggles
