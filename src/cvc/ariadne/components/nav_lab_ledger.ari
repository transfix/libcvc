# nav_lab_ledger.ari — a REUSABLE Ariadne component: the Ledger window for several navigation
# policies run side by side (cvc::nav's arms, docs/NAV_LAB.md): per arm, the coefficients in force,
# the terms of U_nav, the books against it (summed and this tick's), and one arm's plant ledger. Its
# twin is the Stats window (nav_lab_stats.ari, which says how a host fills them).
#
# Use it:
#     import: [cvc://components/nav_lab_stats.ari, cvc://components/nav_lab_ledger.ari]
#     windows:
#       - include: nav_lab_ledger
#
# It shows while arms.on is 1. The keys: ledger.coef, ledger.terms, ledger.books (summed),
# ledger.tick (this tick's): a row per arm, for agent ledger.vehicle of each (shown when arms.agents
# > 1); ledger.agent (the arm whose plant ledger and books chart show; arms.names lists them);
# ledger.plant (key, value, unit; n/a where the item does not apply on that plant) and
# ledger.plant_note; ledger.book and the charts ledger.cum, ledger.compare (a cursor at play.t, a
# click to play.seek and arms.seek).

units:
  nav_lab_ledger:
    args: { title: Ledger, id: nav_lab_ledger }
    window: "{title}"
    id: "{id}"
    size: [640, 560]
    visible_when: (= (state-get "arms.on") "1")
    children:
      - text: "per arm, this tick: the coefficients in force and the terms of U_nav"
      - input_text: Agent of each arm
        bind: ledger.vehicle
        visible_when: (!= (state-get "arms.agents") "1")
        tooltip: "which agent of each arm the Ledger shows (0, 1, ...)"
      - type: group
        layout: { kind: grid, col_widths: [96, 64, 64, 64, 68, 68, 56] }
        children:
          - text: "arm"
          - text: "alpha"
          - text: "beta"
          - text: "gamma"
          - text: "lam_soft"
          - text: "lam_hard"
          - text: "mu"
      - type: group
        repeat: (state-get "ledger.coef")
        layout: { kind: grid, col_widths: [96, 64, 64, 64, 68, 68, 56] }
        children:
          - text: ""
            bind: ledger.coef.{i}.arm
          - text: ""
            bind: ledger.coef.{i}.alpha
          - text: ""
            bind: ledger.coef.{i}.beta
          - text: ""
            bind: ledger.coef.{i}.gamma
          - text: ""
            bind: ledger.coef.{i}.lam_soft
          - text: ""
            bind: ledger.coef.{i}.lam_hard
          - text: ""
            bind: ledger.coef.{i}.mu
      - type: group
        layout: { kind: grid, col_widths: [96, 64, 64, 70, 56, 56, 60] }
        children:
          - text: "arm"
          - text: "U"
          - text: "goal"
          - text: "barrier"
          - text: "soft"
          - text: "hard"
          - text: "terrain"
      - type: group
        repeat: (state-get "ledger.terms")
        layout: { kind: grid, col_widths: [96, 64, 64, 70, 56, 56, 60] }
        children:
          - text: ""
            bind: ledger.terms.{i}.arm
          - text: ""
            bind: ledger.terms.{i}.potential
          - text: ""
            bind: ledger.terms.{i}.u_goal
          - text: ""
            bind: ledger.terms.{i}.u_barrier
          - text: ""
            bind: ledger.terms.{i}.u_soft
          - text: ""
            bind: ledger.terms.{i}.u_hard
          - text: ""
            bind: ledger.terms.{i}.u_terrain
      - separator
      - text: "the books against U_nav (unit mass, normalized units):"
      - text: "dU = drive + projection + context + residual; dH = dKE + dU. Summed over the run:"
      - type: group
        layout: { kind: grid, col_widths: [96, 64, 64, 76, 64, 60, 64] }
        children:
          - text: "arm"
          - text: "dU"
          - text: "drive"
          - text: "projection"
          - text: "context"
          - text: "dKE"
          - text: "residual"
      - type: group
        repeat: (state-get "ledger.books")
        layout: { kind: grid, col_widths: [96, 64, 64, 76, 64, 60, 64] }
        children:
          - text: ""
            bind: ledger.books.{i}.arm
          - text: ""
            bind: ledger.books.{i}.dU
          - text: ""
            bind: ledger.books.{i}.drive
          - text: ""
            bind: ledger.books.{i}.projection
          - text: ""
            bind: ledger.books.{i}.context
          - text: ""
            bind: ledger.books.{i}.dKE
          - text: ""
            bind: ledger.books.{i}.residual
      - text: "this tick:"
      - type: group
        repeat: (state-get "ledger.tick")
        layout: { kind: grid, col_widths: [96, 64, 64, 76, 64, 60, 64] }
        children:
          - text: ""
            bind: ledger.tick.{i}.arm
          - text: ""
            bind: ledger.tick.{i}.dU
          - text: ""
            bind: ledger.tick.{i}.drive
          - text: ""
            bind: ledger.tick.{i}.projection
          - text: ""
            bind: ledger.tick.{i}.context
          - text: ""
            bind: ledger.tick.{i}.dKE
          - text: ""
            bind: ledger.tick.{i}.residual
      - separator
      - combo: Arm
        bind: ledger.agent
        options: (string.split (state-get "arms.names") "\n")
        tooltip: "the arm whose plant ledger and cumulative books show below"
      - type: group
        visible_when: (has? "chart")
        children:
          - chart: Its books, cumulative
            bind: ledger.cum
            legend: right
            x_label: time (s)
            cursor: play.t
            pick: play.seek
            on: arms.seek
            height: 110
          - combo: Book
            bind: ledger.book
            options: [dU, drive, projection, context, dKE, residual]
          - chart: That book, cumulative, every arm
            bind: ledger.compare
            legend: right
            x_label: time (s)
            cursor: play.t
            pick: play.seek
            on: arms.seek
            height: 110
      - text: ""
        bind: ledger.plant_note
      - type: group
        repeat: (state-get "ledger.plant")
        layout: { kind: grid, col_widths: [170, 90, 60] }
        children:
          - text: ""
            bind: ledger.plant.{i}.key
          - text: ""
            bind: ledger.plant.{i}.value
          - text: ""
            bind: ledger.plant.{i}.unit
