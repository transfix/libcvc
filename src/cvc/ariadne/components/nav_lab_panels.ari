# nav_lab_panels.ari — a REUSABLE Ariadne component: the arms' windows, Stats and Ledger, for several
# navigation policies run side by side (cvc::nav's arms, docs/NAV_LAB.md). A host writes what they
# show from a run log at a tick with cvc::nav::publish_tables / publish_charts (pycvc:
# nav_run_log_publish): a live run at its last tick, a replay at its play head, so both show the same
# cells. pycvc_gl.nav_lab is such a host; so is a C++ AppRuntime.
#
# Use it:
#     import: cvc://components/nav_lab_panels.ari
#     requires:
#       - {name: chart, optional: true}   # the charts (libcvc 3.7.14); hidden on an older host
#     windows:
#       - include: nav_lab_stats          # pos: / size: at the include site place it
#       - include: nav_lab_ledger
#
# Both show while arms.on is 1; the Retarget controls only while arms.live is 1 (a live run). The
# charts draw a cursor at play.t (a replay's play head), and a click on one writes the time there to
# play.seek and raises arms.seek (a replay seeks there). The keys:
#   nav_lab_stats   arms.time; arms.stats (a row per arm over its agents and the current leg: arm,
#                   colour, clear_min, clear_mean, pen, path, elapsed, ms, reached); arms.goal (the
#                   next Retarget's "x, y" in metres: empty asks the host for one) and the button,
#                   which raises arms.retarget; arms.status; view.arm (the arm the camera follows;
#                   arms.names lists them, one a line); the chart arms.clearance
#   nav_lab_ledger  ledger.coef, ledger.terms, ledger.books (summed), ledger.tick (this tick's): a row
#                   per arm, for agent ledger.vehicle of each (shown when arms.agents > 1);
#                   ledger.agent (the arm whose plant ledger and books chart show); ledger.plant
#                   (key, value, unit; n/a where the item does not apply on that plant) and
#                   ledger.plant_note; ledger.book and the charts ledger.cum, ledger.compare

units:
  nav_lab_stats:
    args: { title: Stats, id: nav_lab_stats }
    window: "{title}"
    id: "{id}"
    size: [600, 400]
    visible_when: (= (state-get "arms.on") "1")
    children:
      - text: "a row per arm, this leg: clearance (m), ticks penetrating, path (m),"
      - text: "elapsed (s, to the goal once there), wall time per tick (ms), reached"
      - text: ""
        bind: arms.time
      - type: group
        layout: { kind: grid, col_widths: [88, 60, 54, 54, 40, 56, 58, 60, 52] }
        children:
          - text: "arm"
          - text: "colour"
          - text: "min"
          - text: "mean"
          - text: "pen"
          - text: "path"
          - text: "elapsed"
          - text: "ms/tick"
          - text: "reached"
      - type: group
        repeat: (state-get "arms.stats")
        layout: { kind: grid, col_widths: [88, 60, 54, 54, 40, 56, 58, 60, 52] }
        children:
          - text: ""
            bind: arms.stats.{i}.arm
          - text: ""
            bind: arms.stats.{i}.colour
          - text: ""
            bind: arms.stats.{i}.clear_min
          - text: ""
            bind: arms.stats.{i}.clear_mean
          - text: ""
            bind: arms.stats.{i}.pen
          - text: ""
            bind: arms.stats.{i}.path
          - text: ""
            bind: arms.stats.{i}.elapsed
          - text: ""
            bind: arms.stats.{i}.ms
          - text: ""
            bind: arms.stats.{i}.reached
      - separator
      - type: group
        visible_when: (= (state-get "arms.live") "1")
        children:
          - input_text: Goal (x, y)
            bind: arms.goal
            tooltip: "where the next Retarget sends every arm (m); empty: the host picks a free point"
          - button: Retarget every arm
            on: arms.retarget
            tooltip: "every arm's goal moves on the same tick, and a new leg starts"
      - text: ""
        bind: arms.status
      - combo: Follow
        bind: view.arm
        options: (string.split (state-get "arms.names") "\n")
        tooltip: "the arm the camera follows"
      - type: group
        visible_when: (has? "chart")
        children:
          - chart: Clearance (m), every arm
            bind: arms.clearance
            legend: right
            x_label: time (s)
            cursor: play.t
            pick: play.seek
            on: arms.seek
            height: 110

  nav_lab_ledger:
    args: { title: Ledger, id: nav_lab_ledger }
    window: "{title}"
    id: "{id}"
    size: [640, 560]
    visible_when: (= (state-get "arms.on") "1")
    children:
      - text: "per arm, this tick: the coefficients in force and the terms of U_nav"
      - input_text: Agent of each arm
        bind: ledger.vehicle
        visible_when: (!= (state-get "arms.agents") "1")
        tooltip: "which agent of each arm the Ledger shows (0, 1, ...)"
      - type: group
        layout: { kind: grid, col_widths: [96, 64, 64, 64, 68, 68, 56] }
        children:
          - text: "arm"
          - text: "alpha"
          - text: "beta"
          - text: "gamma"
          - text: "lam_soft"
          - text: "lam_hard"
          - text: "mu"
      - type: group
        repeat: (state-get "ledger.coef")
        layout: { kind: grid, col_widths: [96, 64, 64, 64, 68, 68, 56] }
        children:
          - text: ""
            bind: ledger.coef.{i}.arm
          - text: ""
            bind: ledger.coef.{i}.alpha
          - text: ""
            bind: ledger.coef.{i}.beta
          - text: ""
            bind: ledger.coef.{i}.gamma
          - text: ""
            bind: ledger.coef.{i}.lam_soft
          - text: ""
            bind: ledger.coef.{i}.lam_hard
          - text: ""
            bind: ledger.coef.{i}.mu
      - type: group
        layout: { kind: grid, col_widths: [96, 64, 64, 70, 56, 56, 60] }
        children:
          - text: "arm"
          - text: "U"
          - text: "goal"
          - text: "barrier"
          - text: "soft"
          - text: "hard"
          - text: "terrain"
      - type: group
        repeat: (state-get "ledger.terms")
        layout: { kind: grid, col_widths: [96, 64, 64, 70, 56, 56, 60] }
        children:
          - text: ""
            bind: ledger.terms.{i}.arm
          - text: ""
            bind: ledger.terms.{i}.potential
          - text: ""
            bind: ledger.terms.{i}.u_goal
          - text: ""
            bind: ledger.terms.{i}.u_barrier
          - text: ""
            bind: ledger.terms.{i}.u_soft
          - text: ""
            bind: ledger.terms.{i}.u_hard
          - text: ""
            bind: ledger.terms.{i}.u_terrain
      - separator
      - text: "the books against U_nav (unit mass, normalized units):"
      - text: "dU = drive + projection + context + residual; dH = dKE + dU. Summed over the run:"
      - type: group
        layout: { kind: grid, col_widths: [96, 64, 64, 76, 64, 60, 64] }
        children:
          - text: "arm"
          - text: "dU"
          - text: "drive"
          - text: "projection"
          - text: "context"
          - text: "dKE"
          - text: "residual"
      - type: group
        repeat: (state-get "ledger.books")
        layout: { kind: grid, col_widths: [96, 64, 64, 76, 64, 60, 64] }
        children:
          - text: ""
            bind: ledger.books.{i}.arm
          - text: ""
            bind: ledger.books.{i}.dU
          - text: ""
            bind: ledger.books.{i}.drive
          - text: ""
            bind: ledger.books.{i}.projection
          - text: ""
            bind: ledger.books.{i}.context
          - text: ""
            bind: ledger.books.{i}.dKE
          - text: ""
            bind: ledger.books.{i}.residual
      - text: "this tick:"
      - type: group
        repeat: (state-get "ledger.tick")
        layout: { kind: grid, col_widths: [96, 64, 64, 76, 64, 60, 64] }
        children:
          - text: ""
            bind: ledger.tick.{i}.arm
          - text: ""
            bind: ledger.tick.{i}.dU
          - text: ""
            bind: ledger.tick.{i}.drive
          - text: ""
            bind: ledger.tick.{i}.projection
          - text: ""
            bind: ledger.tick.{i}.context
          - text: ""
            bind: ledger.tick.{i}.dKE
          - text: ""
            bind: ledger.tick.{i}.residual
      - separator
      - combo: Arm
        bind: ledger.agent
        options: (string.split (state-get "arms.names") "\n")
        tooltip: "the arm whose plant ledger and cumulative books show below"
      - type: group
        visible_when: (has? "chart")
        children:
          - chart: Its books, cumulative
            bind: ledger.cum
            legend: right
            x_label: time (s)
            cursor: play.t
            pick: play.seek
            on: arms.seek
            height: 110
          - combo: Book
            bind: ledger.book
            options: [dU, drive, projection, context, dKE, residual]
          - chart: That book, cumulative, every arm
            bind: ledger.compare
            legend: right
            x_label: time (s)
            cursor: play.t
            pick: play.seek
            on: arms.seek
            height: 110
      - text: ""
        bind: ledger.plant_note
      - type: group
        repeat: (state-get "ledger.plant")
        layout: { kind: grid, col_widths: [170, 90, 60] }
        children:
          - text: ""
            bind: ledger.plant.{i}.key
          - text: ""
            bind: ledger.plant.{i}.value
          - text: ""
            bind: ledger.plant.{i}.unit
