# volume_grid.ari — a REUSABLE Ariadne component: VolumeGridRover for a `type: volume_grid` node
# (cvc::gl::VolumeGridNode, docs/roadmap/VOLROVER-LIBRARY-PORTS-ROADMAP.md §4). Slice views down the
# volume's axes with a 3D view beside them, the tool (navigate / points / probe / contours), and a
# side panel: the probe and the planes, the point classes, the contours and their tiled surfaces,
# the transfer function and the segmentation (its Segmentation tab, volume_grid_segmentation.ari).
# Every control binds a key the node owns (graphics.root.children.<node>.grid.*, VolumeGridNode.h
# and VolumeGridContours.h), and the views write their picks and the pointer to the node's
# grid.pick and grid.pointer, so it runs with NO host C++.
#
# The grid reads no file: it shows the volume the app holds (the node's source: { data: <name> },
# a data: entry the document loads), and follows it as it changes. With more than one volume
# loaded, the Probe tab's Source combo picks which: it lists the document's data: entries that
# hold a volume (the node's grid.volumes) and writes grid.source.volume. The panel's Save and Load go
# through the app too: Save writes what the node publishes (grid.points, grid.session) with
# (data-save ...), beside the document or, in a browser, as a download; Load loads the file as
# the dataset <node>_points or <node>_session with (data-load ...) and points the node's
# grid.source.points or grid.source.session at it.
#
#   In a slice view, with the Points tool:
#     click                 mark a point of the current class, or unmark the one under the pointer
#     drag                  select the points in a rubber band (Shift adds, Ctrl or Alt takes away)
#     Shift+Ctrl drag       move the selection
#   With the Contours tool:
#     click                 a point of the current object's curve on this plane (at the end being
#                           drawn, else at the nearer end of its open curve here, else a new curve)
#     click the first point close the curve (three points or more)
#     Shift+click           start another curve
#     drag a point          move it (the selection, when the point is in it)
#     drag elsewhere        select control points in a rubber band (Shift adds, Ctrl or Alt takes away)
#   With Navigate, a click moves the other two planes to the voxel. The middle or right button pans,
#   the wheel zooms about the pointer. The probe follows the pointer in every tool.
#
# The views come in two layouts (the `layout` arg): `switch` (the default, as VolumeGridRover had
# it) is one slice view under an XY / XZ / ZY switch bound to grid.view, beside the 3D view; `quad`
# is the XY, XZ and ZY views and the 3D view in a 2 x 2 grid. Under each slice view a slider moves
# its plane; the sliders take their ranges from the keys (range: key), which the node keeps at the
# volume's planes.
#
# Units:
#   volume_grid         the whole tool in one window
#   volume_grid_views   the views alone (a group: for a document that lays out its own windows)
#   volume_grid_tools   the tool and the side panel alone (a group); its tabs end in a
#                       `slot: tabs`, so an include adds tabs of its own (`slots: { tabs: [...] }`)
#   volume_grid_contours_tab
#                       the Contours tab alone (a group with `tab: Contours`): the objects (name,
#                       colour, linear or spline, samples, shown), the curve being drawn, the edits,
#                       how they draw, Tile with its progress and Stop, the surfaces' look, and the
#                       contours saved and loaded through the app
#
# Args (every one has a default, so a bare include works):
#   node       the volume_grid node's id (default grid)
#   title      the window's title (default Volume grid)
#   id         the instance id: view names, window geometry and widget state persist under it
#              (default volume_grid); give each include its own when a document has several grids
#   view_size  a slice view's width and height in pixels (default 360; quad: each of the four)
#   layout     switch | quad (default switch)
#
# Use it:
#     import: cvc://components/volume_grid.ari
#     data:
#       head: head.rawiv                  # the app loads the volume
#     windows:
#       - include: volume_grid
#     scene:
#       nodes:
#         - node: grid
#           type: volume_grid
#           source: { data: head }        # and the grid shows it
#           classes: [ { name: membrane, color: [1, 0.2, 0.2], radius: 2 } ]
#           objects: [ { name: axon, color: [0.2, 0.8, 0.3], interpolation: spline } ]
#
# Two grids: give each include its node and id; each view shows its own grid alone (show: [node]).
# Keyboard: a document binds keys to requests (`keys:`), as examples/ariadne/documents/volume_grid.ari
# does: PageUp / PageDown write `step 1` / `step -1`, Delete `delete_selected` (the contours' selected
# points under the Contours tool).
#
# The Segmentation tab (volume_grid_segmentation.ari) segments the volume from the shown point
# classes (the grid's `segment` request): the labels draw on the slices, each class's surface in the
# 3D view. Stop ends a segmentation and a tile alike.
#
# Contours: Tile runs the contour tiler on the closed curves (a sliced task, its keys under
# grid.tile) and puts a surface per object in the 3D view in the object's colour. Save writes the z
# planes' closed curves (grid.contours) through the app as .cvcc, .contour or .pcd; Load loads a
# contour file (.ser, .contour, .cvcc, ...) as the dataset <node>_contours and points the node's
# grid.contour.source at it, so its polygons become closed curves on the grid's planes. A session
# keeps every curve as drawn, open ones and splines included.

import:
  - cvc://components/transfer_function.ari
  - cvc://components/volume_grid_segmentation.ari

units:
  volume_grid:
    args: { node: grid, title: Volume grid, id: volume_grid, view_size: 360, layout: switch }
    window: "{title}"
    id: "{id}"
    children:
      - type: group
        id: "{id}_body"
        layout: { kind: horizontal }
        children:
          - include: volume_grid_views
            args: { node: "{node}", id: "{id}", view_size: "{view_size}", layout: "{layout}" }
          - include: volume_grid_tools
            args: { node: "{node}", id: "{id}" }

  volume_grid_views:
    args: { node: grid, id: volume_grid, view_size: 360, layout: switch }
    type: group
    id: "{id}_views"
    children:
      # switch: one slice view down the axis grid.view names, the 3D view beside it.
      - type: group
        id: "{id}_switch"
        visible_when: (!= "{layout}" "quad")
        layout: { kind: horizontal }
        children:
          - type: group
            id: "{id}_switch_slice"
            children:
              - tabs: View
                id: "{id}_view_switch"
                bind: graphics.root.children.{node}.grid.view
                options: [XY, XZ, ZY]
                values: [xy, xz, zy]
              - type: viewport
                view: "{id}_slice"
                mode: slice
                axis:
                  bind: graphics.root.children.{node}.grid.view
                show: ["{node}"]
                hide: [surfaces]
                input: pick
                pick: graphics.root.children.{node}.grid.pick
                pointer: graphics.root.children.{node}.grid.pointer
                chrome: false
                clear_color: [0.04, 0.045, 0.06]
                width: "{view_size}"
                height: "{view_size}"
                caption: "click: mark   drag: select   middle: pan   wheel: zoom"
              - slider_int: Z plane
                bind: graphics.root.children.{node}.grid.slice.z
                range: key
                hi: 1000
                visible_when: (= (state-get "graphics.root.children.{node}.grid.view") "xy")
              - slider_int: Y plane
                bind: graphics.root.children.{node}.grid.slice.y
                range: key
                hi: 1000
                visible_when: (= (state-get "graphics.root.children.{node}.grid.view") "xz")
              - slider_int: X plane
                bind: graphics.root.children.{node}.grid.slice.x
                range: key
                hi: 1000
                visible_when: (= (state-get "graphics.root.children.{node}.grid.view") "zy")
          - type: viewport
            view: "{id}_3d"
            show: ["{node}"]
            chrome: false
            clear_color: [0.04, 0.045, 0.06]
            width: "{view_size}"
            height: "{view_size}"
            zoom: 0.6
            caption: "drag: orbit   wheel: zoom"
      # quad: XY | XZ over ZY | 3D: two rows, each flowing side by side. Not a table: a table
      # spans the window's width, which would push the tools off it.
      - type: group
        id: "{id}_quad"
        visible_when: (= "{layout}" "quad")
        children:
          - type: group
            id: "{id}_quad_top"
            layout: { kind: horizontal }
            children:
              - type: group
                id: "{id}_quad_xy"
                children:
                  - type: viewport
                    view: "{id}_xy"
                    mode: slice
                    axis: z
                    show: ["{node}"]
                    hide: [surfaces]
                    input: pick
                    pick: graphics.root.children.{node}.grid.pick
                    pointer: graphics.root.children.{node}.grid.pointer
                    chrome: false
                    clear_color: [0.04, 0.045, 0.06]
                    width: "{view_size}"
                    height: "{view_size}"
                    caption: XY
                  - slider_int: Z plane
                    bind: graphics.root.children.{node}.grid.slice.z
                    range: key
                    hi: 1000
              - type: group
                id: "{id}_quad_xz"
                children:
                  - type: viewport
                    view: "{id}_xz"
                    mode: slice
                    axis: y
                    show: ["{node}"]
                    hide: [surfaces]
                    input: pick
                    pick: graphics.root.children.{node}.grid.pick
                    pointer: graphics.root.children.{node}.grid.pointer
                    chrome: false
                    clear_color: [0.04, 0.045, 0.06]
                    width: "{view_size}"
                    height: "{view_size}"
                    caption: XZ
                  - slider_int: Y plane
                    bind: graphics.root.children.{node}.grid.slice.y
                    range: key
                    hi: 1000
          - type: group
            id: "{id}_quad_bottom"
            layout: { kind: horizontal }
            children:
              - type: group
                id: "{id}_quad_zy"
                children:
                  - type: viewport
                    view: "{id}_zy"
                    mode: slice
                    axis: x
                    show: ["{node}"]
                    hide: [surfaces]
                    input: pick
                    pick: graphics.root.children.{node}.grid.pick
                    pointer: graphics.root.children.{node}.grid.pointer
                    chrome: false
                    clear_color: [0.04, 0.045, 0.06]
                    width: "{view_size}"
                    height: "{view_size}"
                    caption: ZY
                  - slider_int: X plane
                    bind: graphics.root.children.{node}.grid.slice.x
                    range: key
                    hi: 1000
              - type: viewport
                view: "{id}_quad_3d"
                show: ["{node}"]
                chrome: false
                clear_color: [0.04, 0.045, 0.06]
                width: "{view_size}"
                height: "{view_size}"
                zoom: 0.6
                caption: 3D

  volume_grid_tools:
    args: { node: grid, id: volume_grid }
    type: group
    id: "{id}_tools"
    children:
      - radio_row: Tool
        bind: graphics.root.children.{node}.grid.tool
        options: [Navigate, Points, Probe, Contours]
        values: [navigate, points, probe, contours]
        tooltip: "what a click in a slice view does: move the other planes there, mark and select points, only read the voxel, or draw the current object's curves"
      - type: tabs
        id: "{id}_panel"
        children:
          - type: group
            tab: Probe
            children:
              - type: group
                id: "{id}_probe_voxel"
                layout: { kind: horizontal }
                children:
                  - text: i
                    bind: graphics.root.children.{node}.grid.cursor.i
                  - text: j
                    bind: graphics.root.children.{node}.grid.cursor.j
                  - text: k
                    bind: graphics.root.children.{node}.grid.cursor.k
              - text: Value
                bind: graphics.root.children.{node}.grid.cursor.value
              - type: group
                id: "{id}_probe_position"
                layout: { kind: horizontal }
                children:
                  - text: x
                    bind: graphics.root.children.{node}.grid.cursor.x
                  - text: y
                    bind: graphics.root.children.{node}.grid.cursor.y
                  - text: z
                    bind: graphics.root.children.{node}.grid.cursor.z
              - separator
              - slider_int: X plane
                bind: graphics.root.children.{node}.grid.slice.x
                range: key
                hi: 1000
              - slider_int: Y plane
                bind: graphics.root.children.{node}.grid.slice.y
                range: key
                hi: 1000
              - slider_int: Z plane
                bind: graphics.root.children.{node}.grid.slice.z
                range: key
                hi: 1000
              - checkbox: Crosshairs
                bind: graphics.root.children.{node}.grid.display.crosshairs
              - checkbox: Grey
                bind: graphics.root.children.{node}.grid.display.grey
                tooltip: "draw the slices in grey, not through the transfer function"
              - separator
              - text: Volume
                bind: graphics.root.children.{node}.grid.info.dims
              - type: group
                id: "{id}_range"
                layout: { kind: horizontal }
                children:
                  - text: Min
                    bind: graphics.root.children.{node}.grid.info.min
                  - text: Max
                    bind: graphics.root.children.{node}.grid.info.max
              - combo: Source
                bind: graphics.root.children.{node}.grid.source.volume
                options: (string.split (state-get "graphics.root.children.{node}.grid.volumes") "\n")
                visible_when: (!= (or (state-get "graphics.root.children.{node}.grid.volumes") "") "")
                tooltip: "the state key the volume is at: the app holds it (a data: entry, a program, a filter) and the grid follows it. Pick another of the document's volumes to show it"
              - text: Source
                bind: graphics.root.children.{node}.grid.info.source
                visible_when: (= (or (state-get "graphics.root.children.{node}.grid.volumes") "") "")
                tooltip: "the state key the volume is at: the app holds it (a data: entry, a program, a filter) and the grid follows it"
              - separator
              - input_text: Session
                bind: graphics.root.children.{node}.grid.files.session
                tooltip: "a session file (JSON): the grid's keys, its transfer function and its point classes"
              - button: Save session
                on: (data-save "graphics.root.children.{node}.grid.session" (state-get "graphics.root.children.{node}.grid.files.session") "volume_grid_session")
                tooltip: "the app writes the session (grid.session): beside the document, or in a browser as a download"
              - button: Load session
                on: (begin (data-load "{node}_session" (state-get "graphics.root.children.{node}.grid.files.session") "volume_grid_session") (data-reload "{node}_session") (state-set "graphics.root.children.{node}.grid.source.session" "data.{node}_session.session"))
                tooltip: "the app loads the file as data.{node}_session, and the grid applies it"
          - type: group
            tab: Point classes
            children:
              - list: Classes
                bind: graphics.root.children.{node}.grid.classes
                add: true
                remove: true
                new_item: { name: "class {n}", radius: "1" }
                rows: 5
                tooltip: "the class a click marks; Add and Remove edit the classes (Undo puts them back)"
              - type: group
                id: "{id}_class_head"
                layout: { kind: grid, col_widths: [110, 140, 80, 50] }
                children:
                  - text: name
                  - text: colour
                  - text: radius
                  - text: pts
              - type: group
                id: "{id}_class_{i}"
                repeat: (int (state-get "graphics.root.children.{node}.grid.classes"))
                layout: { kind: grid, col_widths: [110, 140, 80, 50] }
                children:
                  - input_text: "##name{i}"
                    bind: graphics.root.children.{node}.grid.classes.{i}.name
                  - color: "##colour{i}"
                    bind: graphics.root.children.{node}.grid.classes.{i}.color
                    fmt: hex
                  - slider_float: "##radius{i}"
                    bind: graphics.root.children.{node}.grid.classes.{i}.radius
                    lo: 0.5
                    hi: 10.0
                    fmt: "%.1f"
                  - text: ""
                    bind: graphics.root.children.{node}.grid.classes.{i}.points
              - text: Selected
                bind: graphics.root.children.{node}.grid.selection.count
              - type: group
                id: "{id}_selection"
                layout: { kind: horizontal }
                children:
                  - button: All
                    on: (state-set "graphics.root.children.{node}.grid.request" "select_all")
                  - button: None
                    on: (state-set "graphics.root.children.{node}.grid.request" "select_none")
                  - button: Delete
                    on: (state-set "graphics.root.children.{node}.grid.request" "delete_selected")
                    tooltip: "delete the selected points"
                  - button: Undo
                    on: (state-set "graphics.root.children.{node}.grid.request" "undo")
              - checkbox: Show points
                bind: graphics.root.children.{node}.grid.display.show_points
              - slider_float: Point scale
                bind: graphics.root.children.{node}.grid.display.point_scale
                range: key
                lo: 0.1
                hi: 10.0
                fmt: "%.1f"
                tooltip: "every class's radius times this, as its points draw and as a click finds them"
              - separator
              - input_text: Classes file
                bind: graphics.root.children.{node}.grid.files.classes
                tooltip: "a .vgr file (VolumeGridRover's point classes)"
              - type: group
                id: "{id}_class_files"
                layout: { kind: horizontal }
                children:
                  - button: Save
                    on: (data-save "graphics.root.children.{node}.grid.points" (state-get "graphics.root.children.{node}.grid.files.classes") "point_classes")
                    tooltip: "the app writes the classes (grid.points) as a .vgr: beside the document, or in a browser as a download"
                  - button: Load
                    on: (begin (data-load "{node}_points" (state-get "graphics.root.children.{node}.grid.files.classes") "point_classes") (data-reload "{node}_points") (state-set "graphics.root.children.{node}.grid.source.points" "data.{node}_points.classes"))
                    tooltip: "the app loads the file as data.{node}_points, and its classes replace the grid's"
          - include: volume_grid_contours_tab
            tab: Contours                   # a tab's title is read where it is listed
            args: { node: "{node}", id: "{id}" }
          - type: group
            tab: Transfer function
            children:
              - combo: 3D volume
                bind: graphics.root.children.{node}.grid.display.render
                options: [None, VTK, volren, volslice]
                values: [none, vtk, volren, volslice]
                tooltip: "what draws the volume in the 3D view beside the planes, through this transfer function: VTK's GPU mapper, libcvc's raycaster (volren) or view-aligned texture slices (volslice)"
              - text: Renderer
                bind: graphics.root.children.{node}.children.surfaces.children.volume.status
                tooltip: "what draws the volume now, or what it waits for"
              - include: transfer_function_editor
                args: { node: "{node}", id: "{id}_tf", label: Colours }
          - include: volume_grid_segmentation_tab
            tab: Segmentation
            args: { node: "{node}", id: "{id}" }
          - slot: tabs
      - text: Status
        bind: graphics.root.children.{node}.grid.status

  volume_grid_contours_tab:
    args: { node: grid, id: volume_grid }
    type: group
    id: "{id}_contours"
    tab: Contours
    children:
      - list: Objects
        bind: graphics.root.children.{node}.grid.objects
        add: true
        remove: true
        new_item: { name: "object {n}", interpolation: linear, samples: "5", visible: "1" }
        rows: 4
        tooltip: "the object a click draws (with the Contours tool); Add and Remove edit the objects (Undo puts them back)"
      # Two short rows an object (the colour editor is wide): its name and colour; then how its curves
      # draw, a spline's samples, whether it shows, and how many curves it has.
      - type: group
        id: "{id}_object_{i}"
        repeat: (int (state-get "graphics.root.children.{node}.grid.objects"))
        children:
          - type: group
            id: "{id}_object_{i}_a"
            layout: { kind: grid, col_widths: [110, 250] }
            children:
              - input_text: "##oname{i}"
                bind: graphics.root.children.{node}.grid.objects.{i}.name
              - color: "##ocolour{i}"
                bind: graphics.root.children.{node}.grid.objects.{i}.color
          - type: group
            id: "{id}_object_{i}_b"
            layout: { kind: grid, col_widths: [96, 110, 30, 100] }
            children:
              - combo: "##ointerp{i}"
                bind: graphics.root.children.{node}.grid.objects.{i}.interpolation
                options: [linear, spline]
                values: [linear, spline]
                tooltip: "straight between the control points, or a spline through them"
              - slider_int: "##osamples{i}"
                bind: graphics.root.children.{node}.grid.objects.{i}.samples
                lo: 1
                hi: 16
                tooltip: "points per span of a spline"
              - checkbox: "##oshow{i}"
                bind: graphics.root.children.{node}.grid.objects.{i}.visible
                tooltip: "show its curves and surface"
              - text: curves
                bind: graphics.root.children.{node}.grid.objects.{i}.curves
      - text: Drawing
        bind: graphics.root.children.{node}.grid.contour.active
        tooltip: "the curve the next click extends"
      - text: Contours
        bind: graphics.root.children.{node}.grid.contour.info
      - type: group
        id: "{id}_curve_edits"
        layout: { kind: horizontal }
        children:
          - button: Close
            on: (state-set "graphics.root.children.{node}.grid.request" "close_curve")
            tooltip: "close the curve being drawn (or click its first point)"
          - button: New curve
            on: (state-set "graphics.root.children.{node}.grid.request" "new_curve")
            tooltip: "the next click starts a new curve"
          - button: Delete curve
            on: (state-set "graphics.root.children.{node}.grid.request" "delete_curve")
            tooltip: "delete the curve being drawn, or the curves of the selected points"
          - button: Clear
            on: (state-set "graphics.root.children.{node}.grid.request" "clear_object")
            tooltip: "delete every curve of the current object"
      - type: group
        id: "{id}_point_edits"
        layout: { kind: horizontal }
        children:
          - text: Selected
            bind: graphics.root.children.{node}.grid.contour.selected
          - button: Delete points
            on: (begin (state-set "graphics.root.children.{node}.grid.tool" "contours") (state-set "graphics.root.children.{node}.grid.request" "delete_selected"))
            tooltip: "delete the selected control points"
          - button: Undo
            on: (begin (state-set "graphics.root.children.{node}.grid.tool" "contours") (state-set "graphics.root.children.{node}.grid.request" "undo"))
      - type: group
        id: "{id}_contour_view"
        layout: { kind: horizontal }
        children:
          - checkbox: Curves
            bind: graphics.root.children.{node}.grid.contour.show
          - checkbox: Points
            bind: graphics.root.children.{node}.grid.contour.control_points
          - checkbox: In 3D
            bind: graphics.root.children.{node}.grid.contour.show_3d
          - checkbox: Snap
            bind: graphics.root.children.{node}.grid.contour.snap
            tooltip: "put new and moved points on voxel centres"
      - slider_float: Point size
        bind: graphics.root.children.{node}.grid.contour.point_size
        range: key
        lo: 0.1
        hi: 10.0
        fmt: "%.1f"
        tooltip: "a control point's radius in voxels; a click takes a point within 1.5 times it"
      - separator
      - type: group
        id: "{id}_tile"
        layout: { kind: horizontal }
        children:
          - button: Tile
            on: (state-set "graphics.root.children.{node}.grid.request" "tile")
            disabled_when: (= (state-get "graphics.root.children.{node}.grid.tile.busy") "1")
            tooltip: "tile each object's closed curves into a surface in the 3D view"
          - button: Stop
            on: (state-set "graphics.root.children.{node}.grid.request" "stop_tile")
            enabled_when: (= (state-get "graphics.root.children.{node}.grid.tile.stoppable") "1")
            tooltip: "end the tile at its next step, keeping the surfaces the grid had"
          - checkbox: Auto
            bind: graphics.root.children.{node}.grid.contour.auto_tile
            tooltip: "tile each time the contours are replaced (loaded, a session, a program)"
      - progress: Tiling
        bind: graphics.root.children.{node}.grid.tile.progress
        hi: 100
        overlay: graphics.root.children.{node}.grid.tile.phase
      - text: Tile
        bind: graphics.root.children.{node}.grid.tile.status
        tooltip: "what the last tile made (grid.tile.warnings.<i>: what it skipped)"
      - slider_float: Curation distance
        bind: graphics.root.children.{node}.grid.tile.curation_delta
        lo: 0.0
        hi: 0.5
        fmt: "%.4f"
        tooltip: "the least distance kept between curves of one plane, in object units (0: no curation); less than the slice spacing; ctrl-click to type"
      - type: group
        id: "{id}_surface_view"
        layout: { kind: horizontal }
        children:
          - checkbox: Surfaces
            bind: graphics.root.children.{node}.grid.contour.show_surfaces
          - checkbox: Close ends
            bind: graphics.root.children.{node}.grid.tile.cap_ends
            tooltip: "cap every object beyond its first and last curve"
      - slider_float: Surface opacity
        bind: graphics.root.children.{node}.grid.contour.surface_opacity
        lo: 0.0
        hi: 1.0
        fmt: "%.2f"
      - separator
      - input_text: Contours file
        bind: graphics.root.children.{node}.grid.files.contours
        tooltip: "a contour file: .cvcc (libcvc's), .contour (ctr2suf) or .pcd to save; .ser, .contour, .cvcc and the others to load"
      - type: group
        id: "{id}_contour_files"
        layout: { kind: horizontal }
        children:
          - button: Save
            on: (data-save "graphics.root.children.{node}.grid.contours" (state-get "graphics.root.children.{node}.grid.files.contours") "contours")
            tooltip: "the app writes the z planes' closed curves (grid.contours): beside the document, or in a browser as a download"
          - button: Load
            on: (begin (data-load "{node}_contours" (state-get "graphics.root.children.{node}.grid.files.contours") "contours") (data-reload "{node}_contours") (state-set "graphics.root.children.{node}.grid.contour.source" "data.{node}_contours.contours"))
            tooltip: "the app loads the file as data.{node}_contours, and its polygons become the grid's curves"
