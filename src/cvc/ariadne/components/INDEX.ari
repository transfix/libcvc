# INDEX.ari — the manifest of the Ariadne reusable component library shipped with libcvc/pycvc.
#
# Each component is a `units:` window fragment a document imports by the location-independent cvc://
# scheme and includes at the top level:
#
#     import: cvc://components/<file>.ari
#     windows:
#       - include: <unit>            # or, parametrized:  { include: <unit>, args: { node: myNode } }
#
# A parametrized unit declares its args with defaults (an entry's `args:` map lists them), so a bare
# include loads and an include site overrides only what it needs. A few components also ship a
# bare-widget unit (no window) to embed in a document's own window.
#
# Every control binds a two-way cvc::state key the corresponding C++ object owns, so a component
# drives the live scene/camera/renderer with NO host C++ — the declarative replacement for the
# hand-written C++ panels (cvc::gl::ui::*). This file is data-only (a catalog tooling/pycvc can read
# to list the library); loading it registers no widgets.

meta:
  name: Ariadne component library
  description: Reusable .ari UI components shipped with libcvc/pycvc (import via cvc://components/…).
  min_libcvc: 3.4.0

# catalog: one entry per shipped component — its file, the unit to include, the state-key subtree it
# drives, the demos/objects it fits, and any include args. Read by tooling; not a widget tree.
catalog:
  - component: stage_lighting
    file: stage_lighting.ari
    unit: stage_lighting
    binds: "<prefix>.lighting.*"           # cvc::gl::StageLighting rig
    for: "any scene with a `rig:` StageLighting light"
    args: []
  - component: scene_controls
    file: scene_controls.ari
    unit: scene_controls
    binds: "<prefix>.shadows.*"            # cvc::gl::ShadowSettings
    for: "any scene with `shadows:`"
    args: { title: Scene, id: scene_controls }   # defaults
    note: "shadow_settings is its widgets without the window"
  - component: camera_controls
    file: camera_controls.ari
    unit: camera_controls
    binds: "<prefix>.viewers.{viewer}.camera.settings.*"   # cvc::gl::CameraController
    for: "any scene with a navigable camera"
    args: { viewer: main, title: Camera, id: camera_controls }   # defaults
    note: "camera_settings is its widgets without the window (args: viewer)"
  - component: viewer_settings
    file: viewer_settings.ari
    unit: viewer_settings
    binds: "<prefix>.viewers.{viewer}.{hud.enabled,hud.fps,ui.scale,ui.scroll_friction,camera.settings.*}, <prefix>.graphics.root.{show_bbox,children.grid.visible,children.axis.visible}, <prefix>.shadows.*"
    for: "any scene: one settings window for a viewer (frame-rate readout, UI size, scroll friction on a touch screen, grid / axis / scene bounds, camera, shadows)"
    args: { viewer: main, title: Viewer, id: viewer_settings }   # defaults
    note: "imports camera_controls.ari and scene_controls.ari for its Camera and Shadows sections; FpsHud, UiSettings, GridNode, AxisNode, CameraController and ShadowSettings own the keys"
  - component: display_toggles
    file: display_toggles.ari
    unit: display_toggles
    binds: "<prefix>.show.{agents,paths,grid}"   # each paired with a scene node `visible:` on the same key
    for: "toggling scene layers on/off (bind a node's visible: to the same show.* key)"
    args: []
  - component: sim_transport
    file: sim_transport.ari
    unit: sim_transport
    binds: "<prefix>.sim.{paused,speed}"         # the clock reads these; sim.step/sim.restart are built in
    for: "pause/speed/step/restart of a host sim loop"
    args: []
    verbs: [sim.step, sim.restart]         # bare-name on: AppRuntime's own, or a host's Runtime::on
  - component: raster_view
    file: raster_view.ari
    unit: raster_view
    binds: "<prefix>.{keys}.{image,colormap}"    # host: colorize a grid -> backend.set_image(name,img)
    for: "a live image/raster viewer (nav grids, textures) with a colormap menu"
    args: { keys: raster, title: Raster, id: raster_view }   # defaults
    note: "needs a host that publishes named cvc::images (ImGuiBackend::set_image) each frame"
  - component: volren_controls
    file: volren_controls.ari
    unit: volren_controls
    binds: "<prefix>.graphics.root.children.{node}.volren.*"   # cvc::volren::state_settings
    for: "a `type: volren` node (steps / ambient / supersample / volumetric shadows)"
    args: { node: bunny_volume, title: Volume raycast, id: volren_controls }   # defaults
  - component: volslice_controls
    file: volslice_controls.ari
    unit: volslice_controls
    binds: "<prefix>.graphics.root.children.{node}.volslice.*" # cvc::volslice::state_settings
    for: "a `type: volslice` node (quality / near-plane peel / max planes)"
    args: { node: bunny_volume, title: Volume slices, id: volslice_controls }   # defaults
  - component: forest_controls
    file: forest_controls.ari
    unit: forest_controls
    binds: "<prefix>.{keys}.*"             # read every frame by the cvcGL forest_trees realizer
    for: "a `type: forest_trees` node (count / seed / species / span / branching / wind)"
    args: { keys: forest, title: Forest, id: forest_controls }   # defaults; keys = the node's `keys:` prop
    note: "the realizer seeds forest.* from the node props; structural edits re-grow the mesh"
  - component: world_controls
    file: world_controls.ari
    unit: world_controls
    binds: "<prefix>.{keys}.*"              # read every frame by the generated_world node, drawn or headless
    for: "a `type: generated_world` node (seed / preset / size / counts / relief / water / colour)"
    args: { keys: world, title: Terrain Lab, id: world_controls }   # defaults; keys = the node's `keys:` prop
    note: "the realizer seeds world.* from the node props; structural edits regenerate the world; world_settings is its widgets without the window (args: keys)"
  - component: world_source
    file: world_source.ari
    unit: world_source
    binds: "<prefix>.scene.world.{source,sources,kind,ready,rev,status,grid.summary,file}, <prefix>.{keys}.*, <prefix>.data.{data}.*"
    for: "a scene with worlds (`world: <name>` on its nodes): pick the world on (generated, a data bundle, a terrain, a flat ground), its settings, Regenerate or load another bundle, and the ready revision other panels wait on"
    args: { keys: world, data: city, as: city_bundle, title: World, id: world_source }   # defaults
    note: "the world runtime (SceneWorld::bind_worlds) keeps the worlds off out of the physics world and undrawn, drawn or headless; world_source_controls is its widgets without the window"
  - component: world_physics
    file: world_physics.ari
    unit: world_physics
    binds: "<prefix>.{physics}.{enabled,stats.*}, <prefix>.sim.{paused,speed}"
    for: "a scene with a physics world: physics on / off, pause, speed, step and restart, and the world's stats (bodies, awake, contacts, step time and its plot, bodies by node)"
    args: { physics: physics, title: Physics, id: world_physics }   # defaults
    verbs: [sim.step, sim.restart]
    note: "world_physics_controls is its widgets without the window; the same keys run drawn or headless"
  - component: sea_controls
    file: sea_controls.ari
    unit: sea_controls
    binds: "<prefix>.{keys}.{wave_amp,sea_level}"   # read on every refill by the wave_sea realizer
    for: "a `type: wave_sea` node"
    args: { keys: sea, title: Sea, id: sea_controls }   # defaults; keys = the node's `keys:` prop
  - component: sky_controls
    file: sky_controls.ari
    unit: sky_controls
    binds: "<prefix>.{keys}.{drift,morph,evolve,orographic,shadow}"   # read every frame by the cloud_sky realizer
    for: "a `type: cloud_sky` node"
    args: { keys: sky, title: Sky, id: sky_controls }   # defaults; keys = the node's `keys:` prop
  - component: mesh_tools
    file: mesh_tools.ari
    unit: mesh_tools
    binds: "<prefix>.graphics.root.children.{node}.mesh_ops.*"   # the cvcGL mesh_lab realizer
    for: "a `type: mesh_lab` node (load a mesh; smooth / decimate / repair / orient; colour by curvature, geodesic distance or a Laplace-Beltrami eigenfunction)"
    args: { node: mesh, title: Mesh tools, id: mesh_tools }   # defaults
    note: "needs a CVC_ENABLE_LIBIGL build; commands are written to mesh_ops.request and run off the render thread"
  - component: fe_controls
    file: fe_controls.ari
    unit: fe_controls
    binds: "<prefix>.graphics.root.children.{node}.fe.*"       # the cvcGL fe_lab realizer
    for: "a `type: fe_lab` node (load an SDF or a volume; LBIE tet / hex mesh of a solid, or a tet mesh of the interval between two isovalues; P1 Poisson / heat / eigenmode solve; the field on the boundary and a cut, or the elements cut away)"
    args: { node: domain, title: Finite elements, id: fe_controls }   # defaults
    note: "needs a CVC_ENABLE_LIBIGL build (and CVC_ENABLE_MESHER to tet-mesh); commands go through fe.request"
  - component: transfer_function
    file: transfer_function.ari
    unit: transfer_function
    binds: "<prefix>.graphics.root.children.{node}.transfer_function (+ .range / .histogram / .contour_spectrum / .contour_tree / .overlay_request) and <prefix>.tree.{id}.view.*"
    for: "a volume-type node (volren / volslice / volume) or an fe_lab node: colour ramp, opacity curve and isocontours over histogram / contour spectrum / contour tree layers"
    args: { node: volume, title: Transfer Function, id: transfer_function }   # defaults
    note: "a window holding the tf_editor widget (the ColorTable2 port); every volume node publishes the model and the layers, so no host C++ is needed"
  - component: transfer_function_editor
    file: transfer_function.ari
    unit: transfer_function_editor
    binds: "<prefix>.graphics.root.children.{node}.transfer_function (+ the layers beside it) and <prefix>.tree.{id}.view.*"
    for: "the same editor without a window, to embed in a document's own window (several in one document: give each its own id)"
    args: { node: volume, label: Transfer function, id: transfer_function_editor }   # defaults
  - component: scene_view
    file: scene_view.ari
    unit: scene_view
    binds: "<prefix>.viewers.{view}.camera.*"   # the view's own CameraController
    for: "a second view of the scene in a window: an overview map, another angle, one layer (the nodes whose tags: it shows)"
    args: { view: scene_view, title: View, id: scene_view, show: "", hide: "", mode: orbit, camera: "", chrome: true, scene: "", shadows: true, caption: "", width: 360, height: 270 }   # defaults
    note: "the cvcGL `viewport` widget (AriRuntime hosts: arigl, pycvc_gl); a terminal backend shows a placeholder"
  - component: card
    file: card.ari
    unit: card
    binds: "the state keys its args name: {avatar} {title} {subtitle} {time} {body} (each optional)"
    for: "a card in a list (a post in a feed, a message, a search hit): a bordered block with an avatar / title / subtitle / timestamp header, a body, a media slot and an action row"
    args: { id: card, avatar: "", avatar_auth: "", avatar_size: 40, title: "", subtitle: "", time: "", body: "" }
    slots: [media, actions]                # widget lists the include site supplies (§6.1)
    note: "not a window: include it in a document's own window, once per item of a repeat: (id: post_{i})"
  - component: chat
    file: chat.ari
    unit: chat
    binds: "<prefix>.{id}.* (channel, pick, view.text, draft, read.*, unread.*) and <prefix>.tree.{id}.*"
    for: "a room's chat and its direct messages: a channel picker with unread counts, a log that asks for older messages when scrolled to the top, Enter to send and Shift+Enter for a new line"
    args: { id: chat, title: Chat, room: room.token }   # room: the key holding the room-join token
    verbs: [chat-post, chat-info, chat-messages, chat-more, chat-conversations, chat-rev]
    note: "call (chat-ui-step ID ROOM) from on_tick; the functions come with the import (room verbs: arigl joined to a relay)"
  - component: chat_panel
    file: chat.ari
    unit: chat_panel
    binds: "<prefix>.{id}.*"
    for: "the same chat without a window, to embed in a document's own window"
    args: { id: chat, room: room.token }
  - component: room_users
    file: room_users.ari
    unit: room_users
    binds: "<prefix>.{rows}.* rows, self.*, ctl.<pid>.* (local cam / mic / volume), media.<pid>.* (host)"
    for: "everyone in a room: video dot, name (green while talking; click for their camera window), link, local cam / mic / volume, and a message button that opens a conversation in the chat component"
    args: { id: users, title: Users, rows: peer, chat: chat, self: conf.self }
    verbs: [room-roster]
    note: "call (room-users-step ROWS ROOM CHAT) from on_tick; room_users_compact is the same list without the media columns"
