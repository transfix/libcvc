# volren_controls.ari — a REUSABLE Ariadne component: live controls for a `type: volren` node.
# Binds the two-way cvc::volren::state_settings keys (state at
# "<scene>.graphics.root.children.<node>.volren.*"), so a slider drives the software raycaster
# with NO host C++ — the declarative replacement for the volren_bunny.cpp "Volume raycast" panel.
#
# Args (every one has a default, so a bare include works):
#   node   the volren node's id (default bunny_volume)
#   title  the window's title (default Volume raycast)
#   id     the instance id: the window's geometry persists under tree.<id> (default volren_controls);
#          give each include its own when a document drives several volren nodes
#
# Use it:
#     import: components/volren_controls.ari
#     windows:
#       - include: volren_controls

units:
  volren_controls:
    args: { node: bunny_volume, title: Volume raycast, id: volren_controls }
    window: "{title}"
    id: "{id}"
    children:
      - slider_int: Steps
        bind: graphics.root.children.{node}.volren.steps
        lo: 64
        hi: 1024
        def: 384
      - slider_float: Ambient
        bind: graphics.root.children.{node}.volren.ambient
        lo: 0.0
        hi: 1.0
        def: 0.35
      - slider_int: Supersample (AA)
        bind: graphics.root.children.{node}.volren.supersample
        lo: 1
        hi: 4
        def: 1
      - checkbox: Volumetric shadows
        bind: graphics.root.children.{node}.volren.shadows.enabled
