# sky_controls.ari — a REUSABLE Ariadne component: live controls for a `cloud_sky` node. The widgets
# bind sky.* keys the cloud_sky realizer reads each frame: Drift / Morph scale the wind and the
# speed the clouds change shape at, Weather the speed clouds come and go at (the deck's cellular
# automaton; 0 holds them), Orographic how strongly the ground's windward flanks gather cloud, and
# Ground shadow toggles the clouds' shade live. (The cloud SHAPES are grown once — regenerating
# them is seconds of work, not a live slider.) Seeded from the node's props.
#
# Args (every one has a default, so a bare include works):
#   keys   the cloud_sky node's state key root: its `keys:` prop, else sky (the default).
#          A second cloud_sky node with `keys: storm` gets its own panel from
#          `args: { keys: storm, title: ..., id: storm_sky }`
#   title  the window's title (default Sky)
#   id     the instance id: the window's geometry persists under tree.<id> (default sky_controls)
#
# Use it:
#     import: cvc://components/sky_controls.ari
#     windows:
#       - include: sky_controls

units:
  sky_controls:
    args: { keys: sky, title: Sky, id: sky_controls }
    window: "{title}"
    id: "{id}"
    children:
      - checkbox: Ground shadow
        bind: "{keys}.shadow"
        tooltip: "the clouds' shade on the ground and on the meshes the sky lists as receivers"
      - slider_float: Drift speed
        bind: "{keys}.drift"
        lo: 0.0
        hi: 4.0
        fmt: "%.2f"
        tooltip: "how fast the wind carries the clouds: 1 is 3 m/s, 0 holds them still"
      - slider_float: Morph speed
        bind: "{keys}.morph"
        lo: 0.0
        hi: 4.0
        fmt: "%.2f"
        tooltip: "how fast each cloud changes shape: 1 is a new shape every 30 s, 0 freezes them"
      - slider_float: Weather speed
        bind: "{keys}.evolve"
        lo: 0.0
        hi: 8.0
        fmt: "%.2f"
        tooltip: "how fast clouds form and dissipate across the sky; 0 holds the cover as it is"
      - slider_float: Orographic
        bind: "{keys}.orographic"
        lo: 0.0
        hi: 2.0
        fmt: "%.2f"
        tooltip: "how strongly the slopes the wind climbs gather cloud (0: the ground has no say)"
