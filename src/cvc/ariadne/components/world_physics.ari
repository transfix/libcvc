# world_physics.ari — a REUSABLE Ariadne component: the scene's physics world, and how it runs
# (ARIADNE_WORLDS.md section 14, the lab's `world_physics`). Physics on turns the world's stepping
# on and off (`physics.enabled`): off, the world holds still while the clock runs on, and turning
# it back on carries on from there without catching up. Paused, Speed, Step and Restart are the
# scene clock's (sim_transport's keys and the built-in sim.step / sim.restart verbs). The table is
# what the world runtime publishes after each step (`physics.stats.*`): the world's tick and time,
# its bodies and the ones awake, the last step's contacts and wall time (and a plot of it), and a
# line per scene node with bodies, and a line per vehicle (the world's spawned entities): its speed,
# power, the energy it has used and its wheels' load. The same keys run drawn or headless (ari, ari
# test, AriApp).
#
# Args (every one has a default, so a bare include works):
#   physics  the world's key root, as the host resolved it (default physics: <prefix>.physics.*)
#   title    the window's title (default Physics)
#   id       the instance id: the window's geometry persists under tree.<id> (default world_physics)
#
# Use it:
#     import: cvc://components/world_physics.ari
#     windows:
#       - include: world_physics

units:
  world_physics:
    args: { physics: physics, title: Physics, id: world_physics }
    window: "{title}"
    id: "{id}"
    children:
      - include: world_physics_controls
        args: { physics: "{physics}" }

  # The same controls and table without a window, to embed in a document's own window.
  world_physics_controls:
    args: { physics: physics }
    type: group
    children:
      - checkbox: Physics on
        bind: "{physics}.enabled"
        tooltip: "off: the world holds still while the clock runs on; on again carries on from there"
      - checkbox: Paused
        bind: sim.paused
      - slider_float: Speed
        bind: sim.speed
        lo: 0.0
        hi: 4.0
        def: 1.0
        fmt: "%.2f"
        tooltip: "simulated seconds per wall second"
      - button: Step
        on: sim.step
        enabled_when: (= (state-get "sim.paused") "1")
        tooltip: "one more step of the scene's clock (while paused)"
      - button: Restart
        on: sim.restart
        tooltip: "the clock back to tick 0 and the world rebuilt as the document built it"
      - separator
      - text: "tick"
        bind: "{physics}.stats.tick"
      - text: "time (s)"
        bind: "{physics}.stats.time"
      - text: "bodies"
        bind: "{physics}.stats.bodies"
      - text: "awake"
        bind: "{physics}.stats.active_bodies"
      - text: "contacts"
        bind: "{physics}.stats.contact_events"
      - text: "step (ms)"
        bind: "{physics}.stats.step_ms"
      - plot: step time (ms)
        bind: "{physics}.stats.step_ms_history"
      - text: "The engine's contact buffer filled: some contacts were dropped."
        visible_when: (= (state-get "{physics}.stats.saturated") "1")
      - separator
      - text: "Bodies by node: bodies, awake"
      - text_view: "##physics_nodes"
        bind: "{physics}.stats.nodes"
        height: 120
        follow: false
        wrap: false
      - text: "Vehicles: id  name  speed  power  energy  wheel load"
        visible_when: (!= (state-get "{physics}.stats.vehicles") "")
      - text_view: "##physics_vehicles"
        bind: "{physics}.stats.vehicles"
        visible_when: (!= (state-get "{physics}.stats.vehicles") "")
        height: 100
        follow: false
        wrap: false
