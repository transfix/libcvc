# shell.ari — the Ariadne shell: one document that runs other .ari documents as applications, on
# demand, sharing its menu bar, tray and notification bell (docs/roadmap/ARIADNE_SHELL.md, SH1).
#
#   ari run cvc://components/shell.ari --catalog <prefix>/share/libcvc-examples/ariadne/documents/shell_apps.json
#   ari run src/cvc/ariadne/components/shell.ari --catalog examples/ariadne/documents/shell_apps.json
#   ... --open counter,json_feed     # and open these at start (catalog slugs)
#
# --catalog is a catalog in the format arigl's gallery reads ({"demos": [{slug, title, desc, doc}]},
# each doc relative to the catalog; an entry with no doc, a program, is left out). Nothing in it
# is loaded until it is picked: the Apps menu lists every entry by its title, and the Launcher
# window lists them with Open and Close. Opening one writes shell.apps.<id> (app-open); the
# mounts: slot below mounts it at includes.<id>, as its own application: its menu bar becomes one
# menu of this one (with Restart, Quit and Close), its tray icons join this tray, and what it posts
# goes to this bell. Close frees it; its state stays, so opening it again resumes it.
#
# Every application has a budget of steps, time and memory a frame (ARIADNE.md §6.8): the
# catalog's run as the `local` principal, any other document as `file:` or `remote:`, with a
# tighter one. One held at its limit for a few seconds posts a notice whose click offers Allow
# more, Quit and Restart. The Processes window lists every program by application, and each
# application's share of its budget.
#
# shell.allow lists the URI prefixes that may be opened (empty: any file or link), and
# shell.apps.<id>.budget.{steps, time, memory} change one application's budget.

meta:
  name: Shell
  description: Runs other .ari documents as applications, loaded when picked and freed when closed.
  min_libcvc: 4.0.9

args:
  catalog: { type: string, required: true, help: "The catalog of documents to list (gallery.json format)" }
  open: { type: string, default: "", help: "Catalog entries to open at start: their slugs, comma-separated" }

data:
  catalog: { uri: { arg: catalog }, as: json }

import: cvc://components/processes.ari

functions: |
  ; V as text: "" for nothing, a string as it is, anything else printed ((str) quotes a string).
  (defun shell-text (v)
    (if (is-null v) "" (if (is-string v) v (str v))))
  ; A number at KEY, or DEFAULT when it is unset or empty.
  (defun shell-num (key default)
    (set v (state-get key))
    (if (or (is-null v) (= v "")) default (float v)))
  ; The directory of PATH, with forward slashes.
  (defun shell-dir (path)
    (set parts (string.split (string.replace path "\\" "/") "/"))
    (set out "")
    (for i (range 0 (- (length parts) 1))
      (set out (if (= i 0) (nth parts 0) (str-concat out "/" (nth parts i)))))
    out)
  ; DOC as a URI: as it is when it is absolute or has a scheme, else relative to DIR.
  (defun shell-uri (dir doc)
    (if (or (string.starts-with doc "/") (string.contains doc ":")) doc (str-concat dir "/" doc)))
  ; The catalog, each time it is loaded: shell.catalog.<i>.{slug title desc uri} for every entry with
  ; a doc, shell.catalog the count, and shell.catalog_uris.<i> the URIs, which the mounts: slot's
  ; catalog: reads (they run as the local principal).
  (defun shell-index ()
    (set rev (state-get "data.catalog.rev"))
    (if (or (is-null rev) (= (shell-text rev) (shell-text (state-get "shell.indexed"))))
      #f
      (begin
        (state-set "shell.indexed" (shell-text rev))
        (set dir (shell-dir (shell-text (state-get "data.catalog.canonical"))))
        (set n (int (shell-num "data.catalog.json.demos" 0)))
        (set k 0)
        (for i (range 0 n)
          (set at (str-concat "data.catalog.json.demos." (str i) "."))
          (set doc (state-get (str-concat at "doc")))
          (if (or (is-null doc) (= doc ""))
            #f
            (begin
              (set row (str-concat "shell.catalog." (str k) "."))
              (set title (state-get (str-concat at "title")))
              (state-set (str-concat row "slug") (shell-text (state-get (str-concat at "slug"))))
              (state-set (str-concat row "title")
                         (if (or (is-null title) (= title "")) doc title))
              (state-set (str-concat row "desc") (shell-text (state-get (str-concat at "desc"))))
              (state-set (str-concat row "uri") (shell-uri dir doc))
              (state-set (str-concat row "state") "")
              (state-set (str-concat "shell.catalog_uris." (str k)) (shell-uri dir doc))
              (set k (+ k 1)))))
        (state-set "shell.catalog" (str k))
        (shell-open-args)
        #t)))
  ; --open SLUG,SLUG: the catalog entries to open at start, once, when the catalog is in.
  (defun shell-open-args ()
    (set want (state-get "args.open"))
    (if (or (is-null want) (= want "") (= (shell-text (state-get "shell.opened_args")) "1"))
      #f
      (begin
        (state-set "shell.opened_args" "1")
        (for slug (string.split want ",")
          (for i (range 0 (int (shell-num "shell.catalog" 0)))
            (if (= (state-get (str-concat "shell.catalog." (str i) ".slug")) (string.trim slug))
              (shell-open i)
              #f))))))
  ; The id of the open application whose uri is URI, or "".
  ; state-children names every node under shell.apps by its full path: made relative to this
  ; document's root, shell.apps.<id>.uri is an entry's.
  (defun shell-find (uri)
    (set root (state-root-path))
    (set skip (if (= root "") 0 (+ (string.length root) 1)))
    (set found "")
    (for c (state-children "shell.apps")
      (if (and (= found "") (string.ends-with c ".uri"))
        (begin
          (set rel (string.substring c skip (- (string.length c) skip)))
          (set parts (string.split rel "."))
          (if (and (= (length parts) 4) (= (state-get rel) uri)) (set found (nth parts 2)) #f))
        #f))
    found)
  ; Open catalog entry I (a running one is the one returned), and Close it.
  (defun shell-open (i)
    (app-open (state-get (str-concat "shell.catalog." (str i) ".uri"))))
  (defun shell-close (i)
    (set id (shell-find (state-get (str-concat "shell.catalog." (str i) ".uri"))))
    (if (= id "") #f (app-close id)))
  ; Each catalog entry's state, twice a second: open, refused (and why), or "".
  (defun shell-status ()
    (if (< (- (time-now) (shell-num "shell.status_at" 0)) 0.5)
      #f
      (begin
        (state-set "shell.status_at" (str (time-now)))
        (for i (range 0 (int (shell-num "shell.catalog" 0)))
          (set id (shell-find (state-get (str-concat "shell.catalog." (str i) ".uri"))))
          (set st (if (= id "") "" (shell-text (state-get (str-concat "shell.apps." id ".status")))))
          (state-set (str-concat "shell.catalog." (str i) ".state")
                     (if (= st "refused")
                       (str-concat "refused: " (shell-text (state-get (str-concat "shell.apps." id ".error"))))
                       (if (= st "closed") "" st))))
        #t)))

init: |
  (state-set "tree.processes.open" 0)

on_tick: |
  (shell-index)
  (shell-status)
  (processes-step "processes")

menubar:
  - menu: Apps
    items:
      - menu_item: Launcher...
        on: (begin (state-set "tree.launcher.open" 1) (state-set "tree.launcher.raise" "1"))
      - menu_item: Processes...
        on: (begin (state-set "tree.processes.open" 1) (state-set "tree.processes.raise" "1"))
      - separator
      # One item per catalog entry, by its title: picking it opens it (or finds it running).
      - menu_item: '(state-get "shell.catalog.{i}.title")'
        repeat: (if (is-null (state-get "shell.catalog")) 0 (int (state-get "shell.catalog")))
        on: (shell-open {i})

windows:
  - window: Launcher
    id: launcher
    closable: true
    size: [560, 220]
    children:
      - text: "catalog"
        bind: data.catalog.status
      - separator
      - type: group
        repeat: (if (is-null (state-get "shell.catalog")) 0 (int (state-get "shell.catalog")))
        layout: { kind: grid, col_widths: [120, 220, 56, 56, 90] }
        children:
          - text: ""
            bind: shell.catalog.{i}.title
          - text: ""
            bind: shell.catalog.{i}.desc
          - button: Open
            on: (shell-open {i})
            tooltip: "Open it (it is loaded now), or find it running"
          - button: Close
            on: (shell-close {i})
            tooltip: "Close it: its memory and programs are freed, its state kept"
          - text: ""
            bind: shell.catalog.{i}.state
  - include: processes

root:
  # One isolated mount per child of shell.apps (ARIADNE_SHELL.md 4.2): any file or link may be
  # opened unless shell.allow lists prefixes, and the catalog's documents run as `local`.
  - mounts: shell.apps
    allow: { bind: shell.allow }
    catalog: { bind: shell.catalog_uris }
    # Hold background applications' worlds (ARIADNE_SHELL.md 4.4): 1 holds every application's
    # world while its scene is drawn nowhere, unless its entry's background says run.
    in_background: { bind: shell.settings.hold_background }
