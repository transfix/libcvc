# forest_controls.ari — a REUSABLE Ariadne component: live controls for a `forest_trees` node.
# The sliders bind the forest.* state keys that the cvcGL forest_trees realizer reads each frame;
# the realizer SEEDS these keys from the node's authored .ari props, so the controls start at the
# document's values and then drive the forest live. Structural changes (count / seed / species /
# span / sea level / levels / branches / scale) re-grow the whole forest, so those sliders write
# when they are let go (`commit: release`), not every frame of a drag; Wind is live.
#
# Args (every one has a default, so a bare include works):
#   keys   the forest_trees node's state key root: its `keys:` prop, else forest (the default).
#          A second forest_trees node with `keys: north` gets its own panel from
#          `args: { keys: north, title: ..., id: north_forest }`
#   title  the window's title (default Forest)
#   id     the instance id: the window's geometry persists under tree.<id> (default forest_controls)
#
# Use it:
#     import: cvc://components/forest_controls.ari
#     windows:
#       - include: forest_controls

units:
  forest_controls:
    args: { keys: forest, title: Forest, id: forest_controls }
    window: "{title}"
    id: "{id}"
    children:
      - slider_int: Tree count
        bind: "{keys}.count"
        commit: release
        lo: 1
        hi: 200
      - slider_int: Seed
        bind: "{keys}.seed"
        commit: release
        lo: 0
        hi: 9999
      - combo: Species
        bind: "{keys}.species"
        options: [Mix, Pine, Branchy]
        values: [0, 1, 2]
      - slider_float: Scatter span
        bind: "{keys}.span"
        commit: release
        lo: 10.0
        hi: 120.0
        fmt: "%.0f"
      - slider_float: Sea level
        bind: "{keys}.sea_level"
        commit: release
        lo: -5.0
        hi: 20.0
        fmt: "%.1f"
      - separator
      - slider_int: Branchy levels
        bind: "{keys}.levels"
        commit: release
        lo: 1
        hi: 6
      - slider_int: Branchy branches
        bind: "{keys}.branches"
        commit: release
        lo: 2
        hi: 5
      - slider_float: Pine scale
        bind: "{keys}.pine_scale"
        commit: release
        lo: 0.5
        hi: 3.0
        fmt: "%.2f"
      - slider_float: Wind
        bind: "{keys}.wind"
        lo: 0.0
        hi: 3.0
        fmt: "%.2f"
