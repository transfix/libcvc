# sim_transport.ari — a REUSABLE Ariadne component: simulation transport (pause / speed / step /
# restart). The Paused checkbox and Speed slider bind `sim.paused` / `sim.speed` — state keys the
# HOST's sim loop reads to gate + scale its stepping (no per-widget C++). Step and Restart are
# bare-name events, which every AppRuntime handles: sim.step runs one more quantum on the scene's
# clock, and sim.restart puts the clock back to tick 0 and rebuilds the scene's world (docs/ARIADNE.md,
# "Step and restart"). A host with a sim of its own replaces them with rt.on(...). Step is enabled
# only while paused (a reactive predicate). This is the declarative replacement for the hand-rolled
# transport bar in the nav/sim demos.
#
# Use it:
#     import: cvc://components/sim_transport.ari
#     windows:
#       - include: sim_transport
#   a scene's clock reads sim.paused / sim.speed; a host loop of its own reads them too, and may
#   replace the built-in handlers: rt.on("sim.step",…); rt.on("sim.restart",…).

units:
  sim_transport:
    window: Simulation
    id: sim_transport
    children:
      - checkbox: Paused
        bind: sim.paused
        tooltip: "stops the scene's clock: what runs on it (water, clouds, a simulation) holds still"
      - slider_float: Speed
        bind: sim.speed
        lo: 0.0
        hi: 4.0
        def: 1.0
        fmt: "%.2f"
        tooltip: "the scene's clock against the wall clock: 1 is real time, 0 stands still"
      - separator
      - button: Step
        on: sim.step
        enabled_when: (= (state-get "sim.paused") "1") # only meaningful while paused
        tooltip: "while paused, runs the clock one step on"
      - button: Restart
        on: sim.restart
        tooltip: "the clock back to the start, and the scene's world rebuilt"
