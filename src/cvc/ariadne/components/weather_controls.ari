# weather_controls.ari — a REUSABLE Ariadne component: live controls for a `weather` node (the
# scene's weather model, OCEAN-AND-WEATHER-ROADMAP.md §9 F2). It shows the weather now (its state,
# the strongest storm, how many cells, the rain at the ground's centre) and starts a storm: Storm
# upwind starts one that builds upwind and walks over the ground; Storm overhead one in its prime
# over the ground now; Clear sky starts every storm clearing. Time scale is weather seconds per
# world second, a time-lapse of the storms alone (the clouds still drift at the wind's pace; a
# storm's life is 20 to 60 weather minutes). Each of these is an event under weather.events, so a
# replay or another client sees the same weather. The storms ride the scene's wind: the Sky
# panel's Wind heading and Drift speed. Storm wind is the gust front's peak (weather.gust_front, m/s):
# the wind out of a full storm ahead of it, added to the scene's wind; the physics takes a change at
# the next half second of the clock.
#
# Args (every one has a default, so a bare include works):
#   keys   the weather node's state key root: its `keys:` prop, else weather (the default).
#   title  the window's title (default Weather)
#   id     the instance id: the window's geometry persists under tree.<id> (default weather_controls)
#
# Use it:
#     import: cvc://components/weather_controls.ari
#     windows:
#       - include: weather_controls

units:
  weather_controls:
    args: { keys: weather, title: Weather, id: weather_controls }
    window: "{title}"
    id: "{id}"
    children:
      - text: "weather"
        bind: "{keys}.state"
      - text: "strongest storm"
        bind: "{keys}.storminess"
      - text: "storm cells"
        bind: "{keys}.cells"
      - text: "rain at the ground's centre (mm/h)"
        bind: "{keys}.rain"
      - text: "rain at the camera (mm/h)"
        bind: "{keys}.rain_here"
      - separator
      - button: Storm upwind
        on: (state-set "{keys}.request" "upwind")
        tooltip: "a storm cell born upwind now, timed to cross the ground in its prime"
      - button: Storm overhead
        on: (state-set "{keys}.request" "overhead")
        tooltip: "a storm cell in its prime over the ground's centre now"
      - button: Clear sky
        on: (state-set "{keys}.request" "calm")
        tooltip: "every storm alive starts clearing now"
      - slider_float: Time scale
        bind: "{keys}.time_scale"
        lo: 0.0
        hi: 120.0
        fmt: "%.0f x"
        tooltip: "weather seconds per world second: a storm's 20 to 60 minutes in seconds; 0 holds the weather"
      - slider_float: Storm wind
        bind: "{keys}.gust_front"
        lo: 0.0
        hi: 30.0
        fmt: "%.1f m/s"
        tooltip: "the wind out of a full storm at its gust front, on top of the scene's wind (0: none)"
      - separator
      - text: "Rain"
      - slider_float: Streaks
        bind: "{keys}.streaks"
        lo: 0.0
        hi: 2.0
        fmt: "%.2f"
        tooltip: "the rain's streaks near the camera, as a share of the rain there (0: none)"
      - slider_float: Streak count
        bind: "{keys}.rain_quality"
        lo: 0.1
        hi: 1.0
        fmt: "%.2f"
        tooltip: "the share of the node's rain_count streaks a downpour draws (lower is cheaper)"
      - slider_float: Rings
        bind: "{keys}.rings"
        lo: 0.0
        hi: 2.0
        fmt: "%.2f"
        tooltip: "raindrop rings on the water"
      - slider_float: Fog
        bind: "{keys}.fog"
        lo: 0.0
        hi: 2.0
        fmt: "%.2f"
        tooltip: "how thick the fog the rain brings is"
      - slider_float: Wet ground
        bind: "{keys}.wet"
        lo: 0.0
        hi: 2.0
        fmt: "%.2f"
        tooltip: "how dark and glossy the ground goes where it has rained; it dries after"
      - separator
      - text: "Lightning and the wet ground"
      - slider_float: Lightning
        bind: "{keys}.lightning"
        lo: 0.0
        hi: 2.0
        fmt: "%.2f"
        tooltip: "how bright a strike's bolt and flash are (the weather schedules the strikes)"
      - text: "flash"
        bind: "{keys}.flash"
      - checkbox: Wet friction
        bind: "{keys}.friction"
        tooltip: "the rain lowers the ground's and the roads' friction for the vehicles and bodies"
      - text: "wetness under the vehicles"
        bind: "{keys}.wetness"
