# INDEX.ari — the params/ collection: a panel for each parameter table, GENERATED by
# cvc::param_panels_index (inc/cvc/core/param_panel.h). Do not edit:
# src/cvc/tests/param_panel_test.cpp fails when it is not current, and writes it again when run
# with CVC_WRITE_PARAM_PANELS=1.
#
# Each <stem>_panel.ari has a window unit, <stem>_panel, and the same widgets with no window,
# <stem>_params, both taking the key root the table's fields sit under as `keys`, and a
# <stem>_<group>_params unit for each group of dotted fields. A port's window includes one and
# adds its run and stop buttons and its result picker.

meta:
  name: Parameter panels
  description: A panel for each cvc::param_table, generated from the table (import via cvc://components/params/…).
  min_libcvc: 4.0.10

catalog:
  - component: skeleton_panel
    file: skeleton_panel.ari
    unit: skeleton_panel
    nodes: []
    binds: "<prefix>.{keys}.*"
    for: "cvc::skeleton_params as a window; on a node: mesh_lab's mesh_ops.skeleton.*"
    args: { keys: "graphics.root.children.mesh.mesh_ops.skeleton", title: "Skeleton", id: skeleton_panel }
  - component: skeleton_params
    file: skeleton_panel.ari
    unit: skeleton_params
    nodes: []
    binds: "<prefix>.{keys}.*"
    for: "cvc::skeleton_params's widgets with no window: include it in a window"
    args: { keys: "graphics.root.children.mesh.mesh_ops.skeleton" }
  - component: tile_panel
    file: tile_panel.ari
    unit: tile_panel
    nodes: []
    binds: "<prefix>.{keys}.*"
