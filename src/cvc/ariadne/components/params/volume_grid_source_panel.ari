# volume_grid_source_panel.ari — GENERATED from cvc::param_table<cvc::volume_grid_source_params> (inc/cvc/volume/volume_grid.h)
# by cvc::param_panel_ari (inc/cvc/core/param_panel.h). Do not edit: src/cvc/tests/param_panel_test.cpp
# fails when it is not current, and writes it again when run with CVC_WRITE_PARAM_PANELS=1.
#
# One widget per field, in table order, bound to <keys>.<field>: the keys the table's
# params_to_state and params_from_state read and seed (docs/PORT_PARAMETERS.md).
# On a node: volume_grid's grid.source.*.
#
# Units:
#   volume_grid_source_panel   a window: args keys, title, id; slots before and after the widgets
#   volume_grid_source_params  the widgets alone, to include in a window of your own: args keys
#
# Args (every one has a default, so a bare include works):
#   keys   the key root the fields sit under (default graphics.root.children.grid.grid.source)
#   title  the window's title (default Volume grid source)
#   id     the instance id: the window's geometry persists under tree.<id> (default volume_grid_source_panel)
#
# Use it:
#     import: cvc://components/params/volume_grid_source_panel.ari
#     windows:
#       - include: volume_grid_source_panel
#         args: { keys: graphics.root.children.grid.grid.source }
#         slots:
#           after:
#             - button: Run
#               on: ...

units:
  volume_grid_source_params:
    args: { keys: "graphics.root.children.grid.grid.source" }
    type: group
    children:
      - input_text: "Volume"
        bind: "{keys}.volume"
        def: ""
        tooltip: "volume: the state key whose data channel holds the volume the planes cut (relative to the document; a leading / is the root's), followed as it changes"
      - input_text: "Points"
        bind: "{keys}.points"
        def: ""
        tooltip: "points: the state key whose data channel holds point classes: they replace the grid's each time they change"
      - input_text: "Session"
        bind: "{keys}.session"
        def: ""
        tooltip: "session: the state key whose data channel holds a session: applied each time it changes"
      - input_int: "Var"
        bind: "{keys}.var"
        lo: 0
        hi: 2147483647
        def: 0
        tooltip: "var: the variable the volume holds (the classes of others are kept, not shown) (0 .. )"
      - input_int: "Time"
        bind: "{keys}.time"
        lo: 0
        hi: 2147483647
        def: 0
        tooltip: "time: the timestep the volume holds (the classes of others are kept, not shown) (0 .. )"

  volume_grid_source_panel:
    args: { keys: "graphics.root.children.grid.grid.source", title: "Volume grid source", id: volume_grid_source_panel }
    window: "{title}"
    id: "{id}"
    children:
      - slot: before
      - include: volume_grid_source_params
        args: { keys: "{keys}" }
      - slot: after
