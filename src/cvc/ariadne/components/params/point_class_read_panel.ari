# point_class_read_panel.ari — GENERATED from cvc::param_table<cvc::point_class_read_params> (inc/cvc/volume/point_classes.h)
# by cvc::param_panel_ari (inc/cvc/core/param_panel.h). Do not edit: src/cvc/tests/param_panel_test.cpp
# fails when it is not current, and writes it again when run with CVC_WRITE_PARAM_PANELS=1.
#
# One widget per field, in table order, bound to <keys>.<field>: the keys the table's
# params_to_state and params_from_state read and seed (docs/PORT_PARAMETERS.md).
#
# Units:
#   point_class_read_panel   a window: args keys, title, id; slots before and after the widgets
#   point_class_read_params  the widgets alone, to include in a window of your own: args keys
#
# Args (every one has a default, so a bare include works):
#   keys   the key root the fields sit under (default point_class_read)
#   title  the window's title (default Point class reading)
#   id     the instance id: the window's geometry persists under tree.<id> (default point_class_read_panel)
#
# Use it:
#     import: cvc://components/params/point_class_read_panel.ari
#     windows:
#       - include: point_class_read_panel
#         args: { keys: point_class_read }
#         slots:
#           after:
#             - button: Run
#               on: ...

units:
  point_class_read_params:
    args: { keys: "point_class_read" }
    type: group
    children:
      - input_text: "Dims"
        bind: "{keys}.dims"
        def: "[]"
        tooltip: "dims: the volume's dims, x y z (with bbox: .pts coordinates become voxels) (voxel; 1 .. ); a list, as [1, 2.5]"
      - input_text: "Bbox"
        bind: "{keys}.bbox"
        def: "[]"
        tooltip: "bbox: the volume's bounding box, xmin ymin zmin xmax ymax zmax; a list, as [1, 2.5]"
      - input_int: "Variable"
        bind: "{keys}.variable"
        lo: 0
        hi: 2147483647
        def: 0
        tooltip: "variable: the variable .pts classes mark (0 .. )"
      - input_int: "Timestep"
        bind: "{keys}.timestep"
        lo: 0
        hi: 2147483647
        def: 0
        tooltip: "timestep: the timestep .pts classes mark (0 .. )"

  point_class_read_panel:
    args: { keys: "point_class_read", title: "Point class reading", id: point_class_read_panel }
    window: "{title}"
    id: "{id}"
    children:
      - slot: before
      - include: point_class_read_params
        args: { keys: "{keys}" }
      - slot: after
