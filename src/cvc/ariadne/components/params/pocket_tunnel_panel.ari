# pocket_tunnel_panel.ari — GENERATED from cvc::param_table<cvc::pocket_tunnel_params> (inc/cvc/geometry/pocket_tunnel_params.h)
# by cvc::param_panel_ari (inc/cvc/core/param_panel.h). Do not edit: src/cvc/tests/param_panel_test.cpp
# fails when it is not current, and writes it again when run with CVC_WRITE_PARAM_PANELS=1.
#
# One widget per field, in table order, bound to <keys>.<field>: the keys the table's
# params_to_state and params_from_state read and seed (docs/PORT_PARAMETERS.md).
#
# Units:
#   pocket_tunnel_panel   a window: args keys, title, id; slots before and after the widgets
#   pocket_tunnel_params  the widgets alone, to include in a window of your own: args keys
#
# Args (every one has a default, so a bare include works):
#   keys   the key root the fields sit under (default pocket_tunnel)
#   title  the window's title (default Pockets and tunnels)
#   id     the instance id: the window's geometry persists under tree.<id> (default pocket_tunnel_panel)
#
# Use it:
#     import: cvc://components/params/pocket_tunnel_panel.ari
#     windows:
#       - include: pocket_tunnel_panel
#         args: { keys: pocket_tunnel }
#         slots:
#           after:
#             - button: Run
#               on: ...

units:
  pocket_tunnel_params:
    args: { keys: "pocket_tunnel" }
    type: group
    children:
      - input_int: "Pockets"
        bind: "{keys}.pockets"
        lo: 0
        hi: 1000000000
        def: 3
        tooltip: "pockets: how many of the largest pockets (one mouth) the output surface shows (0 .. 1000000000)"
      - input_int: "Tunnels"
        bind: "{keys}.tunnels"
        lo: 0
        hi: 1000000000
        def: 3
        tooltip: "tunnels: how many of the largest tunnels (two or more mouths) and voids (none) the output surface shows (0 .. 1000000000)"
      - slider_float: "Cocone phi"
        bind: "{keys}.cocone_phi"
        lo: 0
        hi: 1.5707963267948966
        range: key
        fmt: "%g"
        def: 0.39269908169872414
        tooltip: "cocone_phi: Tight Cocone: half the cocone's opening angle around the surface (rad; 0 .. 1.5707963267948966)"
      - slider_float: "Sharp phi"
        bind: "{keys}.sharp_phi"
        lo: 0
        hi: 3.141592653589793
        range: key
        fmt: "%g"
        def: 2.0943951023931953
        tooltip: "sharp_phi: Tight Cocone: facets meeting at more than this dihedral angle make a sharp edge (rad; 0 .. 3.141592653589793)"
      - slider_float: "Flat phi"
        bind: "{keys}.flat_phi"
        lo: 0
        hi: 1.5707963267948966
        range: key
        fmt: "%g"
        def: 1.0471975511965976
        tooltip: "flat_phi: Tight Cocone: the normal deviation allowed between cocone neighbours of a flat point (rad; 0 .. 1.5707963267948966)"
      - slider_float: "Flatness ratio"
        bind: "{keys}.flatness_ratio"
        lo: 0
        hi: 14.4
        fmt: "%g"
        def: 1.44
        tooltip: "flatness_ratio: Tight Cocone: the squared thinness factor of a flat point (0 .. 1e+300); the table sets no other end, so the slider's is a guess"

  pocket_tunnel_panel:
    args: { keys: "pocket_tunnel", title: "Pockets and tunnels", id: pocket_tunnel_panel }
    window: "{title}"
    id: "{id}"
    children:
      - slot: before
      - include: pocket_tunnel_params
        args: { keys: "{keys}" }
      - slot: after
