# terminal_images.ari — pictures in the terminal backend (roadmap §16.6).
#
#   ari run src/cvc/ariadne/examples/terminal_images.ari --image photo=picture.png
#   ari run ... --graphics sixel    # or kitty / color / mono; the default (auto) picks for you
#
# An `image:` widget shows a picture the host publishes under its `src` name (ari's --image). On a
# terminal with the kitty graphics protocol (kitty, Ghostty, WezTerm, Konsole) it is drawn in real
# pixels through Unicode placeholder cells; with Sixel (xterm -ti vt340, foot, mlterm, WezTerm,
# Windows Terminal) as a bitmap re-sent after each draw; anywhere else as half-block cells. Drag the
# "Over it" window across the picture: whatever covers the picture hides that part of it.

meta:
  name: Ariadne terminal images
  min_libcvc: 3.6.0

menubar:
  - menu: File
    items:
      - menu_item: Quit
        on: quit

windows:
  - window: Picture
    id: picture
    pos: [16, 32]
    children:
      - text: "published as 'photo':"
      - image: Photo
        src: photo
        size: 320
  - window: Over it
    id: over
    pos: [272, 176]
    children:
      - text: "drag me over the picture"
