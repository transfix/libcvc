# media_images.ari -- pictures by URI (docs/ARIADNE.md §5.11) for media_in_tmux_test.sh: a cover
# banner, a circle avatar and a missing file, each from a file:// URI beside this document, and a
# line saying how each one went.
meta: {min_libcvc: 3.7.0}
windows:
  - window: Media
    id: media
    size: [360, auto]
    children:
      - image: banner
        src: file://media/checker.png
        size: [320, 48]
        fit: cover
        status: m.banner
      - image: avatar
        src: file://media/checker.png
        size: [48, 48]
        shape: circle
        status: m.avatar
      - image: gone
        src: file://media/gone.png
        size: [48, 24]
        status: m.gone
      - text: ""
        bind: (string.join (list "banner" (state-get "m.banner") "avatar" (state-get "m.avatar") "gone" (state-get "m.gone")) " ")
