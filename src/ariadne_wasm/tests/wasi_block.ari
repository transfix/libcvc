# A document with a guest built for WASI, as `arix test` runs it (ctest arix_wasi_stubs): the
# preview-1 stubs every guest links where nothing is granted (ARIADNE_SCRIPTING_HOSTS.md §8.6.1).
# The clocks and random numbers work, a sleep returns at once, argv is the module's name and the
# block's wasi: args, the environment is empty, stdout takes every byte, the file calls are
# ENOTCAPABLE, and proc_exit ends the guest, not the host.

meta:
  name: wasi stubs
  min_libcvc: 3.7.13

requires: [wasm]

wasm:
  module: wasi_guest.wat
  export: [clock, random, args, files, stdio, sleep, exit]
  wasi: {args: [--quiet]}

root:
  - text: wasi stubs

tests:
  clocks: |
    (assert (= (nth (clock 0) 0) 0) "realtime")
    (assert (<= (nth (clock 1) 1) (nth (clock 1) 1)) "monotonic")
    (assert (= (nth (clock 9) 0) 28) "no such clock: EINVAL")
  random: |
    (assert (= (nth (random) 0) 0) "random_get")
    (assert (= (nth (random) 2) 21) "a buffer past the memory's end: EFAULT")
  args: |
    (let ((a (args)))
      (assert (= (nth a 1) 2) "argc: the module's name, then --quiet")
      (assert (= (nth a 7) 0) "no variables"))
  files: |
    (assert (= (nth (files) 0) 76) "path_open: ENOTCAPABLE")
    (assert (= (nth (files) 4) 76) "poll_oneoff on an fd: ENOTCAPABLE")
    (assert (= (nth (files) 5) 8) "fd_prestat_get: EBADF")
  stdio: |
    (let ((s (stdio)))
      (assert (= (nth s 1) 12) "stdout takes every byte")
      (assert (= (nth s 5) 0) "stdin is at its end")
      (assert (= (nth s 11) 2) "fd_filestat_get: a character device")
      (assert (= (nth s 14) 28) "more than 1024 iovecs: EINVAL"))
  sleep: |
    (let ((s (sleep)))
      (assert (= (nth s 0) 0) "a sleep's poll of a clock")
      (assert (= (nth s 1) 1) "fires at once"))
  exit: |
    (assert (= (exit 0) nil) "proc_exit(0): nil")
    (assert (= (try (clock 1) (catch (WasmError e) (get-attr e "exited"))) 0)
            "the guest has ended: every later call is a WasmError")
