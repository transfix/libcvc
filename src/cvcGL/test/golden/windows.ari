# windows.ari — golden: window placement, sizing and chrome through the ImGui backend.
# cvcgl_ari_golden renders this offscreen and compares it with windows.png (see docs/ARIADNE.md,
# "Golden-image tests"). Positions and sizes are px; keep everything inside 960 x 720.
#
# Every window here has a size:. One without fits its widgets (cvcgl_imgui_window_fit checks that,
# with no GL); it can join this golden when windows.png is next made under llvmpipe.
#
# There is no menubar:, but the closable window gets one holding the built-in Windows menu
# (docs/ARIADNE.md §5.9), and the pos: of every window is measured from below it.

meta:
  name: golden windows
  min_libcvc: 3.6.0

windows:
  - window: Fixed size
    id: fixed
    pos: [24, 24]
    size: [320, 150]
    children:
      - text: "A window with size: [320, 150]."
      - separator
      - text: "Text wraps nowhere: what runs past the window's edge scrolls into view."

  - window: Tinted text
    id: tinted
    pos: [372, 24]
    size: [300, 90]
    children:
      - text: "Text in the default colour,"
      - text: "and a line tinted with color:."
        color: [0.95, 0.65, 0.25]

  - window: Closable
    id: closable
    pos: [24, 204]
    size: [320, 120]
    closable: true
    frame: { border: 3 }
    children:
      - text: "closable: true draws the close button;"
      - text: "frame: { border: 3 } widens the border."

  - window: Fractions
    id: fraction
    pos: [372, 204]
    size: [0.3, 0.2]
    children:
      - text: "size: [0.3, 0.2] is 30% x 20% of the view."

  - window: Half width
    id: half
    pos: [24, 354]
    size: [0.5, 96]
    children:
      - text: "size: [0.5, 96] is half the 960 px view wide."
