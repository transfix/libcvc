# volume_grid_quad.ari — golden: the volume_grid component in its quad layout: the XY, XZ and ZY
# slice views and the 3D view in a 2 x 2 grid, each slice view with its plane's slider, beside the
# Probe tab, over the same volume and point classes as volume_grid.ari (the bunny's 32^3 signed
# distance field, volume_grid.vgr).

meta:
  name: golden volume_grid quad
  min_libcvc: 4.0.0

import:
  - cvc://components/volume_grid.ari

# The app holds the data: the bunny's 32^3 signed distance field (cvcGL's sdf generator) and the
# point classes of volume_grid.vgr. The grid reads no file; it shows those.
data:
  bunny:
    generate: sdf
    params: { mesh: stanford.bunny, dim: 32, fit: { height: 100, up: y } }
  seeds: volume_grid.vgr

on_tick: |
  (if (!= (state-get "vg.opened") "1")
      (begin (state-set "viewers.main.camera.frame" "-140 -140 -60 140 140 160")
             (state-set "vg.opened" "1")))

windows:
  - include: volume_grid
    args: { node: grid, id: vq, title: Volume grid (quad), view_size: 200, layout: quad }
    pos: [8, 8]
    size: [944, 640]

scene:
  chrome: false
  background: { top: [0.10, 0.12, 0.16], bottom: [0.02, 0.02, 0.03] }
  nodes:
    - node: grid
      type: volume_grid
      source: { data: bunny }
      points: { data: seeds }
      transfer_function:
        domain: [-20, 20]
        color: [[0, 0.75, 0.25, 0.05], [0.42, 1.0, 0.75, 0.35], [0.5, 1.0, 1.0, 1.0],
                [0.58, 0.45, 0.7, 1.0], [1, 0.05, 0.1, 0.35]]
  lights:
    - rig: three_point
      key: { intensity: 1.6, azimuth: -38, elevation: 52 }
