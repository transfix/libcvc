# orthoslicer.ari — golden: the orthoslicer demo (examples/ariadne/documents/orthoslicer.ari) at a
# fixed size. The signed distance field of the embedded bunny (32^3 here, to keep the run short),
# raycast by a volren node with a see-through surface and cut by three volume_slice planes that
# share one volume and one transfer function; and a slice view looking down y (the XZ view),
# framed on its plane, with the other two planes left out. The transfer-function editor is left
# out: its histogram arrives from a task, on no fixed frame.

meta:
  name: golden orthoslicer
  min_libcvc: 3.7.0

init: |
  (state-set "ortho.view" "xz")

# The main view from further out than the scene's own bounds, on the first tick (after the host
# framed the realized scene).
on_tick: |
  (if (!= (state-get "ortho.opened") "1")
      (begin (state-set "viewers.main.camera.frame" "-120 -120 -40 120 120 140")
             (state-set "ortho.opened" "1")))

windows:
  - window: Orthoslicer
    id: orthoslicer
    pos: [16, 16]
    size: [340, 420]
    children:
      - radio_row: View
        bind: ortho.view
        options: [XY, XZ, ZY]
        values: [xy, xz, zy]
      - type: viewport
        view: slice
        mode: slice
        axis: { bind: ortho.view }
        input: pick
        pick: ortho.pick
        chrome: false
        clear_color: [0.04, 0.045, 0.06]
        width: 320
        height: 240
      - slider_int: X plane
        bind: graphics.root.children.slice_x.slice.index
        lo: 0
        hi: 31
      - slider_int: Y plane
        bind: graphics.root.children.slice_y.slice.index
        lo: 0
        hi: 31
      - slider_int: Z plane
        bind: graphics.root.children.slice_z.slice.index
        lo: 0
        hi: 31

scene:
  chrome: false
  background: { top: [0.10, 0.12, 0.16], bottom: [0.02, 0.02, 0.03] }
  nodes:
    - node: bunny_volume
      type: volren
      source: { sdf: { mesh: stanford.bunny, dim: 32 } }
      fit: { height: 100, up: y }
      volren:
        distance_field: true
        ambient: 0.35
        steps: 128
        resolution_scale: 0.5
        isosurfaces:
          - { value: 0.0, color: [0.85, 0.82, 0.88], opacity: 0.35, shininess: 24 }
        lights:
          - { color: [1.0, 1.0, 1.0], direction: [-0.4, -0.3, -0.85] }
    - node: slice_z
      type: volume_slice
      source: { sdf: { mesh: stanford.bunny, dim: 32 } }
      fit: { height: 100, up: y }
      axis: z
      index: 12
      transfer_function:
        domain: [-20, 20]
        color: [[0, 0.75, 0.25, 0.05], [0.42, 1.0, 0.75, 0.35], [0.5, 1.0, 1.0, 1.0],
                [0.58, 0.45, 0.7, 1.0], [1, 0.05, 0.1, 0.35]]
    - node: slice_y
      type: volume_slice
      volume_of: slice_z
      axis: y
      index: 16
    - node: slice_x
      type: volume_slice
      volume_of: slice_z
      axis: x
      index: 18
  lights:
    - rig: three_point
      key: { intensity: 1.6, azimuth: -38, elevation: 52 }
