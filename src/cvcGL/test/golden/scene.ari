# scene.ari — golden: a document with a scene. A box and a sphere, the camera framed to them by the
# runtime, and a small window over the 3D view. The diagnostic chrome is off so the picture is just
# the geometry and the UI. A directional sun (azimuth 135, elevation 55) shines from above and
# from +X +Y: the box's top and +X faces are lit, and the -Y face toward the camera takes only
# ambient light.

meta:
  name: golden scene
  min_libcvc: 3.6.0

windows:
  - window: Scene
    id: hud
    pos: [24, 24]
    size: [260, 64]
    children:
      - text: "A box and a sphere."

scene:
  chrome: false
  nodes:
    - node: crate
      type: geometry
      source: { box: { size: [2.0, 1.0, 1.0] } }
      material: { color: [0.80, 0.55, 0.35] }
    - node: ball
      type: geometry
      source: { sphere: 0.6 }
      transform: { position: [0.0, 0.0, 1.2] }
      material: { color: [0.35, 0.60, 0.85] }
  lights:
    - light: sun
      kind: directional
      azimuth: 135
      elevation: 55
