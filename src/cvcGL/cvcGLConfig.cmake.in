@PACKAGE_INIT@

# The WebAssembly JS directory (share/cvcGL/wasm), captured NOW, before any find_dependency: it is
# computed from PACKAGE_PREFIX_DIR, which on CMake <= 3.29 every dependency config generated with
# configure_package_config_file's PACKAGE_INIT (cvc, SDL3, zstd, libxml2, ...) overwrites with ITS
# prefix. Used and unset below.
set(_cvcGL_wasm_data_dir "@PACKAGE_CVCGL_WASM_DATADIR@")

include(CMakeFindDependencyMacro)

# cvcGL's public interface links cvc::cvc and the VTK modules below, so both
# must be found before cvcGLTargets.cmake is read. The VTK component list is
# substituted from the same list cvcGL links at build time (kept in sync).
#
# Guarded so re-processing this config (e.g. a consumer that already did
# find_package(cvc) then find_package(cvcGL)) does not re-run cvcConfig — its
# FindImageMagick pass is not idempotent and errors on a second add_library.
# Mirrors the same `if(NOT TARGET cvc::cvc)` guard cvcGL uses in-tree.
if(NOT TARGET cvc::cvc)
  find_dependency(cvc CONFIG)
endif()
find_dependency(VTK COMPONENTS @CVCGL_VTK_COMPONENTS@)

# When cvcGL was built against an imgui that ships a cmake config, its public
# interface links the imgui::imgui imported target, so consumers must re-find it
# (empty otherwise — a config-less imgui bundle exports a relocatable -limgui the
# consumer's linker resolves from its own prefix). imgui's config guards its own
# target, so this is idempotent.
@CVCGL_IMGUI_DEP@

# When cvcGL was built against SDL3 (CVC_ENABLE_SDL), its public interface links
# SDL3::SDL3 (the input/peripheral seam), so consumers must re-find it. Empty when
# built without SDL3. SDL3's config guards its own target, so this is idempotent.
@CVCGL_SDL_DEP@

include("${CMAKE_CURRENT_LIST_DIR}/cvcGLTargets.cmake")

# WebAssembly app support: cvcgl_wasm_app(<target> ...) (cvcGLWasm.cmake, next to this file).
# GLOBAL properties, so the function works whichever directory scope called find_package. The JS
# directory was computed from this file's own location (PACKAGE_PREFIX_DIR, captured at the top),
# so a relocated prefix hands out its own share/cvcGL/wasm. A plain set, not set_and_check: a
# bundle without the JS still passes find_package; cvcgl_wasm_app fails only if asked for the shim
# and the file is missing.
set_property(GLOBAL PROPERTY CVCGL_WASM_DATA_DIR "${_cvcGL_wasm_data_dir}")
unset(_cvcGL_wasm_data_dir)
# Whether this cvcGL was built -pthread (wasm-mt); MIMALLOC AUTO follows it.
set_property(GLOBAL PROPERTY CVCGL_WASM_PTHREADS @CVCGL_WASM_PTHREADS@)
include("${CMAKE_CURRENT_LIST_DIR}/cvcGLWasm.cmake" OPTIONAL)

check_required_components(cvcGL)
