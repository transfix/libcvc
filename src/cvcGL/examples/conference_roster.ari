# conference_roster.ari — the BROWSER (wasm) conference client: control-plane only.
#
# A browser build has the WebSocket state transport (cvc::state_transport_ws) but NOT the gRPC media
# plane, so there is no `room-publish` / `room-subscribe` (those verbs are gRPC-only, unregistered in
# a wasm build). This scene therefore uses ONLY the core control-plane verbs — `room-join` and
# `room-roster` — so it joins the room and shows WHO IS PRESENT, syncing both ways with native gRPC
# clients through the relay's WS<->gRPC bridge. Live video in the browser is the next phase (WebRTC);
# here each participant shows as a named tile with a "browser video coming soon" placeholder until
# the WebSocket media plane lands.
#
# conf.room / conf.self are set by the host (cyprty.cpp) before this loads.

meta:
  name: Ariadne conference (browser roster)
  author: cvc
  min_libcvc: 3.6.0

menubar:
  - menu: Room
    items:
      - menu_item: Quit
        on: quit

windows:
  - window: Room
    id: room
    pos: [20, 20]
    size: [440, 600]
    children:
      - text: "you"
        bind: conf.self
      - text: "status"
        bind: (if (= (state-get "joined") "1") "● connected to the room" "connecting…")
      # Local self-preview: this browser's own CAMERA, rendered in a stream_view. The camera opens via
      # SDL's emscripten backend (getUserMedia) — the browser prompts for permission on join; until
      # it is granted the tile stays black (no frames), then live video appears. Frames are MJPEG so
      # the same stream will fan out to peers once the WS media plane lands.
      - text: "my video"
      - type: stream_view
        bind: cam_token
        size: 240
      - separator
      - text: "in the room"
        bind: peer.count
      - separator
      # One tile per participant (including you): the on_tick lane fills peer.<i>.name with each
      # roster entry's display name and peer.count with the total, so this group is emitted once per
      # participant with {i} bound to the slot index. Names re-resolve each frame as people join/leave.
      - type: group
        repeat: (state-get "peer.count")
        children:
          - text: "name"
            bind: peer.{i}.name
          # Each peer's live video: a stream_view bound to that peer's decode-proxy token. The host
          # (arigl) opens one proxy per peer on the first frame it relays and publishes the token into
          # "media.<pid>.camera", which the on_tick lane copies into peer.{i}.cam below. Empty until a
          # peer's frames arrive (and for your own row — your camera is the "my video" tile above), so
          # the stream_view simply draws nothing then.
          - type: stream_view
            bind: peer.{i}.cam
            size: 180
          - separator

on_tick: |
  (begin
    ; ── join the room ONCE (pid derives from the default shard; the WS transport replicates it) ──
    (if (= (state-get "joined") "1") #f
      (begin
        (state-set "joined" "1")
        (room-join "" (state-get "conf.room") (dict "name" (state-get "conf.self")))
        ; Open my own video stream and drive it from the browser CAMERA (device 0). The producer runs
        ; on a browser interval timer in this single-threaded wasm build, so frames flow without a
        ; worker thread; the stream_view above decodes + shows them. getUserMedia prompts on this
        ; call; frames (rescaled to 640x480, MJPEG) start once the user approves. (room-publish to
        ; share it with peers is the WS media-transport phase.)
        ; expected_subscribers >= 2: the "my video" self-preview tile AND the host's forwarder (which
        ; subscribes to relay the frames to peers) both subscribe to this one stream; 3 gives headroom.
        (set cam (stream-open (dict "id" "camera" "codec" "mjpeg" "w" 640 "h" 480 "stride" 2560
                                    "expected_subscribers" 3)))
        (state-set "cam_token" (get-attr cam "token"))
        ; Drive the stream from the real browser CAMERA (device 0, getUserMedia). A ?synthetic=1 URL
        ; param (the host plumbs it to "cam_synthetic") instead uses a hardware-free MJPEG test
        ; pattern, so the whole conference — including peer video over the relay — can be exercised in
        ; a browser that has no camera (or won't grant it).
        (if (= (state-get "cam_synthetic") "1")
            (stream-capture-camera (get-attr cam "token")
              (dict "synthetic" #t "w" 640 "h" 480 "hz" 30 "jpeg" #t))
            (stream-capture-camera (get-attr cam "token")
              (dict "device" 0 "w" 640 "h" 480 "hz" 30 "jpeg" #t)))
        ; Open my own MIC stream (f32 PCM) and drive it from the browser microphone (SDL audio device
        ; 0 = getUserMedia audio). ?synthetic=1 instead captures a hardware-free 440 Hz tone (no
        ; device), so audio flow + A/V sync are exercisable without a mic. subscriber_depth 8 covers
        ; the host forwarder's ring subscription; the mic is not played back to yourself.
        (set mic (stream-open (dict "id" "mic" "codec" "f32" "rate" 48000 "ch" 1 "frames_per_chunk" 1024
                                    "subscriber_depth" 8 "expected_subscribers" 2)))
        (state-set "mic_token" (get-attr mic "token"))
        (if (= (state-get "cam_synthetic") "1")
            (stream-capture-audio (get-attr mic "token") (dict "rate" 48000 "ch" 1 "frames" 1024))
            (stream-capture-audio (get-attr mic "token")
              (dict "device" 0 "rate" 48000 "ch" 1 "frames" 1024)))))
    ; ── rebuild the roster tiles every tick from the replicated room roster ──
    ; For each participant, copy that peer's decode-proxy token (the host publishes it at
    ; "media.<pid>.camera" once their frames start arriving) into peer.<idx>.cam, which the per-peer
    ; stream_view tile binds to. Empty for peers not yet sending and for your own row.
    (set idx 0)
    (for p (room-roster (state-get "conf.room"))
      (begin
        (state-set (str-concat "peer." idx ".name") (get-attr p "name"))
        (state-set (str-concat "peer." idx ".cam")
          (state-get (str-concat "media." (get-attr p "pid") ".camera")))
        (set idx (+ idx 1))))
    (state-set "peer.count" (str idx)))
