# conference_live.ari — a LIVE two-instance conference, driven entirely from the DSL.
#
# Run two CLUSTERED ariadne_conference instances (the host wires the gRPC room cluster + media
# bridge; see the clustering flags in ariadne_conference.cpp). Each instance joins the room,
# publishes its own synthetic camera + 440 Hz tone, and subscribes to the peer's camera + audio —
# so each window shows "me" (my synthetic feed) and "peer" (the other instance's feed, pulled across
# the process boundary over the merged gRPC stream_bridge, routed only by the replicated room tree).
#
#   # terminal 1 — node A, serves room-state on :7001, media on an ephemeral port:
#   ariadne_conference conference_live.ari --node-id A --peer-id B --room standup \
#       --state-listen 127.0.0.1:7001
#   # terminal 2 — node B, serves on :7002, dials A's state server:
#   ariadne_conference conference_live.ari --node-id B --peer-id A --room standup \
#       --state-listen 127.0.0.1:7002 --state-peer 127.0.0.1:7001
#
# Synthetic + a 440 Hz tone by default (no camera/mic needed); real speaker output on Linux awaits
# the relocatable-ALSA recipe fix. conf.room / conf.self / conf.peer are set by the host.

meta:
  name: Ariadne conference (live)
  author: cvc
  min_libcvc: 3.6.0

menubar:
  - menu: Sim
    items:
      - menu_item: Quit
        on: quit

windows:
  - window: Me
    id: me
    pos: [20, 20]
    size: [520, 470]
    children:
      - text: "me"
        bind: conf.self
      # Reactive status: starting -> published (waiting for peer) -> connected.
      - text: "status"
        bind: (if (= (state-get "joined") "1") (if (= (state-get "subscribed") "1") "● connected — peer video + audio" "● published — waiting for peer…") "starting…")
      - separator
      - type: stream_view
        bind: cam_token
        size: 460
  - window: Peer
    id: peer
    pos: [560, 20]
    size: [520, 470]
    children:
      - text: "peer"
        bind: conf.peer
      - separator
      # Bound to the proxy token the on_tick lane stores once the peer's stream is subscribed; the
      # widget re-resolves it each frame, so it shows a placeholder until the peer publishes.
      - type: stream_view
        bind: remote_cam_token
        size: 460

on_tick: |
  (begin
    ; ── phase 1: join the room + publish my own camera + mic (ONCE) ──
    (if (= (state-get "joined") "1") #f
      (begin
        (state-set "joined" "1")
        (room-join "" (state-get "conf.room") (dict "name" (state-get "conf.self")))
        ; my camera. When cam_live the HOST publishes the REAL device camera (it alone knows the
        ; device resolution needed to size the stream) and sets cam_token, so skip the synthetic one.
        (if (= (state-get "cam_live") "1") #f
          (begin
            ; "mjpeg": the synthetic feed is JPEG-compressed too (stride sizes the byte slab), so a
            ; camera-less peer is also network-friendly; the subscriber's stream_view decodes it.
            (set cam (stream-open (dict "id" "camera" "codec" "mjpeg" "w" 640 "h" 480 "stride" 2560
                                        "expected_subscribers" 3)))
            (state-set "cam_token" (get-attr cam "token"))
            (stream-capture-camera (get-attr cam "token")
              (dict "synthetic" #t "w" 640 "h" 480 "hz" 30 "jpeg" #t))
            (room-publish (state-get "conf.room")
              (dict "kind" "camera" "token" (get-attr cam "token")))))
        ; my mic — a 440 Hz tone (subscriber_depth >= 8 so a remote player can attach on pull).
        (set mic (stream-open (dict "id" "audio" "codec" "f32" "rate" 48000 "ch" 1
                                    "frames_per_chunk" 1024 "subscriber_depth" 8
                                    "expected_subscribers" 2)))
        ; my mic — the REAL recording device when mic_live, else a hardware-free 440 Hz tone.
        (if (= (state-get "mic_live") "1")
          (stream-capture-audio (get-attr mic "token")
            (dict "rate" 48000 "ch" 1 "frames" 1024 "device" 0))
          (stream-capture-audio (get-attr mic "token")
            (dict "rate" 48000 "ch" 1 "frames" 1024 "tone" (dict "hz" 440))))
        (room-publish (state-get "conf.room")
          (dict "kind" "audio" "token" (get-attr mic "token")))))
    ; ── phase 2: subscribe to the peer's camera + audio, retried each tick until it has published ──
    (if (= (state-get "subscribed") "1") #f
      (begin
        (set sub (room-subscribe (state-get "conf.room") (state-get "conf.peer") "camera"))
        (if (get-attr sub "ok")
          (begin
            (state-set "remote_cam_token" (get-attr sub "token"))
            (set asub (room-subscribe (state-get "conf.room") (state-get "conf.peer") "audio"))
            (stream-play-audio (get-attr asub "token"))
            (state-set "subscribed" "1"))
          #f))))
